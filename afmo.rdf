    <rdfs:subClassOf rdf:resource="http://purl.org/phmo#DemographicFactor"/>
    <phmo:isRiskFactorInRelationship rdf:resource="http://purl.org/afmo#AFAndAgeGroup"/>
    <rdfs:label>Age group</rdfs:label>
    <owl:equivalentClass rdf:nodeID="Ndf3a50d87a3f44f98def68f6885f9b31"/>
  </rdf:Description>
