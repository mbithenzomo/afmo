    <rdfs:subClassOf rdf:nodeID="Ne07cc3635d9647fe9e5ac5a3cd7068e8"/>
    <rdfs:comment>For adults, BMI falls into the following categories:

- Underweight: below 18.5
- Normal: 18.5 - 24.9
- Overweight: 25.0 - 29.9
- Obese I: 30.0 - 34.9
- Obese II: 35.0 - 39.9
- Obese III: above 40.0</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://purl.org/phmo#AnthropometricFactor"/>
