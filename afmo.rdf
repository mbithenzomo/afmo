  <rdf:Description rdf:about="http://purl.org/afmo#ReviewOnEfficacyOfAlcoholCounselingPublication">
    <core1:partOf rdf:resource="http://purl.org/afmo#AnnalsOfInternalMedicine"/>
    <core1:partOf rdf:resource="http://purl.org/afmo#Issue9"/>
    <core1:partOf rdf:resource="http://purl.org/afmo#Volume157"/>
    <rdfs:comment>Journal article in which the review on the efficacy of alcohol counselling is published.</rdfs:comment>
    <rdf:type rdf:resource="http://purl.org/spar/fabio/JournalArticle"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <phmo:isPublicationOf rdf:resource="http://purl.org/afmo#ReviewOnEfficacyOfAlcoholCounseling"/>
    <dcterms:creator rdf:resource="http://purl.org/afmo#DanielEJonas"/>
    <phmo:hasPublicationMonthYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYearMonth">2012-11</phmo:hasPublicationMonthYear>
    <basic:pageRange>645 - 654</basic:pageRange>
    <rdfs:label>Review on efficacy of alcohol counselling publication</rdfs:label>
    <basic:doi>10.7326/0003-4819-157-9-201211060-00544</basic:doi>
    <dcterms:title>Behavioral Counseling After Screening for Alcohol Misuse in Primary Care: A Systematic Review and Meta-analysis for the U.S. Preventive Services Task Force</dcterms:title>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/FeatureOfInterest">
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Property"/>
    <owl:disjointWith rdf:resource="https://purl.org/heals/eo#SystemRecommendation"/>
    <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
    <owl:disjointWith rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
    <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
    <owl:disjointWith rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <rdfs:label xml:lang="en">Feature of interest</rdfs:label>
    <skos:example xml:lang="en">When measuring the height of a tree, the height is the observed Property, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuation.</skos:example>
    <rdfs:subClassOf rdf:nodeID="N7707264f2a914e33b5f2032cfe4a1b2d"/>
    <rdfs:subClassOf rdf:nodeID="N766cb58f9aea4c7999cbb913266ef82e"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
    <skos:definition xml:lang="en">
  entity that is the target of an Execution or Deployment

  i.e., whose property is being estimated by an Observation, 
  or whose property is being manipulated by an Actuator, 
  or which is being sampled or transformed in an act of Sampling, 
  or which is the target of Executions planned as part of a Deployment.
  </skos:definition>
    <rdfs:comment>entity that is the target of an Execution or Deployment i.e., whose property is being estimated by an Observation, or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling, or which is the target of Executions planned as part of a Deployment.</rdfs:comment>
  </rdf:Description>
