    <rdfs:label xml:lang="en">Cardiovascular disease</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/phmo#MedicalCondition"/>
    <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
