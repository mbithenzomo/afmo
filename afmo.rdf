  <rdf:Description rdf:nodeID="N9501463ee6634c3c9aeddf37a5df0a89">
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
    <rdfs:isDefinedBy>I. Horrocks and P. F. Patel-Schneider, “Knowledge Representation and Reasoning on the Semantic Web: OWL,” in Handbook of Semantic Web Technologies, Springer, 2011, pp. 365–398. https://doi.org/10.1007/978-3-540-92913-0_9</rdfs:isDefinedBy>
    <owl:annotatedTarget>All subclasses of this class are punned such that they are both classes and individuals. "In OWL 2 the same name can be used for a class, a property and an individual, a feature known as punning."</owl:annotatedTarget>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="http://purl.org/phmo#MedicalCondition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/sosa/hasMember">
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Execution"/>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
    <schema1:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <rdfs:comment>link from a Collection to an Execution or Sample or Collection of these that is part of it</rdfs:comment>
    <skos:editorialNote>Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types</skos:editorialNote>
    <skos:scopeNote>rules for the consistency of values of properties of collections and properties of their members are given for each collection type</skos:scopeNote>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ExecutionCollection"/>
    <schema1:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
    <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isMemberOf"/>
    <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
    <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
    <rdfs:label>has member of collection</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <skos:definition>
  link from a Collection to an Execution or Sample or Collection of these that is part of it
  </skos:definition>
  </rdf:Description>
