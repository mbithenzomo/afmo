  <rdf:Description rdf:about="https://saref.etsi.org/core/hasTimestamp">
    <rdfs:comment xml:lang="en">Links a procedure execution or a profile to an instant.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    <rdfs:label xml:lang="en">has timestamp</rdfs:label>
    <skos:note xml:lang="en">Applied on a profile, it describes the applicable instant of that profile</skos:note>
    <skos:note xml:lang="en">When the execution time and the phenomenon time are the same time instants, then DP saref:hasTimestamp can be used to simply link a procedure execution to the time of these instants, expressed as an xsd:dateTime literal.</skos:note>
    <skos:historyNote xml:lang="en">V3.2.1: Tried to clarify definition of saref:hasTimestamp. Still unclear.</skos:historyNote>
    <rdfs:domain rdf:nodeID="Nf84bf5b3052e4092ab67ab3233be5248"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/vocab/frbr/core#partOf">
    <vann:example>
        :my-journal-article a fabio:JournalArticle ;
            frbr:partOf :my-journal-issue .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/fabio"/>
    <skos1:note xml:lang="en">Unlike the FRBR version in RDF http://vocab.org/frbr/core.html the present version defines partonomy relationships transitive.</skos1:note>
    <rdfs:range rdf:resource="http://purl.org/phmo#Publication"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <ns:term_status xml:lang="en">stable</ns:term_status>
    <rdfs:domain rdf:resource="http://purl.org/phmo#Publication"/>
    <rdfs:label xml:lang="en">is part of</rdfs:label>
    <rdfs:comment xml:lang="en">A property indicating that one entity is a part of another entity.</rdfs:comment>
    <rdfs:comment xml:lang="en">An endeavour incorporating another endeavour.</rdfs:comment>
  </rdf:Description>
