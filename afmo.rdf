    <core:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">68</core:hasValue>
    <rdfs:comment>Example observation of Rehema's body weight in July 2025, measured with a Seca 654 body weight scale.</rdfs:comment>
    <core:isMeasuredIn rdf:resource="http://purl.org/phmo#Kilogram"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/phmo#BodyWeightObservation"/>
    <rdfs:label>Body weight observation I</rdfs:label>
