  <rdf:Description rdf:nodeID="N2b99292f3e024ac4bf13aa0b5ad5861a">
    <owl:annotatedTarget>A pharmaceutical agent that selectively inhibits angiotensin II receptor activation in the renin-angiotensin-aldosterone system reducing production and secretion of aldosterone, amongst other actions. The combined effects result in reduction of blood pressure. It is primarily used for the reduction of proteinuria and the treatment of hypertension in cases where the patient is intolerant of ACE inhibitor therapy.</owl:annotatedTarget>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <oboInOwl:hasDbXref>NCIT:C66930</oboInOwl:hasDbXref>
    <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000653"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
  </rdf:Description>
