    </vann:example>
    <rdfs:range rdf:nodeID="Naab4642fe8cf489b963122af41b47614"/>
    <rdfs:comment xml:lang="en">An entity primarily responsible for making the resource.</rdfs:comment>
    <skos:scopeNote xml:lang="en">Examples of a Creator include a person, an organization, or a service. Typically, the name of a Creator should be used to indicate the entity.</skos:scopeNote>
