  <rdf:Description rdf:about="http://purl.org/afmo#InterventionExplanation3">
    <rdfs:comment>Example rationale explanation of the recommendation of alcoholism counselling for Atieno, provided to her caregiver Bahati.</rdfs:comment>
    <ep:isBasedOn rdf:resource="http://purl.org/afmo#HealthIntervention2"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://purl.org/heals/eo#RationaleExplanation"/>
    <rdfs:label>Intervention explanation 3</rdfs:label>
    <phmo:isConsumedBy rdf:resource="http://purl.org/afmo#Bahati"/>
    <core:hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-09-21T19:30:00+03:00</core:hasTimestamp>
    <phmo:hasText>Alcohol counselling has been recommended for Atieno because her alcohol use is one of the reasons her risk of atrial fibrillation (AF) is raised. Dr Chebet has approved it, and your support in helping her attend the sessions can make a difference.</phmo:hasText>
  </rdf:Description>
