  <rdf:Description rdf:about="http://purl.org/afmo#AFRiskExplanation3">
    <rdfs:label>AF risk explanation 3</rdfs:label>
    <rdfs:comment>Example counterfactual explanation of Atieno's AF risk assessment, provided to her caregiver Bahati.</rdfs:comment>
    <ep:isBasedOn rdf:resource="http://purl.org/afmo#AFRiskAssessment1"/>
    <rdf:type rdf:resource="https://purl.org/heals/eo#CounterfactualExplanation"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <core:hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-07-10T14:30:00+03:00</core:hasTimestamp>
    <phmo:hasText>Atieno's risk of developing atrial fibrillation (AF) is raised, mainly because of her hypertension (high blood pressure). If hypertension was absent, the assessed AF risk would fall from 45 in 100 to 20 in 100.”</phmo:hasText>
    <phmo:isConsumedBy rdf:resource="http://purl.org/afmo#Bahati"/>
  </rdf:Description>
