  <rdf:Description rdf:about="http://purl.org/afmo#AFAndAnthropometricFactors">
    <phmo:hasRiskOfCondition rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
    <rdfs:label>AF and anthropometric factors</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/phmo#CategoryRiskRelationship"/>
    <rdfs:comment>Category risk relationship between anthropometric factors (risk factor category) and AF (condition).</rdfs:comment>
    <phmo:hasCategoryWeight rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.20</phmo:hasCategoryWeight>
    <phmo:hasRiskFactorCategory rdf:resource="http://purl.org/phmo#AnthropometricFactor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/afmo#BodyWeightObservationII">
    <core:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">72</core:hasValue>
    <core:isMeasuredIn rdf:resource="http://purl.org/phmo#Kilogram"/>
    <sosa:madeBySensor rdf:resource="http://purl.org/afmo#Seca654"/>
    <rdfs:label>Body weight observation II</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/phmo#BodyWeightObservation"/>
    <core:hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-07-06T14:32:00+03:00</core:hasTimestamp>
    <sosa:observedProperty rdf:resource="http://purl.org/phmo#BodyWeight"/>
    <sosa:hasFeatureOfInterest rdf:resource="http://purl.org/afmo#Rehema"/>
    <rdfs:comment>Example observation of Rehema's body weight in July 2026, measured with a Seca 654 body weight scale.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/afmo#AFEpisodePrediction2">
    <phmo:isPredictionOfHealthEvent rdf:resource="http://purl.org/afmo#AtrialFibrillationEpisode"/>
    <phmo:hasPredictionHorizon rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT15M</phmo:hasPredictionHorizon>
    <phmo:hasInputObservation rdf:resource="http://purl.org/afmo#ECGObservation3"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/afmo#AtrialFibrillationEpisodePrediction"/>
    <phmo:hasTargetWindow rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT5M</phmo:hasTargetWindow>
    <core:hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-07-06T14:30:00+03:00</core:hasTimestamp>
    <phmo:hasProbability rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.4567</phmo:hasProbability>
    <phmo:isPredictionOfCondition rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
    <phmo:hasPredictionStatus rdf:resource="http://purl.org/afmo#AFEpisodeAbsent"/>
    <phmo:wasPredictedByModel rdf:resource="http://purl.org/afmo#CNN-BiLSTM"/>
    <phmo:isPredictionOf rdf:resource="http://purl.org/afmo#Atieno"/>
    <rdfs:label>AF episode prediction 2</rdfs:label>
    <rdfs:comment>Example prediction, made by the CNN-BiLSTM from Atieno's lead I ECG observation, that no AF episode will begin within a 5-minute window starting 15 minutes after the observation ends.</rdfs:comment>
    <phmo:hasInputWindow rdf:datatype="http://www.w3.org/2001/XMLSchema#duration">PT5M</phmo:hasInputWindow>
  </rdf:Description>
