  <rdf:Description rdf:about="http://purl.org/afmo#AFEpisodeExplanation1">
    <phmo:hasText>Your ECG recording from 14:00 to 14:30 on 6 July 2026 did not indicate an AF episode starting 15 to 20 minutes after the recording ended. The estimated probability of an episode was 0.46, below the model's threshold of 0.5.</phmo:hasText>
    <phmo:isConsumedBy rdf:resource="http://purl.org/afmo#Atieno"/>
    <ep:isBasedOn rdf:resource="http://purl.org/afmo#AFEpisodePrediction2"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://purl.org/heals/eo#RationaleExplanation"/>
    <core:hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-07-06T14:30:00+03:00</core:hasTimestamp>
    <rdfs:comment>Example statistical explanation of an AF episode prediction for Atieno, provided to Atieno.</rdfs:comment>
    <rdfs:label>AF episode explanation 1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/phmo#hasRiskFactor">
    <rdfs:range rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
    <owl:inverseOf rdf:resource="http://purl.org/phmo#isRiskFactorInRelationship"/>
    <rdfs:label>has risk factor</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.org/phmo#FactorRiskRelationship"/>
    <rdfs:comment>The link between a factor risk relationship and a risk factor.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb037c729c7944ea3a9d8ca90c03b721d">
    <owl:onClass rdf:resource="http://purl.org/afmo#RaceOrEthnicity"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.org/afmo#hasRaceOrEthnicity"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N05692642a61b41769ad561d8a78e5332">
    <rdf:rest rdf:nodeID="Nfe5314dbf3724b79991fb26bb1a8a18d"/>
    <rdf:first rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
