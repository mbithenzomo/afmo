  <rdf:Description rdf:about="http://purl.org/afmo">
    <dc:creator>Mbithe Nzomo</dc:creator>
    <owl:imports rdf:resource="http://purl.org/phmo/1.0"/>
    <dc:title>Atrial Fibrillation Monitoring Ontology (AFMO)</dc:title>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:license>https://creativecommons.org/licenses/by/4.0/</dcterms:license>
    <owl:versionInfo>3.0</owl:versionInfo>
    <rdfs:comment>The Atrial Fibrillation Monitoring Ontology (AFMO) extends the Personal Health Monitoring Ontology (PHMO) with concepts specific to atrial fibrillation (AF) monitoring.

From version 3.0, general personal health monitoring concepts have moved to the PHMO (http://purl.org/phmo), which the AFMO imports. Terms listed as deleted in the changelog have moved to the PHMO namespace.

In addition to the ontologies reused through the PHMO, the AFMO contains concepts reused from the following ontologies:

- Human Disease Ontology (DO)
- Medical Action Ontology (MAxO)

Health domain concepts have been manually cross-referenced to concepts from the Unified Medical Language System (UMLS) metathesaurus, which maps to several medical vocabularies and terminologies, including:

- SNOMED CT (US)
- Medical Subject Headings (MeSH) Thesaurus
- National Cancer Institute (NCI) Thesaurus
- MedlinePlus</rdfs:comment>
    <owl:versionIRI rdf:resource="http://purl.org/afmo/3.0"/>
    <owl:priorVersion rdf:resource="http://purl.org/afmo/2.2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/phmo#DemographicFactor">
    <phmo:isRiskFactorCategoryInRelationship rdf:resource="http://purl.org/afmo#AFAndDemographicFactors"/>
    <owl:disjointWith rdf:resource="http://purl.org/afmo#ECGFactor"/>
    <owl:disjointWith rdf:resource="http://purl.org/phmo#LifestyleFactor"/>
    <rdfs:label>Demographic factor</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://purl.org/phmo#DemographicFactor"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
    <rdfs:comment xml:lang="en">A class to group risk factors for atrial fribrillation related to a person's demographics. Demographics: the qualities (such as age and sex) of a specific group of people.</rdfs:comment>
  </rdf:Description>
