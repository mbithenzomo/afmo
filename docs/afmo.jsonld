  "http://www.w3.org/2002/07/owl#annotatedTarget" : [ {
    "@value" : "Cognitive and behavioral interventions are therapies that are designed to decrease symptoms and foster the belief that one has control over thoughts, beliefs, attitudes, and skills to facilitate coping."
  } ]
}, {
