  }, {
    "@id" : "http://www.w3.org/ns/sosa/ExecutionCollection"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/ObservationCollection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "link from a Collection to an Execution or Sample or Collection of these that is part of it"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ObservationCollection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has member of collection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/isMemberOf"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "\n  link from a Collection to an Execution or Sample or Collection of these that is part of it\n  "
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "rules for the consistency of values of properties of collections and properties of their members are given for each collection type"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/hasProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://schema.org/rangeIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relation from an entity to a Property of that entity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Property"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.w3.org/ns/sosa/isPropertyOf"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  relation from an entity to a Property of that entity\n  "
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/isFeatureOfInterestOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest"
  } ],
  "http://schema.org/rangeIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Deployment"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Execution"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/ExecutionCollection"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/ObservationCollection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relation from a FeatureOfInterest to an Execution, Execution Collection, or Deployment, operating on it i.e., to an Observation about it, to an Actuation acting on it, to an act of Sampling that sampled it, or to a Deployment for which it is the subject."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is feature of interest of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "_:genid29"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  relation from a FeatureOfInterest to an Execution, Execution Collection, or Deployment, operating on it\n\n  i.e., to an Observation about it, to an Actuation acting on it, to an act of Sampling that sampled it,\n  or to a Deployment for which it is the subject.\n"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/isMemberOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Execution"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/ExecutionCollection"
  }, {
