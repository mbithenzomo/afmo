  }, {
    "@id" : "http://www.w3.org/ns/sosa/ObservationCollection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "link from an Execution or Sample or Collection of these, to a collection that it is part of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Observation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "is member of collection"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/sosa/ObservationCollection"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "\n  link from an Execution or Sample or Collection of these, to a collection that it is part of\n  "
  } ],
  "http://www.w3.org/2004/02/skos/core#editorialNote" : [ {
    "@value" : "Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types"
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@value" : "rules for the consistency of values of properties of collections and properties of their members are given for each collection type"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/isObservedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relation between an ObservableProperty and the Sensor able to observe it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/"
  }, {
    "@id" : "http://www.w3.org/ns/sosa/obs/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is observed by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
