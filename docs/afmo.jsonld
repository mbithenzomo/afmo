}, {
  "@id" : "http://purl.org/afmo#RaceOrEthnicity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class", "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://purl.org/phmo#DemographicFactor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Although race is a social rather than biological construct, it can be an (albeit imperfect) proxy for certain genetic traits. Because European ancestry is a risk factor for AF (Marcus et al., 2010; Roselli et al., 2018), this may explain why incidence of AF is higher among White people than in other racial groups (Dewland et al., 2013; Volgman et al., 2019)."
  }, {
    "@value" : "The racial/ethnic categories proposed in the AFMO are not intended to be prescriptive or exhaustive. They can be adapted based on what is relevant for the target population."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Race or ethnicity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/phmo#DemographicFactor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "Ethnicity is a term for the ethnic group to which people belong. Usually it refers to group identity based on culture, religion, traditions, and customs. In some contexts, it is a “politically correct” term equivalent to the word “race,” which may have pejorative associations."
  }, {
    "@value" : "Race is a social construct used to group people. Race was constructed as a hierarchal human-grouping system, generating racial classifications to identify, distinguish and marginalize some groups across nations, regions and the world. Race divides human populations into groups often based on physical appearance, social factors and cultural backgrounds."
  } ]
}, {
