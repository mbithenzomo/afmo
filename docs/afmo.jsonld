}, {
  "@id" : "http://purl.org/afmo#InterventionExplanation1",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn" : [ {
    "@id" : "http://purl.org/afmo#HealthIntervention2"
  } ],
  "http://purl.org/phmo#hasText" : [ {
    "@value" : "Alcoholism counselling was recommended for Atieno, with an expected utility of 50 as calculated by the Bayesian decision network. Its efficacy in reducing alcohol misuse is supported by a systematic review and meta-analysis (Jonas et al., 2012)."
  } ],
  "http://purl.org/phmo#isConsumedBy" : [ {
    "@id" : "http://purl.org/afmo#DrChebet"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.org/heals/eo#scientificExplanation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Example scientific explanation of the recommendation of alcoholism counselling for Atieno, provided to her clinician Dr Chebet."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Intervention explanation 1"
  } ],
  "https://saref.etsi.org/core/hasTimestamp" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#dateTimeStamp",
    "@value" : "2026-09-21T14:30:00+03:00"
  } ]
}, {
  "@id" : "http://purl.org/afmo#InterventionExplanation2",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn" : [ {
    "@id" : "http://purl.org/afmo#HealthIntervention2"
  } ],
  "http://purl.org/phmo#hasText" : [ {
    "@value" : "Dr Chebet has approved alcohol counselling for you. Studies show that counselling helps people reduce how much they drink, and drinking less lowers your risk of atrial fibrillation (AF)."
  } ],
  "http://purl.org/phmo#isConsumedBy" : [ {
    "@id" : "http://purl.org/afmo#Atieno"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.org/heals/eo#scientificExplanation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Example scientific explanation of the recommendation of alcoholism counselling, provided to Atieno."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Intervention explanation 2"
  } ],
  "https://saref.etsi.org/core/hasTimestamp" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#dateTimeStamp",
    "@value" : "2026-09-21T19:30:00+03:00"
  } ]
}, {
  "@id" : "http://purl.org/afmo#InterventionExplanation3",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn" : [ {
    "@id" : "http://purl.org/afmo#HealthIntervention2"
  } ],
  "http://purl.org/phmo#hasText" : [ {
    "@value" : "Alcohol counselling has been recommended for Atieno because her alcohol use is one of the reasons her risk of atrial fibrillation (AF) is raised. Dr Chebet has approved it, and your support in helping her attend the sessions can make a difference."
  } ],
  "http://purl.org/phmo#isConsumedBy" : [ {
    "@id" : "http://purl.org/afmo#Bahati"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.org/heals/eo#RationaleExplanation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Example rationale explanation of the recommendation of alcoholism counselling for Atieno, provided to her caregiver Bahati."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Intervention explanation 3"
  } ],
  "https://saref.etsi.org/core/hasTimestamp" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#dateTimeStamp",
    "@value" : "2026-09-21T19:30:00+03:00"
  } ]
