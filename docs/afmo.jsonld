  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  relation from a Property to a Sensor that is able to observe it\n  "
  }, {
    "@language" : "en",
    "@value" : "Relation between an ObservableProperty and the Sensor able to observe it."
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/isPropertyOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://schema.org/domainIncludes" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relation from a Property to a FeatureOfInterest that it is a quality of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/sosa/Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/sosa/common/"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "is property of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/sosa/FeatureOfInterest"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "\n  relation from a Property to a FeatureOfInterest that it is a quality of\n  "
  } ]
}, {
  "@id" : "http://www.w3.org/ns/sosa/madeBySensor",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
