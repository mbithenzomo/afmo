  "http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn" : [ {
    "@id" : "http://purl.org/afmo#AFRiskAssessment1"
  } ],
  "http://purl.org/phmo#hasText" : [ {
    "@value" : "The assessment was made by a hybrid Bayesian network trained and tested on the MIMIC-IV dataset. It achieved an AUROC of 0.82, a recall of 0.89, and a specificity of 0.58 at its decision threshold of 0.053."
