  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Example data explanation of Atieno's AF risk assessment, provided to her clinician Dr Chebet."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "AF risk explanation 2"
  } ],
