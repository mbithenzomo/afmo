                                             rdfs:range <http://purl.org/phmo#HealthRiskFactor> ;
                                             rdfs:comment "The link between a category risk relationship and risk factor category." ;
                                             rdfs:label "has risk factor category" .


###  http://purl.org/phmo#hasRiskFactorState
<http://purl.org/phmo#hasRiskFactorState> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <http://purl.org/phmo#isRiskFactorStateInRelationship> ;
