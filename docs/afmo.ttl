                                                         <https://purl.org/heals/eo#SystemRecommendation> ,
                                                         <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                         <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                         <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                        rdfs:comment "The status for a disease risk (i.e. present or absent) in a monitored person." ;
                                        rdfs:label "Health risk status" .


###  http://purl.org/phmo#LifestyleFactor
<http://purl.org/phmo#LifestyleFactor> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://purl.org/phmo#HealthRiskFactor> .


###  http://purl.org/phmo#MedicalCondition
<http://purl.org/phmo#MedicalCondition> rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isConditionInComorbidityStatus> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#ComorbidityFactor>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isConditionInHealthEvent> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#HealthEvent>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isConditionInRiskAssessment> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#HealthRiskAssessment>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isConditionInRiskRelationship> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#HealthRiskRelationship>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isConditionInRiskStatus> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#HealthRiskStatus>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#hasICD10Block> ;
                                                          owl:someValuesFrom xsd:string
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#hasICD10Code> ;
                                                          owl:someValuesFrom xsd:string
                                                        ] ;
                                        owl:disjointWith <http://purl.org/phmo#Model> ,
                                                         <http://purl.org/phmo#Publication> ,
                                                         <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                         <http://www.w3.org/ns/sosa/Observation> ,
                                                         <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                         <http://www.w3.org/ns/sosa/Property> ,
                                                         <http://www.w3.org/ns/sosa/Sensor> ,
                                                         <http://xmlns.com/foaf/0.1/Agent> ,
                                                         <http://xmlns.com/foaf/0.1/Person> ,
                                                         <https://purl.org/heals/eo#SystemRecommendation> ,
                                                         <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                         <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                         <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                        rdfs:comment "A broad term that includes diseases, illnesses, disorders, defects and dysfunctions." ,
                                                     "All subclasses of this class are punned such that they are both classes and individuals. \"In OWL 2 the same name can be used for a class, a property and an individual, a feature known as punning.\"" ;
                                        rdfs:label "Medical condition" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.org/phmo#MedicalCondition> ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "All subclasses of this class are punned such that they are both classes and individuals. \"In OWL 2 the same name can be used for a class, a property and an individual, a feature known as punning.\"" ;
   rdfs:isDefinedBy "I. Horrocks and P. F. Patel-Schneider, “Knowledge Representation and Reasoning on the Semantic Web: OWL,” in Handbook of Semantic Web Technologies, Springer, 2011, pp. 365–398. https://doi.org/10.1007/978-3-540-92913-0_9"
 ] .


###  http://purl.org/phmo#Model
<http://purl.org/phmo#Model> rdf:type owl:Class ;
                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#madeEventPrediction> ;
                                               owl:someValuesFrom <http://purl.org/phmo#HealthEventPrediction>
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#madeRiskAssessment> ;
                                               owl:someValuesFrom <http://purl.org/phmo#HealthRiskAssessment>
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#wasTestedOn> ;
                                               owl:someValuesFrom <http://www.w3.org/ns/dcat#Dataset>
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#wasTrainedOn> ;
                                               owl:someValuesFrom <http://www.w3.org/ns/dcat#Dataset>
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#hasPerformanceMetric> ;
                                               owl:someValuesFrom xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#hasAUPRC> ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#hasAUROC> ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#hasBrierScore> ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#hasDecisionThreshold> ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#hasExpectedCalibrationError> ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#hasF1Score> ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#hasRecall> ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#hasSpecificity> ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:float
                                             ] ;
                             owl:disjointWith <http://purl.org/phmo#Publication> ,
                                              <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                              <http://www.w3.org/ns/sosa/Observation> ,
                                              <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                              <http://www.w3.org/ns/sosa/Property> ,
                                              <http://xmlns.com/foaf/0.1/Agent> ,
                                              <http://xmlns.com/foaf/0.1/Person> ,
                                              <https://purl.org/heals/eo#SystemRecommendation> ,
                                              <https://saref.etsi.org/saref4ehaw/HealthDevice> ;
                             rdfs:comment "The model used to determine a health risk assessment or an event prediction." ;
                             rdfs:label "Model" .


###  http://purl.org/phmo#MonitoredPerson
<http://purl.org/phmo#MonitoredPerson> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                       <https://purl.org/heals/eo#user> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasECGFactorStatus ;
                                                         owl:someValuesFrom :ECGFactor
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasHeightGroup ;
                                                         owl:someValuesFrom :HeightGroup
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasBMICategory> ;
                                                         owl:someValuesFrom <http://purl.org/phmo#BMICategory>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasComorbidityStatus> ;
                                                         owl:someValuesFrom <http://purl.org/phmo#ComorbidityFactor>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasPrediction> ;
                                                         owl:someValuesFrom <http://purl.org/phmo#HealthEventPrediction>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasRiskAssessment> ;
                                                         owl:someValuesFrom <http://purl.org/phmo#HealthRiskAssessment>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasRiskFactorStatus> ;
                                                         owl:someValuesFrom <http://purl.org/phmo#HealthRiskFactor>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasSex> ;
                                                         owl:someValuesFrom <http://purl.org/phmo#Sex>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#wearsDevice> ;
                                                         owl:someValuesFrom <https://saref.etsi.org/saref4wear/WearableDevice>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasRaceOrEthnicity ;
                                                         owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :RaceOrEthnicity
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasAgeGroup ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :AgeGroup
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasAlcoholMisuseStatus ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :AlcoholMisuse
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasPRIntervalVariationStatus ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :PRIntervalVariation
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasPWaveVariationStatus ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :PWaveVariation
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasProlongedPRIntervalStatus ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :ProlongedPRInterval
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasProlongedPWaveStatus ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :ProlongedPWave
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasProlongedRRIntervalStatus ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :ProlongedRRInterval
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasRRIntervalVariationStatus ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :RRIntervalVariation
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasSmokingStatus ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :SmokingStatus
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasAge> ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onDataRange xsd:integer
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasBMI> ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onDataRange xsd:decimal
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasIDNumber> ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onDataRange xsd:string
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://xmlns.com/foaf/0.1/birthday> ;
                                                         owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onDataRange xsd:date
                                                       ] ;
                                       rdfs:comment "A person being monitored by the system." ;
                                       rdfs:label "Monitored person" ;
                                       <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://purl.org/heals/eo#object_record> .


###  http://purl.org/phmo#Publication
<http://purl.org/phmo#Publication> rdf:type owl:Class ;
                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/dc/terms/creator> ;
                                                     owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/phmo#isPublicationOf> ;
                                                     owl:someValuesFrom <http://purl.obolibrary.org/obo/ECO_0000000>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                     owl:someValuesFrom <http://purl.org/spar/fabio/Book>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/dc/terms/creator> ;
                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass [ rdf:type owl:Class ;
                                                                   owl:unionOf ( <http://purl.org/phmo#Author>
                                                                                 <http://xmlns.com/foaf/0.1/Organization>
                                                                               )
                                                                 ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/doi> ;
                                                     owl:someValuesFrom xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/phmo#hasPublicationMonthYear> ;
                                                     owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                          owl:unionOf ( xsd:gYear
                                                                                        xsd:gYearMonth
                                                                                      )
                                                                        ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/isbn> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/dc/terms/title> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ;
                                   owl:disjointWith <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                    <http://www.w3.org/ns/sosa/Observation> ,
                                                    <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                    <http://www.w3.org/ns/sosa/Property> ,
                                                    <http://www.w3.org/ns/sosa/Sensor> ,
                                                    <http://xmlns.com/foaf/0.1/Agent> ,
                                                    <http://xmlns.com/foaf/0.1/Person> ,
                                                    <https://purl.org/heals/eo#SystemRecommendation> ,
                                                    <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                    <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                    <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                   <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "http://purl.org/spar/fabio/Expression" ;
                                   rdfs:comment "A publication is a documentation of scientific knowledge released for public distribution." ;
                                   rdfs:label "Publication" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.org/phmo#Publication> ;
   owl:annotatedProperty <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> ;
   owl:annotatedTarget "http://purl.org/spar/fabio/Expression" ;
   <http://purl.obolibrary.org/obo/IAO_0000115> "A subclass of FRBR expression, restricted to expressions of fabio:Works.  For your latest research paper, the preprint submitted to the publisher, and the final published version to which the publisher assigned a unique digital object identifier, are both expressions of the same work." ;
   <http://purl.obolibrary.org/obo/IAO_0000119> "FaBiO, the FRBR-aligned Bibliographic Ontology" ;
   rdfs:comment "A Publication can be considered an Expression of a Work."
 ] .


###  http://purl.org/phmo#Sex
<http://purl.org/phmo#Sex> rdf:type owl:Class ;
                           owl:equivalentClass [ rdf:type owl:Class ;
                                                 owl:oneOf ( <http://purl.org/phmo#Female>
                                                             <http://purl.org/phmo#Male>
                                                             <http://purl.org/phmo#Specified>
                                                           )
                                               ] ;
                           rdfs:subClassOf <http://purl.org/phmo#DemographicFactor> .


###  http://purl.org/phmo#Stadiometer
<http://purl.org/phmo#Stadiometer> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://saref.etsi.org/saref4ehaw/HealthSensor> ;
                                   rdfs:comment "Medical equipment used to measure human height." ;
                                   rdfs:label "Stadiometer" .


###  http://purl.org/phmo#StateRiskRelationship
<http://purl.org/phmo#StateRiskRelationship> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.org/phmo#HealthRiskRelationship> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasRiskFactorState> ;
                                                               owl:someValuesFrom <http://purl.org/phmo#HealthRiskFactor>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasStateRisk> ;
                                                               owl:someValuesFrom xsd:decimal
                                                             ] ;
                                             rdfs:comment "The relationship between a risk factor state and a medical condition." ;
                                             rdfs:label "State risk relationship" ;
                                             <http://www.w3.org/2004/02/skos/core#relatedMatch> <https://purl.org/heals/eo#Numerical_Evidence> .


###  http://purl.org/phmo#VitalSign
<http://purl.org/phmo#VitalSign> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://saref.etsi.org/saref4wear/BiometricProperty> ;
                                 <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UMLS:C0518766" ;
                                 rdfs:comment "The signs of life that may be monitored or measured, namely pulse rate, respiratory rate, body temperature, and blood pressure." ;
                                 rdfs:label "Vital sign" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.org/phmo#VitalSign> ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "The signs of life that may be monitored or measured, namely pulse rate, respiratory rate, body temperature, and blood pressure." ;
   rdfs:isDefinedBy "The Medical Subject Headings (MeSH) Thesaurus, https://www.ncbi.nlm.nih.gov/mesh/?term=D055986. Accessed 21 June 2023."
 ] .


###  http://purl.org/spar/fabio/AcademicProceedings
<http://purl.org/spar/fabio/AcademicProceedings> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.org/phmo#Publication> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                                   owl:someValuesFrom <http://purl.org/spar/fabio/ProceedingsPaper>
                                                                 ] ;
                                                 <http://purl.org/vocab/vann/example> """
        :my-academic-proceedings a fabio:AcademicProceedings ;
            dcterms:title 'Patent Infringement Proceedings'@en ;
            frbr:part :my-proceedings-paper .
    """ ;
                                                 rdfs:comment "A document containing the programme and collected papers, or their abstracts, presented at an academic meeting."@en ;
                                                 rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                                 rdfs:label "Academic proceedings"@en ;
                                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://purl.org/spar/fabio/Book
<http://purl.org/spar/fabio/Book> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://purl.org/phmo#Publication> ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                    owl:someValuesFrom <http://purl.org/spar/fabio/BookChapter>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/isbn> ;
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onDataRange xsd:string
                                                  ] ;
                                  rdfs:comment "A non-serial document that is complete in one volume or a designated finite number of volumes.  A book published by a publisher is usually  identified by an International Standard Book Number (ISBN), and may be manifested as a physical printed publication on paper bound in a hard or soft cover, or in electronic format as an 'e-book'."@en ;
                                  rdfs:label "Book"@en .


###  http://purl.org/spar/fabio/BookChapter
<http://purl.org/spar/fabio/BookChapter> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://purl.org/phmo#Publication> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                           owl:someValuesFrom <http://purl.org/spar/fabio/Book>
                                                         ] ;
                                         rdfs:comment "A defined chapter of a book, usually with a separate title or number."@en ;
                                         rdfs:label "Book chapter"@en .


###  http://purl.org/spar/fabio/ClinicalCaseReport
<http://purl.org/spar/fabio/ClinicalCaseReport> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                                rdfs:comment "A presentation of findings following a clinical or medical investigation on a human or animal patient, that may contain a diagnosis and proposals for therapeutic treatment and/or epidemiological control measures, or may propose further evaluative studies that will eventually lead to such outcomes."@en ;
                                                rdfs:label "Clinical case report"@en .


###  http://purl.org/spar/fabio/ClinicalGuideline
<http://purl.org/spar/fabio/ClinicalGuideline> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                               rdfs:comment "A recommendation on the appropriate treatment and care of people with a specific disease or condition, based on the best available evidence, designed to help healthcare professionals in their work."@en ;
                                               rdfs:label "Clinical guideline"@en .


###  http://purl.org/spar/fabio/ConferencePaper
<http://purl.org/spar/fabio/ConferencePaper> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.org/spar/fabio/ProceedingsPaper> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                               owl:someValuesFrom <http://purl.org/spar/fabio/ConferenceProceedings>
                                                             ] ;
                                             rdfs:comment "A paper, typically the realization of a research paper reporting original research findings, usually published within a conference proceedings volume."@en ;
                                             rdfs:label "Conference paper"@en .


###  http://purl.org/spar/fabio/ConferenceProceedings
<http://purl.org/spar/fabio/ConferenceProceedings> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://purl.org/spar/fabio/AcademicProceedings> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                                     owl:someValuesFrom <http://purl.org/spar/fabio/ConferencePaper>
                                                                   ] ;
                                                   <http://purl.org/vocab/vann/example> """
        :my-conference-proceedings a fabio:ConferenceProceedings ;
            dcterms:title 'Proceedings of the 25th International Semantic Web Conference'@en ;
            frbr:part :my-conference-paper, :my-another-conference-paper ;
            dcterms:description 'The formal record of a conference, containing the collection of papers and abstracts presented.'@en .
    """ ;
                                                   rdfs:comment "A document containing the programme and collected conference papers, or their abstracts, presented at a conference, seminar, symposium or similar event."@en ;
                                                   rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                                   rdfs:label "Conference proceedings"@en ;
                                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://purl.org/spar/fabio/Journal
<http://purl.org/spar/fabio/Journal> rdf:type owl:Class ;
                                     rdfs:subClassOf <http://purl.org/phmo#Publication> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                       owl:someValuesFrom <http://purl.org/spar/fabio/JournalArticle>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                       owl:someValuesFrom <http://purl.org/spar/fabio/JournalIssue>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                       owl:someValuesFrom <http://purl.org/spar/fabio/JournalVolume>
                                                     ] ;
                                     <http://purl.org/vocab/vann/example> """
        :my-journal a fabio:Journal ;
            dcterms:title 'Journal of Semantic Web Research'@en ;
            frbr:part :my-journal-issue , :my-journal-volume ;
            dcterms:description 'A scholarly periodical maintaining high standards of research and typically published at regular intervals.'@en .
    """ ;
                                     rdfs:comment "A scholarly periodical primarily devoted to the publication of original research papers."@en ;
                                     rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                     rdfs:label "Journal"@en ;
                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en ;
                                     <http://www.w3.org/2004/02/skos/core#scopeNote> "Printed and electronic manifestations of the same journal are usually identified by separate print and electronic International Standard Serial Numbers (ISSN or eISSN, respectively), that identifies the journal as a whole, not to individual issues of it."@en .


###  http://purl.org/spar/fabio/JournalArticle
<http://purl.org/spar/fabio/JournalArticle> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.org/phmo#Publication> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                              owl:someValuesFrom <http://purl.org/spar/fabio/JournalIssue>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                              owl:someValuesFrom <http://purl.org/spar/fabio/JournalVolume>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/doi> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onDataRange xsd:string
                                                            ] ;
                                            rdfs:comment "An article, typically the realization of a research paper reporting original research findings, published in a journal issue.  "@en ;
                                            rdfs:label "Journal article"@en .


###  http://purl.org/spar/fabio/JournalIssue
<http://purl.org/spar/fabio/JournalIssue> rdf:type owl:Class ;
                                          rdfs:subClassOf <http://purl.org/phmo#Publication> ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                            owl:someValuesFrom <http://purl.org/spar/fabio/JournalArticle>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                            owl:someValuesFrom <http://purl.org/spar/fabio/JournalVolume>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/issueIdentifier> ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onDataRange xsd:int
                                                          ] ;
                                          <http://purl.org/vocab/vann/example> """
        :my-journal-issue a fabio:JournalIssue ;
            dcterms:title 'Journal of Semantic Web, Volume 1, Issue 1'@en ;
            frbr:partOf :my-journal-volume ;
            dcterms:description 'A particular issue of a journal or other periodical.'@en .
    """ ;
                                          rdfs:comment "A particular published issue of a journal, one or more of which will constitute a volume of the journal."@en ;
                                          rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                          rdfs:label "Journal issue"@en ;
                                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://purl.org/spar/fabio/JournalVolume
<http://purl.org/spar/fabio/JournalVolume> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.org/phmo#Publication> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                             owl:someValuesFrom <http://purl.org/spar/fabio/JournalArticle>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                             owl:someValuesFrom <http://purl.org/spar/fabio/JournalIssue>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                             owl:someValuesFrom <http://purl.org/spar/fabio/Journal>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/volume> ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onDataRange xsd:int
                                                           ] ;
                                           <http://purl.org/vocab/vann/example> """
        :my-journal-volume a fabio:JournalVolume ;
            dcterms:title 'Journal of Semantic Web Research, Volume 1'@en ;
            frbr:partOf :my-journal ;
            dcterms:description 'A particular volume of a journal or other periodical, usually collecting all issues published within a single year.'@en .
    """ ;
                                           rdfs:comment "A particular published volume of a journal, comprising one or more journal issues."@en ;
                                           rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                           rdfs:label "Journal volume"@en ;
                                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://purl.org/spar/fabio/ProceedingsPaper
<http://purl.org/spar/fabio/ProceedingsPaper> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.org/phmo#Publication> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                                owl:someValuesFrom <http://purl.org/spar/fabio/AcademicProceedings>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://prismstandard.org/namespaces/basic/2.0/doi> ;
                                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                owl:onDataRange xsd:string
                                                              ] ;
                                              rdfs:comment "A paper, typically the realization of a research paper reporting original research findings, usually published within an academic proceedings volume."@en ;
                                              rdfs:label "Proceedings paper"@en .


###  http://purl.org/spar/fabio/ResearchPaper
<http://purl.org/spar/fabio/ResearchPaper> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                           rdfs:comment """A scholarly work that reports original research contributions addressing theoretical, analytical or experimental aspects of a particular scholarly domain.

E.g. see http://iswc2018.semanticweb.org/call-for-research-track-papers/."""@en ;
                                           rdfs:label "Research paper"@en .


###  http://purl.org/spar/fabio/Review
<http://purl.org/spar/fabio/Review> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                    rdfs:comment "A review of others' work."@en ;
                                    rdfs:label "Review"@en .


###  http://purl.org/spar/fabio/ReviewPaper
<http://purl.org/spar/fabio/ReviewPaper> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://purl.org/spar/fabio/Review> ;
                                         rdfs:comment """A scholarly work that surveys the state of the art of topics central to a particular subject or relating to a specific domain (e.g. the scope of a certain journal or conference). Papers of this kind may contain a selective bibliography listing key papers related to the subject or providing advice on information sources, or they may strive to be comprehensive, covering all contributions to the development of a topic and exploring their different findings or views.

E.g. see http://www.emeraldgrouppublishing.com/products/journals/author_guidelines.htm?id=JD"""@en ;
                                         rdfs:label "Review paper"@en .


###  http://purl.org/spar/fabio/SystematicReview
<http://purl.org/spar/fabio/SystematicReview> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.org/spar/fabio/Review> ;
                                              rdfs:comment "A literature review focused on a single question that tries to identify, appraise, select and synthesize all high quality research evidence relevant to that question. Systematic reviews of high-quality randomized controlled trials are crucial to evidence-based medicine. An understanding of systematic reviews and how to implement them in practice is becoming mandatory for all professionals involved in the delivery of health care. Systematic reviews are not limited to medicine,  and are quite common in other sciences such as psychology, educational research and sociology."@en ;
                                              rdfs:label "Systematic review"@en .


###  http://purl.org/spar/fabio/WorkshopPaper
<http://purl.org/spar/fabio/WorkshopPaper> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.org/spar/fabio/ProceedingsPaper> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/vocab/frbr/core#partOf> ;
                                                             owl:someValuesFrom <http://purl.org/spar/fabio/WorkshopProceedings>
                                                           ] ;
                                           rdfs:comment "A paper, typically the realization of a research paper reporting original research findings, usually presented at a workshop and published within a workshop proceedings volume."@en ;
                                           rdfs:label "Workshop paper"@en .


###  http://purl.org/spar/fabio/WorkshopProceedings
<http://purl.org/spar/fabio/WorkshopProceedings> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.org/spar/fabio/AcademicProceedings> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <http://purl.org/vocab/frbr/core#part> ;
                                                                   owl:someValuesFrom <http://purl.org/spar/fabio/WorkshopPaper>
                                                                 ] ;
                                                 <http://purl.org/vocab/vann/example> """
        :my-workshop-proceedings a fabio:WorkshopProceedings ;
            dcterms:title 'Proceedings of the International Workshop on Linked Open Data 2026'@en ;
            frbr:part :my-workshop-paper ;
            dcterms:description 'A collection of papers presented at a workshop.'@en .
    """ ;
                                                 rdfs:comment "A document containing the programme and collected workshop papers, or their abstracts, presented at a workshop or similar event."@en ;
                                                 rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                                 rdfs:label "Workshop proceedings"@en ;
                                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://www.w3.org/ns/dcat#Dataset
<http://www.w3.org/ns/dcat#Dataset> rdf:type owl:Class ;
                                    owl:disjointWith <https://purl.org/heals/eo#SystemRecommendation> ;
                                    rdfs:comment "A collection of data, published or curated by a single agent, and available for access or download in one or more representations." ;
                                    rdfs:isDefinedBy <http://www.w3.org/ns/dcat#> ;
                                    rdfs:label "Dataset" .


###  http://www.w3.org/ns/sosa/FeatureOfInterest
<http://www.w3.org/ns/sosa/FeatureOfInterest> rdf:type owl:Class ;
                                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://www.w3.org/ns/sosa/isFeatureOfInterestOf> ;
                                                                owl:someValuesFrom <http://www.w3.org/ns/sosa/Observation>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://www.w3.org/ns/sosa/isFeatureOfInterestOf> ;
                                                                owl:someValuesFrom <http://www.w3.org/ns/sosa/ObservationCollection>
                                                              ] ;
                                              owl:disjointWith <http://www.w3.org/ns/sosa/Observation> ,
                                                               <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                               <http://www.w3.org/ns/sosa/Property> ,
                                                               <http://www.w3.org/ns/sosa/Sensor> ,
                                                               <http://xmlns.com/foaf/0.1/Organization> ,
                                                               <https://purl.org/heals/eo#SystemRecommendation> ,
                                                               <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                               <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                               <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                              rdfs:comment "entity that is the target of an Execution or Deployment i.e., whose property is being estimated by an Observation, or whose property is being manipulated by an Actuator, or which is being sampled or transformed in an act of Sampling, or which is the target of Executions planned as part of a Deployment." ;
                                              rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                              rdfs:label "Feature of interest"@en ;
                                              <http://www.w3.org/2004/02/skos/core#definition> """
  entity that is the target of an Execution or Deployment

  i.e., whose property is being estimated by an Observation, 
  or whose property is being manipulated by an Actuator, 
  or which is being sampled or transformed in an act of Sampling, 
  or which is the target of Executions planned as part of a Deployment.
  """@en ;
                                              <http://www.w3.org/2004/02/skos/core#example> "When measuring the height of a tree, the height is the observed Property, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuation."@en .


###  http://www.w3.org/ns/sosa/Observation
<http://www.w3.org/ns/sosa/Observation> rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/isMemberOf> ;
                                                          owl:someValuesFrom <http://www.w3.org/ns/sosa/ObservationCollection>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/madeBySensor> ;
                                                          owl:someValuesFrom <http://www.w3.org/ns/sosa/Sensor>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <http://www.w3.org/ns/sosa/FeatureOfInterest>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://www.w3.org/ns/sosa/observedProperty> ;
                                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                          owl:onClass <http://www.w3.org/ns/sosa/Property>
                                                        ] ;
                                        owl:disjointWith <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                         <http://www.w3.org/ns/sosa/Property> ,
                                                         <http://www.w3.org/ns/sosa/Sensor> ,
                                                         <http://xmlns.com/foaf/0.1/Agent> ,
                                                         <http://xmlns.com/foaf/0.1/Person> ,
                                                         <https://purl.org/heals/eo#SystemRecommendation> ,
                                                         <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                         <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                         <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                        rdfs:comment "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en ;
                                        rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                         <http://www.w3.org/ns/sosa/obs/> ;
                                        rdfs:label "Observation"@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> """
  act of carrying out an ObservingProcedure using a Sensor to estimate or calculate a value of an observable Property of a FeatureOfInterest
  """@en ,
                                                                                         "Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with."@en ;
                                        <http://www.w3.org/2004/02/skos/core#example> "The activity of estimating the intensity of an Earthquake using the Mercalli intensity scale is an Observation as is measuring the moment magnitude, i.e., the energy released by said earthquake."@en ;
                                        <http://www.w3.org/2004/02/skos/core#note> """
  When the feature of interest cannot be observed directly, a sample of it might be used in Observations as a proxy for it. In such case, the Sample is the proximate Feature of Interest of the Observation, while the (ultimate) Feature of Interest of the act of Sampling (i.e., the entity that the Sample is ultimately 'isSampleOf') is the ultimate Feature of Interest of the Observation.
  """ ;
                                        <http://www.w3.org/2004/02/skos/core#scopeNote> """
  An Observation primarily concerns a single Property of a single FeatureOfInterest. 
  Observations of multiple properties, or other combinations of Observations, may be described in an ObservationCollection. 
  
  Alternatively, applications may choose to encapsulate complexity by defining a complex property with multiple individual components, and a corresponding complex result (e.g., a vector). 
  This approach is not prohibited by the SSN Ontology, but the details are beyond the scope of SSN.
  """@en .


###  http://www.w3.org/ns/sosa/ObservationCollection
<http://www.w3.org/ns/sosa/ObservationCollection> rdf:type owl:Class ;
                                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ;
                                                                    owl:someValuesFrom <http://www.w3.org/ns/sosa/FeatureOfInterest>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://www.w3.org/ns/sosa/hasMember> ;
                                                                    owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                                                    owl:onClass <http://www.w3.org/ns/sosa/Observation>
                                                                  ] ;
                                                  owl:disjointWith <http://www.w3.org/ns/sosa/Property> ,
                                                                   <http://www.w3.org/ns/sosa/Sensor> ,
                                                                   <http://xmlns.com/foaf/0.1/Agent> ,
                                                                   <http://xmlns.com/foaf/0.1/Person> ,
                                                                   <https://purl.org/heals/eo#SystemRecommendation> ,
                                                                   <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                                   <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                                   <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                                  rdfs:comment "set of Observations or ObservationCollections; collections may be nested All Observation properties may appear in an Observation Collection, including: hasFeatureOfInterest , hasUltimateFeatureOfInterest , usedProcedure , madeBySensor , observedProperty , phenomenonTime , startTime, resultTime , hasResult , hasSimpleResult : If they are present, the value of these properties summarize the values of the matching properties of the member observations, where membership is either direct or transitive through one or more member observation collections. The following consistency rules apply with respect to the Observation properties listed above: 1. Where an individual Observation Collection omits a property, a member Observation (direct or transitive) MAY have any value for that property. 2. Where an individual Observation Collection has a single value for a property, each member Observation(direct or transitive) MUST have that same value for the property - i.e., the collection is homogeneous in that property. That property MAY then be omitted in any member Observation or Observation Collection. 3. Where an individual Observation Collection has more than one value for a property, each member Observation (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection. 4. Where an individual Observation Collection has a value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that matches or falls within that range or interval. 5. Where an individual Observation Collection has more than one value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that either matches or falls within one of those ranges or intervals." ;
                                                  rdfs:isDefinedBy <http://www.w3.org/ns/sosa/obs/> ;
                                                  rdfs:label "Observation collection"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> """
  set of Observations or ObservationCollections; collections may be nested

  All Observation properties may appear in an Observation Collection, including: 
  hasFeatureOfInterest , hasUltimateFeatureOfInterest , usedProcedure , madeBySensor , observedProperty , phenomenonTime , startTime, resultTime , hasResult , hasSimpleResult : 
  If they are present, the value of these properties summarize the values of the matching properties of the member observations, where membership is either direct or transitive through one or more member observation collections. 
  The following consistency rules apply with respect to the Observation properties listed above: 
  
  1. Where an individual Observation Collection omits a property, a member Observation (direct or transitive) MAY have any value for that property.

  2. Where an individual Observation Collection has a single value for a property, each member Observation(direct or transitive) MUST have that same value for the property - i.e., the collection is homogeneous in that property.  That property MAY then be omitted in any member Observation or Observation Collection.

  3. Where an individual Observation Collection has more than one value for a property, each member Observation (direct or transitive) MUST have a value for that property that matches one of the values for the property in the collection. 
  
  4. Where an individual Observation Collection has a value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that matches or falls within that range or interval.

  5. Where an individual Observation Collection has more than one value for a property that is a range or interval, each member Observation (direct or transitive) MUST have a value for that property that either matches or falls within one of those ranges or intervals.
  """@en ;
                                                  <http://www.w3.org/2004/02/skos/core#note> """An instance of ObservationCollection represents a container for a set of data derived from observations.
  This broadly corresponds with the class Dataset from DCAT."""@en ,
                                                                                             "The members of a collection do not necessarily share a common value for any property. "@en ,
                                                                                             """The results of collections of observations are often packaged in a 'data cube' whose axes define the
      range of properties of the set of observations.""" .


###  http://www.w3.org/ns/sosa/Property
<http://www.w3.org/ns/sosa/Property> rdf:type owl:Class ;
                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/isObservedBy> ;
                                                       owl:someValuesFrom <http://www.w3.org/ns/sosa/Sensor>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/sosa/wasObservedBy> ;
                                                       owl:someValuesFrom <http://www.w3.org/ns/sosa/Observation>
                                                     ] ;
                                     owl:disjointWith <http://www.w3.org/ns/sosa/Sensor> ,
                                                      <http://xmlns.com/foaf/0.1/Agent> ,
                                                      <http://xmlns.com/foaf/0.1/Person> ,
                                                      <https://purl.org/heals/eo#SystemRecommendation> ,
                                                      <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                      <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                      <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                     rdfs:comment "identifiable quality of features of interest that can be observed or acted upon A property can apply to different features of interest." ;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                     rdfs:label "Property"@en ;
                                     <http://www.w3.org/2004/02/skos/core#definition> """
  identifiable quality of features of interest that can be observed or acted upon

  A property can apply to different features of interest.

  """@en ;
                                     <http://www.w3.org/2004/02/skos/core#example> "Cars (a feature type) all have a characteristic colour, where 'colour' is a property."@en ;
                                     <http://www.w3.org/2004/02/skos/core#note> "Concepts from existing code lists, vocabularies, and taxonomies, may be used as instances of Property"@en .


###  http://www.w3.org/ns/sosa/Sensor
<http://www.w3.org/ns/sosa/Sensor> rdf:type owl:Class ;
                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/madeObservation> ;
                                                     owl:someValuesFrom <http://www.w3.org/ns/sosa/Observation>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/sosa/observes> ;
                                                     owl:someValuesFrom <http://www.w3.org/ns/sosa/Property>
                                                   ] ;
                                   owl:disjointWith <http://xmlns.com/foaf/0.1/Person> ,
                                                    <https://purl.org/heals/eo#SystemRecommendation> ,
                                                    <https://saref.etsi.org/core/UnitOfMeasure> ;
                                   rdfs:comment "System that implements an ObservingProcedure to determine the value of an observable Property This may be a device, a piece of infrastructure, an agent (including humans), or software (simulation). A Sensor responds to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations." ;
                                   rdfs:isDefinedBy <http://www.w3.org/ns/sosa/obs/> ;
                                   rdfs:label "Sensor"@en ;
                                   <http://www.w3.org/2004/02/skos/core#altLabel> "Observer"@en ;
                                   <http://www.w3.org/2004/02/skos/core#definition> """
  System that implements an ObservingProcedure to determine the value of an observable Property

  This may be a device, a piece of infrastructure, an agent (including humans), or software (simulation).

  A Sensor responds to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations.
  """@en ;
                                   <http://www.w3.org/2004/02/skos/core#example> "Accelerometers, gyroscopes, barometers, magnetometers, and so forth are Sensors that are typically mounted on a modern smartphone (which acts as Host or Platform). Other examples of Sensors include the human eyes."@en ;
                                   <http://www.w3.org/2004/02/skos/core#note> "The UML class 'Observer' from ISO 19156:2023 is implemented in SOSA by the OWL/RDFS class 'Sensor'. The class name 'Sensor' is preferred for backward compatibility with existing SOSA deployments. " ;
                                   <http://www.w3.org/2004/02/skos/core#prefLabel> "Sensor"@en .


###  http://xmlns.com/foaf/0.1/Agent
<http://xmlns.com/foaf/0.1/Agent> rdf:type owl:Class ;
                                  owl:disjointWith <https://purl.org/heals/eo#SystemRecommendation> ,
                                                   <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                   <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                   <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                  rdfs:comment "An agent (eg. person, group, software or physical artifact)." ;
                                  rdfs:label "Agent" ;
                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://xmlns.com/foaf/0.1/Organization
<http://xmlns.com/foaf/0.1/Organization> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://purl.org/phmo#isCreatorOf> ;
                                                           owl:someValuesFrom <http://purl.org/phmo#Publication>
                                                         ] ;
                                         owl:disjointWith <http://xmlns.com/foaf/0.1/Person> ;
                                         rdfs:comment "An organization." ;
                                         rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                         rdfs:label "Organization" ;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://xmlns.com/foaf/0.1/Person
<http://xmlns.com/foaf/0.1/Person> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://xmlns.com/foaf/0.1/firstName> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://xmlns.com/foaf/0.1/name> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://xmlns.com/foaf/0.1/surname> ;
                                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onDataRange xsd:string
                                                   ] ;
                                   owl:disjointWith <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                    <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                    <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                   rdfs:comment "A person." ;
                                   rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                   rdfs:label "Person" ;
                                   <http://www.w3.org/2003/06/sw-vocab-status/nsterm_status> "stable" .


###  https://purl.org/heals/eo#ContrastiveExplanation
<https://purl.org/heals/eo#ContrastiveExplanation> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                   <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                   rdfs:comment "Answers the question “Why this output instead of that output,” making a contrast between the given output and the facts that led to it (inputs and other considerations), and an alternate output of interest and the foil (facts that would have led to it)." ;
                                                   rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                   rdfs:label "Contrastive explanation" ;
                                                   <http://www.w3.org/2004/02/skos/core#example> "Why choose option A over option B that I typically choose?" ;
                                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a ‘system recommendation’ that was made (let’s call it A)? What facts led to it? Is there another ‘system recommendation’ that could have happened or did occur, (let’s call it B)? What was the ‘foil’ that led to B? Can A and B be compared?" .


###  https://purl.org/heals/eo#CounterfactualExplanation
<https://purl.org/heals/eo#CounterfactualExplanation> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                      <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                      rdfs:comment "Addresses the question of what solutions would have been obtained with a different set of inputs than those used." ;
                                                      rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                      rdfs:label "Counterfactual explanation" ;
                                                      <http://www.w3.org/2004/02/skos/core#example> "What if input A was over 1000?" ;
                                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a different set of inputs that can be considered? If so what is the alternate ‘system recommendation’?" .


###  https://purl.org/heals/eo#DataExplanation
<https://purl.org/heals/eo#DataExplanation> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.org/heals/eo#SafetyAndPerformanceExplanation> ;
                                            <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                            rdfs:comment "Focuses on what the data is and how it has been used in a particular decision, as well as what data and how it has been used to train and test the ML model. This type of explanation can help users understand the influence of data on decisions." ;
                                            rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                            rdfs:label "Data explanation" ;
                                            <http://www.w3.org/2004/02/skos/core#example> "How has the data been used to train the ML model?" ,
                                                                                          "How it has been used in a particular decision?" ,
                                                                                          "What the data is?" ;
                                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a ‘system recommendation’ from an ‘AI method’ that has as input, a ‘dataset’ or part of it? Is there a ‘system recommendation’ that includes ‘object records’ that are used to train / test the ‘AI method’?" .


###  https://purl.org/heals/eo#RationaleExplanation
<https://purl.org/heals/eo#RationaleExplanation> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                 <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                 rdfs:comment "About the “why” of an ML decision and provides reasons that led to a decision, and is delivered in an accessible and understandable way, especially for lay users. If the ML decision was not what users expected, rationale explanations allows users to assess whether they believe the reasoning of the decision is flawed. While, if so, the explanation supports them to formulate reasonable arguments for why they think this is the case." ;
                                                 rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                 rdfs:label "Rationale explanation" ;
                                                 <http://www.w3.org/2004/02/skos/core#example> "Why was this ML decision made and provide reasons that led to a decision?" ;
                                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a ‘system recommendation’ from an ‘AI method’ that has a ‘system trace’? Is there a ‘local explanation’ output that an ‘explanation’ is based on?" .


###  https://purl.org/heals/eo#SafetyAndPerformanceExplanation
<https://purl.org/heals/eo#SafetyAndPerformanceExplanation> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                            <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                            rdfs:comment "Deals with steps taken across the design and implementation of an ML system to maximise the accuracy, reliability, security, and robustness of its decisions and behaviours. Safety and performance explanations help to assure individuals that an ML system is safe and reliable by explanation to test and monitor the accuracy, reliability, security, and robustness of the ML model." ;
                                                            rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                            rdfs:label "Safety and performance explanation" ;
                                                            <http://www.w3.org/2004/02/skos/core#example> "How has the data been used to train the ML model?" ,
                                                                                                          "What steps were taken to ensure robustness and reliability of AI method?" ,
                                                                                                          "What steps were taken to ensure robustness and reliability of system?" ,
                                                                                                          "What were the plans for the system development?" ;
                                                            <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there a ‘system recommendation’ from an ‘AI method’ that is part of a ‘system’ that exposes its design ‘plans’? Is there a ‘system recommendation’ that includes ‘object records’ that are used to train / test the ‘AI method’?" .


###  https://purl.org/heals/eo#StatisticalExplanation
<https://purl.org/heals/eo#StatisticalExplanation> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                   <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                   rdfs:comment "Presents an account of the outcome based on data about the occurrence of events under specified (e.g., experimental) conditions. Statistical explanations refer to numerical evidence on the likelihood of factors or processes influencing the result." ;
                                                   rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                   rdfs:label "Statistical explanation" ;
                                                   <http://www.w3.org/2004/02/skos/core#example> "What percentage of people with this condition have recovered?" ;
                                                   <http://www.w3.org/2004/02/skos/core#scopeNote> "Is there ‘numerical evidence’/likelihood account of the ‘system recommendation’ based on data about the occurrence of the outcome described in the recommendation?" .


###  https://purl.org/heals/eo#SystemRecommendation
<https://purl.org/heals/eo#SystemRecommendation> rdf:type owl:Class ;
                                                 owl:disjointWith <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                                  <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                                  <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                                 <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                 rdfs:comment "An output of an AI system, generated by an AI task using an AI method, on which an explanation is based." ;
                                                 rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                 rdfs:label "System recommendation" .


###  https://purl.org/heals/eo#scientificExplanation
<https://purl.org/heals/eo#scientificExplanation> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                  <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                  rdfs:comment "References the results of rigorous scientific methods, observations, and measurements." ;
                                                  rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                                  rdfs:label "Scientific explanation" ;
                                                  <http://www.w3.org/2004/02/skos/core#example> "What studies have backed this recommendation?" ;
                                                  <http://www.w3.org/2004/02/skos/core#scopeNote> "Are there results of rigorous ‘scientific methods’ to explain the situation? Is there ‘evidence’ from the literature to explain this ‘system recommendation’, ‘situation’ or ‘object record’?" .


###  https://purl.org/heals/eo#user
<https://purl.org/heals/eo#user> rdf:type owl:Class ;
                                 rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person> ;
                                 <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                 rdfs:comment "A person who consumes an explanation." ;
                                 rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                 rdfs:label "User" .


###  https://saref.etsi.org/core/UnitOfMeasure
<https://saref.etsi.org/core/UnitOfMeasure> rdf:type owl:Class ;
                                            owl:disjointWith <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                             <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                            rdfs:comment "The unit of measure is a standard for measurement of a quantity, such as a Property. For example,  Power is a property and Watt is a unit of power that represents a definite predetermined power: when we say 10 Watt, we actually mean 10 times the definite predetermined power called \\\"watt\\\". Our definition is based on the definition of unit of measure in the Ontology of units of Measure (OM). We propose here a list of some units of measure that are relevant for the purpose of SAREF, but this list can be extended, also using some other ontologies rather than the Ontology of units of Measure (OM)."@en ;
                                            rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
                                            rdfs:label "Unit of measure"@en .


###  https://saref.etsi.org/saref4ehaw/HealthDevice
<https://saref.etsi.org/saref4ehaw/HealthDevice> rdf:type owl:Class ;
                                                 rdfs:comment "Health devices, e.g. BAN hub, health sensor/actuator/Wereable."@en ;
                                                 rdfs:label "Health device"@en .


###  https://saref.etsi.org/saref4ehaw/HealthSensor
<https://saref.etsi.org/saref4ehaw/HealthSensor> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://www.w3.org/ns/sosa/Sensor> ,
                                                                 <https://saref.etsi.org/saref4ehaw/HealthDevice> ;
                                                 owl:disjointWith <https://saref.etsi.org/saref4ehaw/HealthWearable> ;
                                                 rdfs:comment "Health-related Sensor, sub-class of SAREF Sensor."@en ;
                                                 rdfs:label "Health sensor"@en .


###  https://saref.etsi.org/saref4ehaw/HealthWearable
<https://saref.etsi.org/saref4ehaw/HealthWearable> rdf:type owl:Class ;
                                                   rdfs:subClassOf <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                                   <https://saref.etsi.org/saref4wear/WearableDevice> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://saref.etsi.org/core/consistsOf> ;
                                                                     owl:someValuesFrom <https://saref.etsi.org/saref4ehaw/HealthSensor>
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://saref.etsi.org/saref4wear/isLocatedOn> ;
                                                                     owl:someValuesFrom <http://purl.org/phmo#MonitoredPerson>
                                                                   ] ;
                                                   rdfs:comment "Health-related Wearable, sub-class of SAREF4WEAR Wearable."@en ;
                                                   rdfs:label "Health wearable"@en .


###  https://saref.etsi.org/saref4wear/BiometricProperty
<https://saref.etsi.org/saref4wear/BiometricProperty> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.w3.org/ns/sosa/Property> ;
                                                      rdfs:comment "Class to group those properties related to the biometric characteristics of monitored individuals."@en ;
                                                      rdfs:label "Biometric property"@en .


###  https://saref.etsi.org/saref4wear/WearableDevice
<https://saref.etsi.org/saref4wear/WearableDevice> rdf:type owl:Class ;
                                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <https://saref.etsi.org/saref4wear/isLocatedOn> ;
                                                                     owl:someValuesFrom <http://purl.org/phmo#MonitoredPerson>
                                                                   ] ;
                                                   rdfs:comment "A wearable device is a device that is intended to be located near, on or in an organism."@en ;
                                                   rdfs:label "Wearable device"@en .


