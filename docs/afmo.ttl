###  http://purl.org/afmo#InterventionExplanation1
:InterventionExplanation1 rdf:type owl:NamedIndividual ,
                                   <https://purl.org/heals/eo#scientificExplanation> ;
                          <http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> :HealthIntervention2 ;
                          <http://purl.org/phmo#isConsumedBy> :DrChebet ;
                          <http://purl.org/phmo#hasText> "Alcoholism counselling was recommended for Atieno, with an expected utility of 50 as calculated by the Bayesian decision network. Its efficacy in reducing alcohol misuse is supported by a systematic review and meta-analysis (Jonas et al., 2012)." ;
                          <https://saref.etsi.org/core/hasTimestamp> "2026-09-21T14:30:00+03:00"^^xsd:dateTimeStamp ;
                          rdfs:comment "Example scientific explanation of the recommendation of alcoholism counselling for Atieno, provided to her clinician Dr Chebet." ;
                          rdfs:label "Intervention explanation 1" .


###  http://purl.org/afmo#InterventionExplanation2
:InterventionExplanation2 rdf:type owl:NamedIndividual ,
                                   <https://purl.org/heals/eo#scientificExplanation> ;
                          <http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> :HealthIntervention2 ;
                          <http://purl.org/phmo#isConsumedBy> :Atieno ;
                          <http://purl.org/phmo#hasText> "Dr Chebet has approved alcohol counselling for you. Studies show that counselling helps people reduce how much they drink, and drinking less lowers your risk of atrial fibrillation (AF)." ;
                          <https://saref.etsi.org/core/hasTimestamp> "2026-09-21T19:30:00+03:00"^^xsd:dateTimeStamp ;
                          rdfs:comment "Example scientific explanation of the recommendation of alcoholism counselling, provided to Atieno." ;
                          rdfs:label "Intervention explanation 2" .


###  http://purl.org/afmo#InterventionExplanation3
:InterventionExplanation3 rdf:type owl:NamedIndividual ,
                                   <https://purl.org/heals/eo#RationaleExplanation> ;
                          <http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> :HealthIntervention2 ;
                          <http://purl.org/phmo#isConsumedBy> :Bahati ;
                          <http://purl.org/phmo#hasText> "Alcohol counselling has been recommended for Atieno because her alcohol use is one of the reasons her risk of atrial fibrillation (AF) is raised. Dr Chebet has approved it, and your support in helping her attend the sessions can make a difference." ;
                          <https://saref.etsi.org/core/hasTimestamp> "2026-09-21T19:30:00+03:00"^^xsd:dateTimeStamp ;
                          rdfs:comment "Example rationale explanation of the recommendation of alcoholism counselling for Atieno, provided to her caregiver Bahati." ;
                          rdfs:label "Intervention explanation 3" .


