###  http://purl.org/afmo#hasRaceOrEthnicity
:hasRaceOrEthnicity rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://purl.org/phmo#hasRiskFactorStatus> ;
                    owl:inverseOf :isRaceOrEthnicityOf ;
                    rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                    rdfs:range :RaceOrEthnicity ;
                    rdfs:comment "The relationship between a monitored person and their race or ethnicity." ;
                    rdfs:label "has race or ethnicity" .


###  http://purl.org/afmo#hasSmokingStatus
:hasSmokingStatus rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://purl.org/phmo#hasRiskFactorStatus> ;
                  owl:inverseOf :isSmokingStatusOf ;
                  rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                  rdfs:range :SmokingStatus ;
                  rdfs:comment "The relationship between a monitored person and their smoking status." ;
                  rdfs:label "has smoking status" .


###  http://purl.org/afmo#isAgeGroupOf
:isAgeGroupOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf <http://purl.org/phmo#isRiskFactorStatusOf> ;
              rdfs:domain :AgeGroup ;
              rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
              rdfs:comment "The relationship between an age group and a person who belongs to it." ;
              rdfs:label "is age group of" .


###  http://purl.org/afmo#isAlcoholMisuseStatusOf
:isAlcoholMisuseStatusOf rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://purl.org/phmo#isRiskFactorStatusOf> ;
                         rdfs:domain :AlcoholMisuse ;
                         rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                         rdfs:comment "The relationship between an alcohol misuse status (present or absent) and a person who belongs to it." ;
                         rdfs:label "is alcohol misuse status of" .


###  http://purl.org/afmo#isECGFactorStatusOf
:isECGFactorStatusOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://purl.org/phmo#isRiskFactorStatusOf> ;
                     rdfs:domain :ECGFactor ;
                     rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                     rdfs:comment "The relationship between an ECG risk factor status and a monitored person." ;
                     rdfs:label "is ECG factor status of" .


###  http://purl.org/afmo#isHeightGroupOf
:isHeightGroupOf rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <http://purl.org/phmo#isRiskFactorStatusOf> ;
                 rdfs:domain :HeightGroup ;
                 rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                 rdfs:comment "The relationship between a height group and a monitored person who belongs to it." ;
                 rdfs:label "is height group of" .


###  http://purl.org/afmo#isOlderThan
:isOlderThan rdf:type owl:ObjectProperty ;
             owl:inverseOf :isYoungerThan ;
             rdf:type owl:TransitiveProperty ;
             rdfs:domain :AgeGroup ;
             rdfs:range :AgeGroup ;
             rdfs:comment "Transitive property to add order to the AgeGroup class." ;
             rdfs:label "is older than" .


