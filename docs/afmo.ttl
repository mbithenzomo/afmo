###  http://purl.org/afmo#isRRIntervalVariationStatusOf
:isRRIntervalVariationStatusOf rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf :isECGFactorStatusOf ;
                               rdfs:domain :RRIntervalVariation ;
                               rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                               rdfs:comment "The relationship between an RR interval variation status and a monitored person who has it." ;
                               rdfs:label "is RR interval variation status of" .


###  http://purl.org/afmo#isRaceOrEthnicityOf
:isRaceOrEthnicityOf rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf <http://purl.org/phmo#isRiskFactorStatusOf> ;
                     rdfs:domain :RaceOrEthnicity ;
                     rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                     rdfs:comment "The relationship between a race category and a person who belongs to it." ;
                     rdfs:label "is race or ethnicity of" .


###  http://purl.org/afmo#isSmokingStatusOf
:isSmokingStatusOf rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.org/phmo#isRiskFactorStatusOf> ;
                   rdfs:domain :SmokingStatus ;
                   rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                   rdfs:comment "The relationship between a current smoking status and a person who belongs to it." ;
                   rdfs:label "is smoking status of" .


###  http://purl.org/afmo#isYoungerThan
:isYoungerThan rdf:type owl:ObjectProperty ,
                        owl:TransitiveProperty ;
               rdfs:domain :AgeGroup ;
               rdfs:range :AgeGroup ;
               rdfs:comment "Transitive property to add order to the AgeGroup class." ;
               rdfs:label "is younger than" .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <http://purl.org/phmo#Publication> ;
                                   rdfs:range [ rdf:type owl:Class ;
                                                owl:unionOf ( <http://purl.org/phmo#Author>
                                                              <http://xmlns.com/foaf/0.1/Organization>
                                                            )
                                              ] .


###  http://purl.org/phmo#approvalStatusDeterminedByClinician
<http://purl.org/phmo#approvalStatusDeterminedByClinician> rdf:type owl:ObjectProperty ;
                                                           owl:inverseOf <http://purl.org/phmo#determinedApprovalStatusForIntervention> ;
                                                           rdfs:domain <http://purl.org/phmo#HealthIntervention> ;
                                                           rdfs:range <http://purl.org/phmo#Clinician> ;
                                                           rdfs:comment "The relationship between a health intervention and the clinician that determined its approval status." ;
                                                           rdfs:label "approval status determined by clinician" .


###  http://purl.org/phmo#calculatedExpectedUtilityForIntervention
<http://purl.org/phmo#calculatedExpectedUtilityForIntervention> rdf:type owl:ObjectProperty ;
                                                                owl:inverseOf <http://purl.org/phmo#expectedUtilityCalculatedByModel> ;
                                                                rdfs:domain <http://purl.org/phmo#BayesianDecisionNetwork> ;
                                                                rdfs:range <http://purl.org/phmo#HealthIntervention> ;
                                                                rdfs:comment "The relationship between a model (specifically a Bayesian decision network) and a health intervention whose expected utility it calculated." ;
                                                                rdfs:label "recommended intervention" .


###  http://purl.org/phmo#determinedApprovalStatusForIntervention
<http://purl.org/phmo#determinedApprovalStatusForIntervention> rdf:type owl:ObjectProperty ;
                                                               rdfs:domain <http://purl.org/phmo#Clinician> ;
                                                               rdfs:range <http://purl.org/phmo#HealthIntervention> ;
                                                               rdfs:comment "The relationship between a clinician and a health intervention that they approved, pre-approved, or rejected." ;
                                                               rdfs:label "determined approval status for intervention" .


###  http://purl.org/phmo#expectedUtilityCalculatedByModel
<http://purl.org/phmo#expectedUtilityCalculatedByModel> rdf:type owl:ObjectProperty ;
                                                        rdfs:domain <http://purl.org/phmo#HealthIntervention> ;
                                                        rdfs:range <http://purl.org/phmo#BayesianDecisionNetwork> ;
                                                        rdfs:comment "The relationship between a health intervention and the model (specifically a Bayesian decision network) that calculated its expected utility." ;
                                                        rdfs:label "expected utility calculated by model" .


###  http://purl.org/phmo#hasApprovalStatus
<http://purl.org/phmo#hasApprovalStatus> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <http://purl.org/phmo#isApprovalStatusOfIntervention> ;
                                         rdfs:domain <http://purl.org/phmo#HealthIntervention> ;
                                         rdfs:range <http://purl.org/phmo#ApprovalStatus> ;
                                         rdfs:comment "The relationship between a health intervention and its approval status (approved, pre-approved, rejected, or pending)." ;
                                         rdfs:label "has approval status" .


###  http://purl.org/phmo#hasBMICategory
<http://purl.org/phmo#hasBMICategory> rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf <http://purl.org/phmo#hasRiskFactorStatus> ;
                                      owl:inverseOf <http://purl.org/phmo#isBMICategoryOf> ;
                                      rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                                      rdfs:range <http://purl.org/phmo#BMICategory> ;
                                      rdfs:comment "The relationship between a monitored person and their BMI category." ;
                                      rdfs:label "has BMI category" .


###  http://purl.org/phmo#hasComorbidityStatus
<http://purl.org/phmo#hasComorbidityStatus> rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf <http://purl.org/phmo#hasRiskFactorStatus> ;
                                            owl:inverseOf <http://purl.org/phmo#isComorbidityStatusOf> ;
                                            rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                                            rdfs:range <http://purl.org/phmo#ComorbidityFactor> ;
                                            rdfs:comment "The relationship between a monitored person and a comorbidity risk factor status." ;
                                            rdfs:label "has comorbidity status" .


###  http://purl.org/phmo#hasEffectModifier
<http://purl.org/phmo#hasEffectModifier> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <http://purl.org/phmo#isEffectModifierInRelationship> ;
                                         rdfs:domain <http://purl.org/phmo#StateRiskRelationship> ;
                                         rdfs:range <http://purl.org/phmo#HealthRiskFactor> ;
                                         rdfs:comment "Links a health risk relationship to another risk factor state that modifies the risk associated with the relationship's primary risk factor state." ;
                                         rdfs:label "has effect modifier" .


###  http://purl.org/phmo#hasHigherBMIThan
<http://purl.org/phmo#hasHigherBMIThan> rdf:type owl:ObjectProperty ;
                                        owl:inverseOf <http://purl.org/phmo#hasLowerBMIThan> ;
                                        rdf:type owl:TransitiveProperty ;
                                        rdfs:domain <http://purl.org/phmo#BMICategory> ;
                                        rdfs:range <http://purl.org/phmo#BMICategory> ;
                                        rdfs:comment "Transitive property to add order to the BMICategory class." ;
                                        rdfs:label "has higher BMI than" .


###  http://purl.org/phmo#hasInputObservation
<http://purl.org/phmo#hasInputObservation> rdf:type owl:ObjectProperty ;
                                           owl:inverseOf <http://purl.org/phmo#isInputOfPrediction> ;
                                           rdfs:domain <http://purl.org/phmo#HealthEventPrediction> ;
                                           rdfs:range <http://purl.org/phmo#ContinuousObservation> ;
                                           rdfs:comment "The relationship between a health event prediction and the continuous observation used as input to the model that computes it." ;
                                           rdfs:label "has input observation" .


###  http://purl.org/phmo#hasInputRiskFactor
<http://purl.org/phmo#hasInputRiskFactor> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <http://purl.org/phmo#isInputRiskFactorOf> ;
                                          rdfs:domain <http://purl.org/phmo#Model> ;
                                          rdfs:range <http://purl.org/phmo#HealthRiskFactor> ;
                                          rdfs:comment "The relationship between a model and a risk factor it takes as input." ;
                                          rdfs:label "has input risk factor" .


###  http://purl.org/phmo#hasInputRiskFactorState
<http://purl.org/phmo#hasInputRiskFactorState> rdf:type owl:ObjectProperty ;
                                               owl:inverseOf <http://purl.org/phmo#isInputRiskFactorStateOf> ;
                                               rdfs:domain <http://purl.org/phmo#HealthRiskAssessment> ;
                                               rdfs:range <http://purl.org/phmo#HealthRiskFactor> ;
                                               rdfs:comment "The relationship between a health risk assessment and a risk factor state used as input to the model that computes it." ;
                                               rdfs:label "has input risk factor state" .


###  http://purl.org/phmo#hasLowerBMIThan
<http://purl.org/phmo#hasLowerBMIThan> rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf owl:topObjectProperty ;
                                       rdf:type owl:TransitiveProperty ;
                                       rdfs:domain <http://purl.org/phmo#BMICategory> ;
                                       rdfs:range <http://purl.org/phmo#BMICategory> ;
                                       rdfs:comment "Transitive property to add order to the BMICategory class." ;
                                       rdfs:label "has lower BMI than" .


###  http://purl.org/phmo#hasMedicalAction
<http://purl.org/phmo#hasMedicalAction> rdf:type owl:ObjectProperty ;
                                        owl:inverseOf <http://purl.org/phmo#isMedicalActionInIntervention> ;
                                        rdfs:domain <http://purl.org/phmo#HealthIntervention> ;
                                        rdfs:range <http://purl.obolibrary.org/obo/MAXO_0000001> ;
                                        rdfs:comment "The relationship between a health intervention and the medical action it involves." ;
                                        rdfs:label "has medical action" .


###  http://purl.org/phmo#hasPrediction
<http://purl.org/phmo#hasPrediction> rdf:type owl:ObjectProperty ;
                                     owl:inverseOf <http://purl.org/phmo#isPredictionOf> ;
                                     rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                                     rdfs:range <http://purl.org/phmo#HealthEventPrediction> ;
                                     rdfs:comment "The relationship betweena monitored person and a health event prediction." ;
                                     rdfs:label "has prediction" .


###  http://purl.org/phmo#hasPredictionStatus
<http://purl.org/phmo#hasPredictionStatus> rdf:type owl:ObjectProperty ;
                                           owl:inverseOf <http://purl.org/phmo#isPredictionStatusOf> ;
                                           rdfs:domain <http://purl.org/phmo#HealthEventPrediction> ;
                                           rdfs:range <http://purl.org/phmo#HealthEventPredictionStatus> ;
                                           rdfs:comment "The relationship between a health event prediction and its status (present or absent)." ;
                                           rdfs:label "has prediction status" .


###  http://purl.org/phmo#hasRecommendedIntervention
<http://purl.org/phmo#hasRecommendedIntervention> rdf:type owl:ObjectProperty ;
                                                  owl:inverseOf <http://purl.org/phmo#isRecommendedFor> ;
                                                  rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                                                  rdfs:range <http://purl.org/phmo#HealthIntervention> ;
                                                  rdfs:comment "The relationship between a monitored person and a health intervention that has been recommended for them." ;
                                                  rdfs:label "has recommended intervention" .


###  http://purl.org/phmo#hasResponseIntervention
<http://purl.org/phmo#hasResponseIntervention> rdf:type owl:ObjectProperty ;
                                               owl:inverseOf <http://purl.org/phmo#isInResponseTo> ;
                                               rdfs:domain [ rdf:type owl:Class ;
