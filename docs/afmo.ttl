                                     rdfs:range <http://purl.org/phmo#HealthRiskFactor> ;
                                     rdfs:comment "The link between a factor risk relationship and a risk factor." ;
                                     rdfs:label "has risk factor" .


###  http://purl.org/phmo#hasRiskFactorCategory
<http://purl.org/phmo#hasRiskFactorCategory> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <http://purl.org/phmo#isRiskFactorCategoryInRelationship> ;
