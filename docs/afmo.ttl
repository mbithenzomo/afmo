                                          rdfs:range <http://purl.org/phmo#HealthRiskFactor> ;
                                          rdfs:comment "The link between a state risk relationship and the risk factor state." ;
                                          rdfs:label "has risk factor state" .


###  http://purl.org/phmo#hasRiskFactorStatus
<http://purl.org/phmo#hasRiskFactorStatus> rdf:type owl:ObjectProperty ;
                                           owl:inverseOf <http://purl.org/phmo#isRiskFactorStatusOf> ;
                                           rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                                           rdfs:range <http://purl.org/phmo#HealthRiskFactor> ;
                                           rdfs:comment "The relationship between a monitored person and their status for a specific risk factor." ;
                                           rdfs:label "has risk factor status" .


###  http://purl.org/phmo#hasRiskOfCondition
<http://purl.org/phmo#hasRiskOfCondition> rdf:type owl:ObjectProperty ;
