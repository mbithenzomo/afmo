                              rdfs:range <http://purl.org/phmo#Sex> ;
                              rdfs:comment "The relationship between a monitored person and their sex." ;
                              rdfs:label "has sex" .


###  http://purl.org/phmo#isApprovalStatusOfIntervention
<http://purl.org/phmo#isApprovalStatusOfIntervention> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://purl.org/phmo#ApprovalStatus> ;
                                                      rdfs:range <http://purl.org/phmo#HealthIntervention> ;
