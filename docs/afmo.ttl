###  http://purl.org/afmo#AgeGroup
:AgeGroup rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:oneOf ( :Above74
                                            :Below60
                                            <http://purl.org/afmo#60-64>
                                            <http://purl.org/afmo#65-74>
                                          )
                              ] ;
          rdfs:subClassOf <http://purl.org/phmo#DemographicFactor> .


###  http://purl.org/afmo#AlcoholMisuse
:AlcoholMisuse rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( :AlcoholMisuseAbsent
                                                 :AlcoholMisusePresent
                                               )
                                   ] ;
               rdfs:subClassOf <http://purl.org/phmo#LifestyleFactor> .


###  http://purl.org/afmo#AtrialFibrillationEpisode
:AtrialFibrillationEpisode rdf:type owl:Class ;
                           rdfs:subClassOf <http://purl.org/phmo#HealthEvent> ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <http://purl.org/phmo#isHealthEventOfCondition> ;
                                             owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_0060224>
                                           ] .


###  http://purl.org/afmo#AtrialFibrillationEpisodePrediction
:AtrialFibrillationEpisodePrediction rdf:type owl:Class ;
                                     rdfs:subClassOf <http://purl.org/phmo#HealthEventPrediction> ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/phmo#isPredictionOfCondition> ;
                                                       owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_0060224>
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/phmo#isPredictionOfHealthEvent> ;
                                                       owl:allValuesFrom :AtrialFibrillationEpisode
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/phmo#wasPredictedByModel> ;
                                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onClass <http://purl.org/phmo#ArtificialNeuralNetwork>
                                                     ] ;
                                     rdfs:comment "A prediction of an upcoming episode in a monitored person." ;
                                     rdfs:label "Atrial fibrillation episode prediction" .


###  http://purl.org/afmo#AtrialFibrillationEpisodePredictionStatus
:AtrialFibrillationEpisodePredictionStatus rdf:type owl:Class ;
                                           owl:equivalentClass [ rdf:type owl:Class ;
                                                                 owl:oneOf ( :AFEpisodeAbsent
                                                                             :AFEpisodePresent
                                                                           )
                                                               ] ;
                                           rdfs:subClassOf <http://purl.org/phmo#HealthEventPredictionStatus> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/phmo#isPredictionStatusOf> ;
                                                             owl:someValuesFrom :AtrialFibrillationEpisodePrediction
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <http://purl.org/phmo#isPredictionStatusOfCondition> ;
                                                             owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_0060224>
                                                           ] ;
                                           rdfs:comment "AF episode prediction status in a monitored person (present or absent)." ;
                                           rdfs:label "Atrial fibrillation episode prediction status" .


###  http://purl.org/afmo#AtrialFibrillationRiskAssessment
:AtrialFibrillationRiskAssessment rdf:type owl:Class ;
                                  rdfs:subClassOf <http://purl.org/phmo#HealthRiskAssessment> ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://purl.org/phmo#isRiskAssessmentOfCondition> ;
                                                    owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_0060224>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://purl.org/phmo#wasAssessedByModel> ;
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass <http://purl.org/phmo#BayesianNetwork>
                                                  ] ;
                                  rdfs:comment "An assessment of AF risk in a monitored person." ;
                                  rdfs:label "Atrial fibrillation health risk assessment" .


###  http://purl.org/afmo#AtrialFibrillationRiskStatus
:AtrialFibrillationRiskStatus rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:oneOf ( :AFRiskAbsent
                                                                :AFRiskPresent
                                                              )
                                                  ] ;
                              rdfs:subClassOf <http://purl.org/phmo#HealthRiskStatus> ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <http://purl.org/phmo#isRiskStatusOf> ;
                                                owl:someValuesFrom :AtrialFibrillationRiskAssessment
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <http://purl.org/phmo#isRiskStatusOfCondition> ;
                                                owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_0060224>
                                              ] ;
                              rdfs:comment "AF risk status in a monitored person (present or absent)." ;
                              rdfs:label "Atrial fibrillation risk status" .


###  http://purl.org/afmo#COPDStatus
:COPDStatus rdf:type owl:Class ;
            owl:equivalentClass [ rdf:type owl:Class ;
                                  owl:oneOf ( :COPDAbsent
                                              :COPDPresent
                                            )
                                ] ;
            rdfs:subClassOf <http://purl.org/phmo#ComorbidityFactor> ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty <http://purl.org/phmo#isComorbidityStatusOfCondition> ;
                              owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_3083>
                            ] .


###  http://purl.org/afmo#CardiovascularDiseaseStatus
:CardiovascularDiseaseStatus rdf:type owl:Class ;
                             owl:equivalentClass [ rdf:type owl:Class ;
                                                   owl:oneOf ( :CardiovascularDiseaseAbsent
                                                               :CardiovascularDiseasePresent
                                                             )
                                                 ] ;
                             rdfs:subClassOf <http://purl.org/phmo#ComorbidityFactor> ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty <http://purl.org/phmo#isComorbidityStatusOfCondition> ;
                                               owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_1287>
                                             ] .


###  http://purl.org/afmo#DiabetesMellitusStatus
:DiabetesMellitusStatus rdf:type owl:Class ;
                        owl:equivalentClass [ rdf:type owl:Class ;
                                              owl:oneOf ( :DiabetesMellitusAbsent
                                                          :DiabetesMellitusPresent
                                                        )
                                            ] ;
                        rdfs:subClassOf <http://purl.org/phmo#ComorbidityFactor> ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty <http://purl.org/phmo#isComorbidityStatusOfCondition> ;
                                          owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_9351>
                                        ] .


###  http://purl.org/afmo#ECGDevice
:ECGDevice rdf:type owl:Class ;
           rdfs:subClassOf <https://saref.etsi.org/saref4ehaw/HealthWearable> ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty <https://saref.etsi.org/core/consistsOf> ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :ECGSensor
                           ] ;
           rdfs:comment "A wearable device equipped with an ECG sensor making it capable of taking an ECG." ;
           rdfs:label "ECG device" .


###  http://purl.org/afmo#ECGFactor
:ECGFactor rdf:type owl:Class ;
           rdfs:subClassOf <http://purl.org/phmo#HealthRiskFactor> ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty <http://purl.org/phmo#isDeterminedBy> ;
                             owl:someValuesFrom :ECGObservation
                           ] ;
           owl:disjointWith <http://purl.org/phmo#AnthropometricFactor> ,
                            <http://purl.org/phmo#ComorbidityFactor> ,
                            <http://purl.org/phmo#DemographicFactor> ,
                            <http://purl.org/phmo#LifestyleFactor> ;
           rdfs:comment "A class to group risk factors for atrial fribrillation related to a person's ECG characteristics." ;
           rdfs:label "ECG factor" .


###  http://purl.org/afmo#ECGObservation
:ECGObservation rdf:type owl:Class ;
                rdfs:subClassOf <http://purl.org/phmo#ContinuousObservation> ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://purl.org/phmo#isDeterminantOf> ;
                                  owl:someValuesFrom :ECGFactor
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://www.w3.org/ns/sosa/madeBySensor> ;
                                  owl:someValuesFrom :ECGSensor
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty <http://purl.org/phmo#hasSamplingFrequency> ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onDataRange xsd:integer
                                ] ;
                rdfs:comment "An electrocardiogram observation." ;
                rdfs:label "ECG observation" .


###  http://purl.org/afmo#ECGSensor
:ECGSensor rdf:type owl:Class ;
           rdfs:subClassOf <https://saref.etsi.org/saref4ehaw/HealthSensor> ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty <http://purl.org/phmo#isComponentOf> ;
                             owl:someValuesFrom :ECGDevice
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty <http://www.w3.org/ns/sosa/madeObservation> ;
                             owl:someValuesFrom :ECGObservation
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasLead ;
                             owl:someValuesFrom xsd:string
                           ] ;
           rdfs:comment "A sensor comprising two or more electrodes that record the electrical potential difference between electrode placements, corresponding to one ECG lead." ;
           rdfs:label "ECG sensor" .


###  http://purl.org/afmo#HeightGroup
:HeightGroup rdf:type owl:Class ;
             owl:equivalentClass [ rdf:type owl:Class ;
                                   owl:oneOf ( :Group1
                                               :Group2
                                               :Group3
                                               :Group4
                                               :Group5
                                             )
                                 ] ;
             rdfs:subClassOf <http://purl.org/phmo#AnthropometricFactor> ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty <http://purl.org/phmo#isDeterminedBy> ;
                               owl:someValuesFrom <http://purl.org/phmo#BodyHeightObservation>
                             ] .


###  http://purl.org/afmo#HypertensionStatus
:HypertensionStatus rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Class ;
                                          owl:oneOf ( :HypertensionAbsent
                                                      :HypertensionPresent
                                                    )
                                        ] ;
                    rdfs:subClassOf <http://purl.org/phmo#ComorbidityFactor> ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty <http://purl.org/phmo#isComorbidityStatusOfCondition> ;
                                      owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_10763>
                                    ] .


###  http://purl.org/afmo#KidneyDiseaseStatus
:KidneyDiseaseStatus rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( :KidneyDiseaseAbsent
                                                       :KidneyDiseasePresent
                                                     )
                                         ] ;
                     rdfs:subClassOf <http://purl.org/phmo#ComorbidityFactor> ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty <http://purl.org/phmo#isComorbidityStatusOfCondition> ;
                                       owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_557>
                                     ] .


###  http://purl.org/afmo#PRIntervalVariation
:PRIntervalVariation rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( :PRIntervalVariationAbsent
                                                       :PRIntervalVariationPresent
                                                     )
                                         ] ;
                     rdfs:subClassOf :ECGFactor .


###  http://purl.org/afmo#PWaveVariation
:PWaveVariation rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( :PWaveVariationAbsent
                                                  :PWaveVariationPresent
                                                )
                                    ] ;
                rdfs:subClassOf :ECGFactor .


###  http://purl.org/afmo#ProlongedPRInterval
:ProlongedPRInterval rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( :ProlongedPRIntervalAbsent
                                                       :ProlongedPRIntervalPresent
                                                     )
                                         ] ;
                     rdfs:subClassOf :ECGFactor .


###  http://purl.org/afmo#ProlongedPWave
:ProlongedPWave rdf:type owl:Class ;
                owl:equivalentClass [ rdf:type owl:Class ;
                                      owl:oneOf ( :ProlongedPWaveAbsent
                                                  :ProlongedPWavePresent
                                                )
                                    ] ;
                rdfs:subClassOf :ECGFactor .


###  http://purl.org/afmo#ProlongedRRInterval
:ProlongedRRInterval rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( :ProlongedRRIntervalAbsent
                                                       :ProlongedRRIntervalPresent
                                                     )
                                         ] ;
                     rdfs:subClassOf :ECGFactor .


###  http://purl.org/afmo#RRIntervalVariation
:RRIntervalVariation rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( :RRIntervalVariationAbsent
                                                       :RRIntervalVariationPresent
                                                     )
                                         ] ;
                     rdfs:subClassOf :ECGFactor .


###  http://purl.org/afmo#RaceOrEthnicity
:RaceOrEthnicity rdf:type owl:Class ;
                 rdfs:subClassOf <http://purl.org/phmo#DemographicFactor> .


###  http://purl.org/afmo#SleepApnoeaStatus
:SleepApnoeaStatus rdf:type owl:Class ;
                   owl:equivalentClass [ rdf:type owl:Class ;
                                         owl:oneOf ( :SleepApnoeaAbsent
                                                     :SleepApnoeaPresent
                                                   )
                                       ] ;
                   rdfs:subClassOf <http://purl.org/phmo#ComorbidityFactor> ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty <http://purl.org/phmo#isComorbidityStatusOfCondition> ;
                                     owl:allValuesFrom <http://purl.obolibrary.org/obo/DOID_0050847>
                                   ] .


###  http://purl.org/afmo#SmokingStatus
:SmokingStatus rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:oneOf ( :Nonsmoker
                                                 :Smoker
                                               )
                                   ] ;
               rdfs:subClassOf <http://purl.org/phmo#LifestyleFactor> .


###  http://purl.org/phmo#AnthropometricFactor
<http://purl.org/phmo#AnthropometricFactor> rdf:type owl:Class ;
                                            rdfs:subClassOf <http://purl.org/phmo#HealthRiskFactor> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/phmo#isDeterminedBy> ;
                                                              owl:someValuesFrom <http://purl.org/phmo#DiscreteObservation>
                                                            ] ;
                                            owl:disjointWith <http://purl.org/phmo#ComorbidityFactor> ,
                                                             <http://purl.org/phmo#DemographicFactor> ,
                                                             <http://purl.org/phmo#LifestyleFactor> .


###  http://purl.org/phmo#AnthropometricProperty
<http://purl.org/phmo#AnthropometricProperty> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.w3.org/ns/sosa/Property> ;
                                              owl:disjointWith <https://saref.etsi.org/saref4wear/BiometricProperty> ;
                                              rdfs:comment "Class to group those properties related to the body measurements of monitored individuals." ;
                                              rdfs:label "Anthropometric property" .


###  http://purl.org/phmo#ApprovalStatus
<http://purl.org/phmo#ApprovalStatus> rdf:type owl:Class ;
                                      owl:equivalentClass [ rdf:type owl:Class ;
                                                            owl:oneOf ( <http://purl.org/phmo#Approved>
                                                                        <http://purl.org/phmo#Pending>
                                                                        <http://purl.org/phmo#Pre-approved>
                                                                        <http://purl.org/phmo#Rejected>
                                                                      )
                                                          ] ;
                                      owl:disjointWith <http://purl.org/phmo#HealthEvent> ,
                                                       <http://purl.org/phmo#HealthEventPrediction> ,
                                                       <http://purl.org/phmo#HealthEventPredictionStatus> ,
                                                       <http://purl.org/phmo#HealthIntervention> ,
                                                       <http://purl.org/phmo#HealthRiskAssessment> ,
                                                       <http://purl.org/phmo#HealthRiskFactor> ,
                                                       <http://purl.org/phmo#HealthRiskRelationship> ,
                                                       <http://purl.org/phmo#HealthRiskStatus> ,
                                                       <http://purl.org/phmo#MedicalCondition> ,
                                                       <http://purl.org/phmo#Model> ,
                                                       <http://purl.org/phmo#Publication> ,
                                                       <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                       <http://www.w3.org/ns/sosa/Observation> ,
                                                       <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                       <http://www.w3.org/ns/sosa/Property> ,
                                                       <http://www.w3.org/ns/sosa/Sensor> ,
                                                       <http://xmlns.com/foaf/0.1/Agent> ,
                                                       <https://purl.org/heals/eo#SystemRecommendation> ,
                                                       <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                       <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                       <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                      rdfs:comment "The approval status of a health intervention as determined by a clinician." ;
                                      rdfs:label "Approval status" .


###  http://purl.org/phmo#ArtificialNeuralNetwork
<http://purl.org/phmo#ArtificialNeuralNetwork> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://purl.org/phmo#Model> ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://purl.org/phmo#madeEventPrediction> ;
                                                                 owl:someValuesFrom :AtrialFibrillationEpisodePrediction
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://purl.org/phmo#hasInputType> ;
                                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                 owl:onDataRange xsd:string
                                                               ] ;
                                               <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Deep learning model" ;
                                               rdfs:comment "A neural network is a machine learning model that stacks simple \"neurons\" in layers and learns pattern-recognizing weights and biases from data to map inputs to outputs." ;
                                               rdfs:label "Artificial neural network" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.org/phmo#ArtificialNeuralNetwork> ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "A neural network is a machine learning model that stacks simple \"neurons\" in layers and learns pattern-recognizing weights and biases from data to map inputs to outputs." ;
   rdfs:isDefinedBy "\"What is a neural network?\", IBM Think, by Fangfang Lee. https://www.ibm.com/think/topics/neural-networks#741977106, accessed 10 July 2026."
 ] .


###  http://purl.org/phmo#Author
<http://purl.org/phmo#Author> rdf:type owl:Class ;
                              rdfs:subClassOf <http://xmlns.com/foaf/0.1/Person> ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <http://purl.org/phmo#isCreatorOf> ;
                                                owl:someValuesFrom <http://purl.org/phmo#Publication>
                                              ] ;
                              owl:disjointWith <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                              rdfs:comment "The author of a publication." ;
                              rdfs:label "Author" .


###  http://purl.org/phmo#BMICategory
<http://purl.org/phmo#BMICategory> rdf:type owl:Class ;
                                   owl:equivalentClass [ rdf:type owl:Class ;
                                                         owl:oneOf ( <http://purl.org/phmo#Normal>
                                                                     <http://purl.org/phmo#ObeseI>
                                                                     <http://purl.org/phmo#ObeseII>
                                                                     <http://purl.org/phmo#ObeseIII>
                                                                     <http://purl.org/phmo#Overweight>
                                                                     <http://purl.org/phmo#Underweight>
                                                                   )
                                                       ] ;
                                   rdfs:subClassOf <http://purl.org/phmo#AnthropometricFactor> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/phmo#isDeterminedBy> ;
                                                     owl:someValuesFrom <http://purl.org/phmo#BodyHeightObservation>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/phmo#isDeterminedBy> ;
                                                     owl:someValuesFrom <http://purl.org/phmo#BodyWeightObservation>
                                                   ] .


###  http://purl.org/phmo#BayesianDecisionNetwork
<http://purl.org/phmo#BayesianDecisionNetwork> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://purl.org/phmo#Model> ;
                                               rdfs:comment "A Bayesian network extended with decision and utility nodes, used to compare the expected utility of alternative decisions, such as health interventions." ;
                                               rdfs:label "Bayesian decision network" .


###  http://purl.org/phmo#BayesianNetwork
<http://purl.org/phmo#BayesianNetwork> rdf:type owl:Class ;
                                       rdfs:subClassOf <http://purl.org/phmo#Model> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#hasInputRiskFactor> ;
                                                         owl:someValuesFrom <http://purl.org/phmo#HealthRiskFactor>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <http://purl.org/phmo#madeRiskAssessment> ;
                                                         owl:someValuesFrom :AtrialFibrillationRiskAssessment
                                                       ] ;
                                       rdfs:comment "Bayesian networks are a type of Probabilistic Graphical Model that can be used to build models from data and/or expert opinion. They can be used for a wide range of tasks including diagnostics, reasoning, causal modeling, decision making under uncertainty, anomaly detection, automated insight and prediction." ;
                                       rdfs:label "Bayesian network" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.org/phmo#BayesianNetwork> ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Bayesian networks are a type of Probabilistic Graphical Model that can be used to build models from data and/or expert opinion. They can be used for a wide range of tasks including diagnostics, reasoning, causal modeling, decision making under uncertainty, anomaly detection, automated insight and prediction." ;
   rdfs:isDefinedBy "Bayes Server Learning Center: https://www.bayesserver.com/docs/introduction/bayesian-networks/, accessed 10 July 2026."
 ] .


###  http://purl.org/phmo#Biosignal
<http://purl.org/phmo#Biosignal> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://saref.etsi.org/saref4wear/BiometricProperty> ;
                                 owl:disjointWith <http://purl.org/phmo#VitalSign> ;
                                 <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "Biological signal" ;
                                 rdfs:comment "Biological signals, or biosignals, are space, time, or space-time records of a biological event such as a beating heart or a contracting muscle." ;
                                 rdfs:label "Biosignal" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.org/phmo#Biosignal> ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Biological signals, or biosignals, are space, time, or space-time records of a biological event such as a beating heart or a contracting muscle." ;
   rdfs:isDefinedBy "M. Escabí, “Biosignal Processing,” in Introduction to Biomedical Engineering, ch. 11, pp. 667–746, Elsevier Inc., 3 ed., 2012. https://doi.org/10.1016/B978-0-12-374979-6.00011-3"
 ] .


###  http://purl.org/phmo#BodyHeightObservation
<http://purl.org/phmo#BodyHeightObservation> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.org/phmo#DiscreteObservation> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#isDeterminantOf> ;
                                                               owl:someValuesFrom :HeightGroup
                                                             ] ;
                                             rdfs:comment "A monitored person's height as determined by a measuring tape or a mechanical height machine." ;
                                             rdfs:label "Body height observation" .


###  http://purl.org/phmo#BodyWeightObservation
<http://purl.org/phmo#BodyWeightObservation> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.org/phmo#DiscreteObservation> ;
                                             rdfs:comment "A monitored person's observed body weight as measured on a body weight scale." ;
                                             rdfs:label "Body weight observation" .


###  http://purl.org/phmo#BodyWeightScale
<http://purl.org/phmo#BodyWeightScale> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://saref.etsi.org/saref4ehaw/HealthSensor> ;
                                       rdfs:comment "A scale to measure body weight." ;
                                       rdfs:label "Body weight scale" .


###  http://purl.org/phmo#Caregiver
<http://purl.org/phmo#Caregiver> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://purl.org/heals/eo#user> ;
                                 owl:disjointWith <http://purl.org/phmo#Clinician> ,
                                                  <http://purl.org/phmo#MonitoredPerson> ,
                                                  <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                 rdfs:comment "A caregiver of a monitored person." ;
                                 rdfs:label "Caregiver" .


###  http://purl.org/phmo#CategoryRiskRelationship
<http://purl.org/phmo#CategoryRiskRelationship> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.org/phmo#HealthRiskRelationship> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.org/phmo#hasRiskFactorCategory> ;
                                                                  owl:someValuesFrom <http://purl.org/phmo#HealthRiskFactor>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.org/phmo#hasCategoryWeight> ;
                                                                  owl:someValuesFrom xsd:decimal
                                                                ] ;
                                                owl:disjointWith <http://purl.org/phmo#FactorRiskRelationship> ,
                                                                 <http://purl.org/phmo#StateRiskRelationship> ;
                                                rdfs:comment "The relationship between a risk factor category and a medical condition." ;
                                                rdfs:label "Category risk relationship" .


###  http://purl.org/phmo#ClinicalRiskScore
<http://purl.org/phmo#ClinicalRiskScore> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                         rdfs:comment "Risk scores provide a systematic and quantifiable assessment of the likelihood of health outcomes based on risk factors, allowing clinicians to stratify individuals into risk categories." ;
                                         rdfs:label "Clinical risk score" .


###  http://purl.org/phmo#Clinician
<http://purl.org/phmo#Clinician> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://purl.org/heals/eo#user> ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <http://purl.org/phmo#determinedApprovalStatusForIntervention> ;
                                                   owl:someValuesFrom <http://purl.org/phmo#HealthIntervention>
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <http://purl.org/phmo#isClinicianOf> ;
                                                   owl:someValuesFrom <http://purl.org/phmo#MonitoredPerson>
                                                 ] ;
                                 owl:disjointWith <http://purl.org/phmo#MonitoredPerson> ,
                                                  <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                 rdfs:comment "A clinician of a monitored person." ;
                                 rdfs:label "Clinician" .


###  http://purl.org/phmo#ComorbidityFactor
<http://purl.org/phmo#ComorbidityFactor> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://purl.org/phmo#HealthRiskFactor> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <http://purl.org/phmo#isComorbidityStatusOfCondition> ;
                                                           owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                           owl:onClass <http://purl.org/phmo#MedicalCondition>
                                                         ] ;
                                         owl:disjointWith <http://purl.org/phmo#DemographicFactor> ,
                                                          <http://purl.org/phmo#LifestyleFactor> ,
                                                          <http://purl.org/phmo#MedicalCondition> ;
                                         rdfs:comment "A class to group comorbidity risk factors, i.e. the simultaneous presence of a medical condition co-occurring with atrial fibrillation."@en ;
                                         rdfs:label "Comorbidity factor" .


###  http://purl.org/phmo#ContinuousObservation
<http://purl.org/phmo#ContinuousObservation> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasDuration> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onDataRange xsd:duration
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://www.w3.org/ns/sosa/endTime> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onDataRange xsd:dateTimeStamp
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://www.w3.org/ns/sosa/startTime> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onDataRange xsd:dateTimeStamp
                                                             ] ;
                                             rdfs:comment "An observation of a property made over a series of time. Also known as a time series observation." ;
                                             rdfs:label "Continuous observation" .


###  http://purl.org/phmo#DemographicFactor
<http://purl.org/phmo#DemographicFactor> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://purl.org/phmo#HealthRiskFactor> ;
                                         owl:disjointWith <http://purl.org/phmo#LifestyleFactor> .


###  http://purl.org/phmo#DiscreteObservation
<http://purl.org/phmo#DiscreteObservation> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.w3.org/ns/sosa/Observation> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://saref.etsi.org/core/hasTimestamp> ;
                                                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                             owl:onDataRange xsd:dateTimeStamp
                                                           ] ;
                                           rdfs:comment "An observation made at a particular instant in time." ;
                                           rdfs:label "Discrete observation" .


###  http://purl.org/phmo#FactorRiskRelationship
<http://purl.org/phmo#FactorRiskRelationship> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://purl.org/phmo#HealthRiskRelationship> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://purl.org/phmo#hasRiskFactor> ;
                                                                owl:someValuesFrom <http://purl.org/phmo#HealthRiskFactor>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://purl.org/phmo#hasFactorWeight> ;
                                                                owl:someValuesFrom xsd:decimal
                                                              ] ;
                                              owl:disjointWith <http://purl.org/phmo#StateRiskRelationship> ;
                                              rdfs:comment "The relationship between a risk factor and a medical condition." ;
                                              rdfs:label "Factor risk relationship" .


###  http://purl.org/phmo#HealthEvent
<http://purl.org/phmo#HealthEvent> rdf:type owl:Class ;
                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/phmo#isHealthEventOfCondition> ;
