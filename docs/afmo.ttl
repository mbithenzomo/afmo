                                       rdfs:comment "The relationship between an observation and a risk factor.  E.g. a BMI observation is a determinant of the BMI category." ;
                                       rdfs:label "is determinant of" .


###  http://purl.org/phmo#isDeterminedBy
<http://purl.org/phmo#isDeterminedBy> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://purl.org/phmo#HealthRiskFactor> ;
                                      rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                      rdfs:comment "The relationship between a risk factor and an observation that is determined by it. E.g. BMI category is determined by a BMI observation." ;
                                      rdfs:label "is determined by" .


###  http://purl.org/phmo#isEffectModifierInRelationship
<http://purl.org/phmo#isEffectModifierInRelationship> rdf:type owl:ObjectProperty ;
                                                      rdfs:domain <http://purl.org/phmo#HealthRiskFactor> ;
                                                      rdfs:range <http://purl.org/phmo#StateRiskRelationship> ;
                                                      rdfs:comment "Links a risk factor state to a health risk relationship whose associated risk it modifies." ;
                                                      rdfs:label "is effect modifier in relationship" .


###  http://purl.org/phmo#isEvidenceFor
<http://purl.org/phmo#isEvidenceFor> rdf:type owl:ObjectProperty ;
                                     owl:inverseOf <http://purl.org/phmo#isEvidencedBy> ;
                                     rdfs:domain <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                     rdfs:range [ rdf:type owl:Class ;
                                                  owl:unionOf ( <http://purl.org/phmo#HealthIntervention>
                                                                <http://purl.org/phmo#HealthRiskRelationship>
                                                              )
                                                ] ;
                                     rdfs:comment "The relationship between supporting evidence and a health risk relationship or health intervention." ;
                                     rdfs:label "is evidence for" .


###  http://purl.org/phmo#isEvidencedBy
<http://purl.org/phmo#isEvidencedBy> rdf:type owl:ObjectProperty ;
                                     rdfs:domain [ rdf:type owl:Class ;
                                                   owl:unionOf ( <http://purl.org/phmo#HealthIntervention>
                                                                 <http://purl.org/phmo#HealthRiskRelationship>
                                                               )
                                                 ] ;
                                     rdfs:range <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                     rdfs:comment "The relationship between a health risk relationship or health intervention and the  evidence that supports it." ;
                                     rdfs:label "is evidenced by" .


###  http://purl.org/phmo#isHealthEventInPrediction
<http://purl.org/phmo#isHealthEventInPrediction> rdf:type owl:ObjectProperty ;
                                                 owl:inverseOf <http://purl.org/phmo#isPredictionOfHealthEvent> ;
                                                 rdfs:domain <http://purl.org/phmo#HealthEvent> ;
                                                 rdfs:range <http://purl.org/phmo#HealthEventPrediction> ;
                                                 rdfs:comment "The relationship between a health event and a health event prediction" ;
                                                 rdfs:label "is health event in prediction" .


###  http://purl.org/phmo#isHealthEventOfCondition
<http://purl.org/phmo#isHealthEventOfCondition> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://purl.org/phmo#HealthEvent> ;
                                                rdfs:range <http://purl.org/phmo#MedicalCondition> ;
                                                rdfs:comment "The relationship between a health event and a medical condition." ;
                                                rdfs:label "is health event of condition" .


###  http://purl.org/phmo#isInResponseTo
<http://purl.org/phmo#isInResponseTo> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://purl.org/phmo#HealthIntervention> ;
                                      rdfs:range [ rdf:type owl:Class ;
                                                   owl:unionOf ( <http://purl.org/phmo#HealthEventPrediction>
                                                                 <http://purl.org/phmo#HealthRiskAssessment>
                                                               )
                                                 ] ;
                                      rdfs:comment "The relationship between a health intervention and the health risk assessment or health event prediction that it responds to." ;
                                      rdfs:label "is in response to" .


###  http://purl.org/phmo#isInputOfPrediction
<http://purl.org/phmo#isInputOfPrediction> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://purl.org/phmo#ContinuousObservation> ;
                                           rdfs:range <http://purl.org/phmo#HealthEventPrediction> ;
                                           rdfs:comment "The relationship between a continuous observation and a health event prediction for which it was the input." ;
                                           rdfs:label "is input of prediction" .


###  http://purl.org/phmo#isInputRiskFactorOf
<http://purl.org/phmo#isInputRiskFactorOf> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://purl.org/phmo#HealthRiskFactor> ;
                                           rdfs:range <http://purl.org/phmo#Model> ;
                                           rdfs:comment "The relationship between a risk factor and a model that takes it as input." ;
                                           rdfs:label "is input risk factor of" .


###  http://purl.org/phmo#isInputRiskFactorStateOf
<http://purl.org/phmo#isInputRiskFactorStateOf> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://purl.org/phmo#HealthRiskFactor> ;
                                                rdfs:range <http://purl.org/phmo#HealthRiskAssessment> ;
                                                rdfs:comment "The relationship between a risk factor state and a health risk assessment for which it was an input." ;
                                                rdfs:label "is input risk factor state of" .


###  http://purl.org/phmo#isMedicalActionInIntervention
<http://purl.org/phmo#isMedicalActionInIntervention> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.obolibrary.org/obo/MAXO_0000001> ;
                                                     rdfs:range <http://purl.org/phmo#HealthIntervention> ;
                                                     rdfs:comment "The relationship between a medical action and a health intervention that involves it." ;
                                                     rdfs:label "is medical action in intervention" .


###  http://purl.org/phmo#isPatientOf
<http://purl.org/phmo#isPatientOf> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                                   rdfs:range <http://purl.org/phmo#Clinician> ;
                                   rdfs:comment "The relationship between a monitored person and their clinician." ;
                                   rdfs:label "is patient of" .


###  http://purl.org/phmo#isPredictionOf
<http://purl.org/phmo#isPredictionOf> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://purl.org/phmo#HealthEventPrediction> ;
                                      rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                                      rdfs:comment "The relationship between a prediction of a health event and the monitored person for whom the event is predicted to occur." ;
                                      rdfs:label "is prediction of" .


###  http://purl.org/phmo#isPredictionOfCondition
<http://purl.org/phmo#isPredictionOfCondition> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://purl.org/phmo#HealthEventPrediction> ;
                                               rdfs:range <http://purl.org/phmo#MedicalCondition> ;
                                               rdfs:comment "The relationship between a health event prediction and the medical condition it is associated with." ;
                                               rdfs:label "is prediction of condition" .


###  http://purl.org/phmo#isPredictionOfHealthEvent
<http://purl.org/phmo#isPredictionOfHealthEvent> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://purl.org/phmo#HealthEventPrediction> ;
                                                 rdfs:range <http://purl.org/phmo#HealthEvent> ;
                                                 rdfs:comment "The relationship between a health event prediction and the health event it predicts, e.g. an AF episode." ;
                                                 rdfs:label "is prediction of health event" .


###  http://purl.org/phmo#isPredictionStatusOf
<http://purl.org/phmo#isPredictionStatusOf> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://purl.org/phmo#HealthEventPredictionStatus> ;
                                            rdfs:range <http://purl.org/phmo#HealthEventPrediction> ;
                                            rdfs:comment "The relationship between a health event prediction status (present or absent) and a health event prediction." ;
                                            rdfs:label "is prediction status of" .


###  http://purl.org/phmo#isPredictionStatusOfCondition
<http://purl.org/phmo#isPredictionStatusOfCondition> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://purl.org/phmo#HealthEventPredictionStatus> ;
                                                     rdfs:range <http://purl.org/phmo#MedicalCondition> ;
                                                     rdfs:comment "The relationship between a health event prediction status (i.e. present or absent) and a medical condition." ;
                                                     rdfs:label "is prediction status of condition" .


###  http://purl.org/phmo#isPublicationOf
<http://purl.org/phmo#isPublicationOf> rdf:type owl:ObjectProperty ;
                                       owl:inverseOf <http://purl.org/phmo#isPublishedAs> ;
                                       rdfs:domain <http://purl.org/phmo#Publication> ;
                                       rdfs:range <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                       rdfs:comment "The relationship between a publication and the work (evidence) that is expressed within it." ;
                                       rdfs:label "is publication of" .


###  http://purl.org/phmo#isPublishedAs
<http://purl.org/phmo#isPublishedAs> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://purl.obolibrary.org/obo/ECO_0000000> ;
                                     rdfs:range <http://purl.org/phmo#Publication> ;
                                     rdfs:comment "The relationship between evidence and the publication that reports it." ;
                                     rdfs:label "is published as" .


###  http://purl.org/phmo#isRecommendedFor
<http://purl.org/phmo#isRecommendedFor> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://purl.org/phmo#HealthIntervention> ;
                                        rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                                        rdfs:comment "The relationship between a health intervention and the monitored person for whom it is recommended." ;
                                        rdfs:label "is recommended for" .


###  http://purl.org/phmo#isRiskAssessmentOf
<http://purl.org/phmo#isRiskAssessmentOf> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://purl.org/phmo#HealthRiskAssessment> ;
                                          rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                                          rdfs:comment "The relationship between a health risk assessment and the monitored person it assesses." ;
                                          rdfs:label "is risk assessment of" .


###  http://purl.org/phmo#isRiskAssessmentOfCondition
<http://purl.org/phmo#isRiskAssessmentOfCondition> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://purl.org/phmo#HealthRiskAssessment> ;
                                                   rdfs:range <http://purl.org/phmo#MedicalCondition> ;
                                                   rdfs:comment "The relationship between a health risk assessment and the medical condition it assesses." ;
                                                   rdfs:label "is risk assessment of condition" .


###  http://purl.org/phmo#isRiskFactorCategoryInRelationship
<http://purl.org/phmo#isRiskFactorCategoryInRelationship> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <http://purl.org/phmo#HealthRiskFactor> ;
                                                          rdfs:range <http://purl.org/phmo#CategoryRiskRelationship> ;
                                                          rdfs:comment "The link between a risk factor category and a category risk relationship." ;
                                                          rdfs:label "is risk factor category in relationship" .


###  http://purl.org/phmo#isRiskFactorInRelationship
<http://purl.org/phmo#isRiskFactorInRelationship> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://purl.org/phmo#HealthRiskFactor> ;
                                                  rdfs:range <http://purl.org/phmo#FactorRiskRelationship> ;
                                                  rdfs:comment "The link between a risk factor and a factor risk relationship." ;
                                                  rdfs:label "is risk factor in relationship" .


###  http://purl.org/phmo#isRiskFactorStateInRelationship
<http://purl.org/phmo#isRiskFactorStateInRelationship> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <http://purl.org/phmo#HealthRiskFactor> ;
                                                       rdfs:range <http://purl.org/phmo#StateRiskRelationship> ;
                                                       rdfs:comment "The link between a risk factor state and a state risk relationship." ;
                                                       rdfs:label "is risk factor state in relationship" .


###  http://purl.org/phmo#isRiskFactorStatusOf
<http://purl.org/phmo#isRiskFactorStatusOf> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://purl.org/phmo#HealthRiskFactor> ;
                                            rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                                            rdfs:comment "A generalised relationship between a risk factor and a monitored person." ;
                                            rdfs:label "is risk factor status of" .


###  http://purl.org/phmo#isRiskStatusOf
<http://purl.org/phmo#isRiskStatusOf> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://purl.org/phmo#HealthRiskStatus> ;
                                      rdfs:range <http://purl.org/phmo#HealthRiskAssessment> ;
                                      rdfs:comment "The relationship between a risk status (present or absent) and a health risk assessment." ;
                                      rdfs:label "is risk status of" .


###  http://purl.org/phmo#isRiskStatusOfCondition
<http://purl.org/phmo#isRiskStatusOfCondition> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://purl.org/phmo#HealthRiskStatus> ;
                                               rdfs:range <http://purl.org/phmo#MedicalCondition> ;
                                               rdfs:comment "The relationship between a risk status in a monitored individual (i.e. present or absent) and a medical condition." ;
                                               rdfs:label "is risk status of condition" .


###  http://purl.org/phmo#isSexOf
<http://purl.org/phmo#isSexOf> rdf:type owl:ObjectProperty ;
                               rdfs:subPropertyOf <http://purl.org/phmo#isRiskFactorStatusOf> ;
                               rdfs:domain <http://purl.org/phmo#Sex> ;
                               rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                               rdfs:comment "The relationship between a sex category and a person who belongs to it." ;
                               rdfs:label "is sex of" .


###  http://purl.org/phmo#isUnitOfMeasureOf
<http://purl.org/phmo#isUnitOfMeasureOf> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <https://saref.etsi.org/core/isMeasuredIn> ;
                                         rdfs:domain <https://saref.etsi.org/core/UnitOfMeasure> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                         rdfs:comment "The relationship between a unit of measure and a measurement." ;
                                         rdfs:label "is unit of measure of" .


###  http://purl.org/phmo#madeEventPrediction
<http://purl.org/phmo#madeEventPrediction> rdf:type owl:ObjectProperty ;
                                           owl:inverseOf <http://purl.org/phmo#wasPredictedByModel> ;
                                           rdfs:domain <http://purl.org/phmo#Model> ;
                                           rdfs:range <http://purl.org/phmo#HealthEventPrediction> ;
                                           rdfs:comment "The relationship between a model and a health event prediction that it made." ;
                                           rdfs:label "made event prediction" .


###  http://purl.org/phmo#madeRiskAssessment
<http://purl.org/phmo#madeRiskAssessment> rdf:type owl:ObjectProperty ;
                                          owl:inverseOf <http://purl.org/phmo#wasAssessedByModel> ;
                                          rdfs:domain <http://purl.org/phmo#Model> ;
                                          rdfs:range <http://purl.org/phmo#HealthRiskAssessment> ;
                                          rdfs:comment "The relationship between a model and a health risk assessment that it made." ;
                                          rdfs:label "made risk assessment" .


###  http://purl.org/phmo#wasAssessedByModel
<http://purl.org/phmo#wasAssessedByModel> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://purl.org/phmo#HealthRiskAssessment> ;
                                          rdfs:range <http://purl.org/phmo#Model> ;
                                          rdfs:comment "The relationship between a health risk assessment and the model that made it." ;
                                          rdfs:label "was assessed by model" .


###  http://purl.org/phmo#wasPredictedByModel
<http://purl.org/phmo#wasPredictedByModel> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://purl.org/phmo#HealthEventPrediction> ;
                                           rdfs:range <http://purl.org/phmo#Model> ;
                                           rdfs:comment "The relationship between a health event prediction and the model that made it." ;
                                           rdfs:label "was predicted by model" .


###  http://purl.org/phmo#wasTestDataFor
<http://purl.org/phmo#wasTestDataFor> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <http://purl.org/phmo#wasTestedOn> ;
                                      rdfs:domain <http://www.w3.org/ns/dcat#Dataset> ;
                                      rdfs:range <http://purl.org/phmo#Model> ;
                                      rdfs:comment "The relationship between a dataset and a model whose performance was evaluated on it." ;
                                      rdfs:label "was test data for" .


###  http://purl.org/phmo#wasTestedOn
<http://purl.org/phmo#wasTestedOn> rdf:type owl:ObjectProperty ;
                                   rdfs:domain <http://purl.org/phmo#Model> ;
                                   rdfs:range <http://www.w3.org/ns/dcat#Dataset> ;
                                   rdfs:comment "The relationship between a model and a dataset on which its performance was evaluated." ;
                                   rdfs:label "was tested on" .


###  http://purl.org/phmo#wasTrainedOn
<http://purl.org/phmo#wasTrainedOn> rdf:type owl:ObjectProperty ;
                                    owl:inverseOf <http://purl.org/phmo#wasTrainingDataFor> ;
                                    rdfs:domain <http://purl.org/phmo#Model> ;
                                    rdfs:range <http://www.w3.org/ns/dcat#Dataset> ;
                                    rdfs:comment "The relationship between a model and a dataset from which it was constructed or trained." ;
                                    rdfs:label "was trained on" .


###  http://purl.org/phmo#wasTrainingDataFor
<http://purl.org/phmo#wasTrainingDataFor> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://www.w3.org/ns/dcat#Dataset> ;
                                          rdfs:range <http://purl.org/phmo#Model> ;
                                          rdfs:comment "The relationship between a dataset and a model that was constructed or trained from it." ;
                                          rdfs:label "was training data for" .


###  http://purl.org/phmo#wearsDevice
<http://purl.org/phmo#wearsDevice> rdf:type owl:ObjectProperty ;
                                   owl:inverseOf <https://saref.etsi.org/saref4wear/isLocatedOn> ;
                                   rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                                   rdfs:range <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                   rdfs:comment "The relationship between a person and the wearable device that is located on them." ;
                                   rdfs:label "wears device" .


###  http://purl.org/vocab/frbr/core#part
<http://purl.org/vocab/frbr/core#part> rdf:type owl:ObjectProperty ;
                                       owl:inverseOf <http://purl.org/vocab/frbr/core#partOf> ;
                                       rdf:type owl:TransitiveProperty ;
                                       rdfs:domain <http://purl.org/phmo#Publication> ;
                                       rdfs:range <http://purl.org/phmo#Publication> ;
                                       <http://purl.org/vocab/vann/example> """
        :my-journal-issue a fabio:JournalIssue ;
            frbr:part :my-journal-article .
        """ ;
                                       rdfs:comment "A part of an endeavour."@en ,
                                                    "A property indicating that one entity includes another entity."@en ;
                                       rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                       rdfs:label "has part"@en ;
                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en ;
                                       <http://www.w3.org/2008/05/skos#note> "Unlike the FRBR version in RDF http://vocab.org/frbr/core.html the present version defines partonomy relationships transitive."@en .


###  http://purl.org/vocab/frbr/core#partOf
<http://purl.org/vocab/frbr/core#partOf> rdf:type owl:ObjectProperty ,
                                                  owl:TransitiveProperty ;
                                         rdfs:domain <http://purl.org/phmo#Publication> ;
                                         rdfs:range <http://purl.org/phmo#Publication> ;
                                         <http://purl.org/vocab/vann/example> """
        :my-journal-article a fabio:JournalArticle ;
            frbr:partOf :my-journal-issue .
    """ ;
                                         rdfs:comment "A property indicating that one entity is a part of another entity."@en ,
                                                      "An endeavour incorporating another endeavour."@en ;
                                         rdfs:isDefinedBy <http://purl.org/spar/fabio> ;
                                         rdfs:label "is part of"@en ;
                                         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en ;
                                         <http://www.w3.org/2008/05/skos#note> "Unlike the FRBR version in RDF http://vocab.org/frbr/core.html the present version defines partonomy relationships transitive."@en .


###  http://www.w3.org/ns/sosa/hasFeatureOfInterest
<http://www.w3.org/ns/sosa/hasFeatureOfInterest> rdf:type owl:ObjectProperty ;
                                                 owl:inverseOf <http://www.w3.org/ns/sosa/isFeatureOfInterestOf> ;
                                                 rdfs:domain [ rdf:type owl:Class ;
                                                               owl:unionOf ( <http://www.w3.org/ns/sosa/Observation>
                                                                             <http://www.w3.org/ns/sosa/ObservationCollection>
                                                                           )
                                                             ] ;
                                                 rdfs:range <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                 <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Deployment> ,
                                                                                    <http://www.w3.org/ns/sosa/Execution> ,
                                                                                    <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                                    <http://www.w3.org/ns/sosa/Observation> ,
                                                                                    <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                                 <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                 rdfs:comment "relation from an Execution or Deployment to its subject entity i.e., from an Actuation to the entity whose property was modified; from an Observation to the entity whose quality was observed; from an act of Sampling to the entity that was sampled; or from a Deployment to its target" ;
                                                 rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                                 rdfs:label "has feature of interest"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> """
  relation from an Execution or Deployment to its subject entity

  i.e., from an Actuation to the entity whose property was modified;
  from an Observation to the entity whose quality was observed;
  from an act of Sampling to the entity that was sampled;
  or from a Deployment to its target
  """@en ;
                                                 <http://www.w3.org/2004/02/skos/core#example> "For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight."@en ;
                                                 <http://www.w3.org/2004/02/skos/core#scopeNote> "This is the _proximate_ feature of interest, which may be a proxy entity such as a sample of the _ultimate_ feature of interest. Use `hasUltimateFeatureOfInterest` if the intention is to link to the _ultimate_ feature of interest. " .


###  http://www.w3.org/ns/sosa/hasMember
<http://www.w3.org/ns/sosa/hasMember> rdf:type owl:ObjectProperty ;
                                      owl:inverseOf <http://www.w3.org/ns/sosa/isMemberOf> ;
                                      rdfs:domain <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                      rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                      <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                         <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                      <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Execution> ,
                                                                        <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                        <http://www.w3.org/ns/sosa/Observation> ,
                                                                        <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                      rdfs:comment "link from a Collection to an Execution or Sample or Collection of these that is part of it" ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                      rdfs:label "has member of collection" ;
                                      <http://www.w3.org/2004/02/skos/core#definition> """
  link from a Collection to an Execution or Sample or Collection of these that is part of it
  """ ;
                                      <http://www.w3.org/2004/02/skos/core#editorialNote> "Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types" ;
                                      <http://www.w3.org/2004/02/skos/core#scopeNote> "rules for the consistency of values of properties of collections and properties of their members are given for each collection type" .


###  http://www.w3.org/ns/sosa/hasProperty
<http://www.w3.org/ns/sosa/hasProperty> rdf:type owl:ObjectProperty ;
                                        owl:inverseOf <http://www.w3.org/ns/sosa/isPropertyOf> ;
                                        rdfs:domain <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                        rdfs:range <http://www.w3.org/ns/sosa/Property> ;
                                        <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                        rdfs:comment "relation from an entity to a Property of that entity" ;
                                        rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                        rdfs:label "has property"@en ;
                                        <http://www.w3.org/2004/02/skos/core#definition> """
  relation from an entity to a Property of that entity
  """@en .


###  http://www.w3.org/ns/sosa/isFeatureOfInterestOf
<http://www.w3.org/ns/sosa/isFeatureOfInterestOf> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                  rdfs:range [ rdf:type owl:Class ;
                                                               owl:unionOf ( <http://www.w3.org/ns/sosa/Observation>
                                                                             <http://www.w3.org/ns/sosa/ObservationCollection>
                                                                           )
                                                             ] ;
                                                  <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                                  <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Deployment> ,
                                                                                    <http://www.w3.org/ns/sosa/Execution> ,
                                                                                    <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                                    <http://www.w3.org/ns/sosa/Observation> ,
                                                                                    <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                                  rdfs:comment "relation from a FeatureOfInterest to an Execution, Execution Collection, or Deployment, operating on it i.e., to an Observation about it, to an Actuation acting on it, to an act of Sampling that sampled it, or to a Deployment for which it is the subject." ;
                                                  rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                                  rdfs:label "is feature of interest of"@en ;
                                                  <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a FeatureOfInterest to an Execution, Execution Collection, or Deployment, operating on it

  i.e., to an Observation about it, to an Actuation acting on it, to an act of Sampling that sampled it,
  or to a Deployment for which it is the subject.
"""@en .


###  http://www.w3.org/ns/sosa/isMemberOf
<http://www.w3.org/ns/sosa/isMemberOf> rdf:type owl:ObjectProperty ;
                                       rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                       rdfs:range <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                       <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Execution> ,
                                                                          <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                          <http://www.w3.org/ns/sosa/Observation> ,
                                                                          <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                       <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                         <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                       rdfs:comment "link from an Execution or Sample or Collection of these, to a collection that it is part of" ;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                       rdfs:label "is member of collection" ;
                                       <http://www.w3.org/2004/02/skos/core#definition> """
  link from an Execution or Sample or Collection of these, to a collection that it is part of
  """ ;
                                       <http://www.w3.org/2004/02/skos/core#editorialNote> "Note that there is a single `member` property. OWL or SHACL constraints may limit the range depending on the context of different collection types" ;
                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "rules for the consistency of values of properties of collections and properties of their members are given for each collection type" .


###  http://www.w3.org/ns/sosa/isObservedBy
<http://www.w3.org/ns/sosa/isObservedBy> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <http://www.w3.org/ns/sosa/observes> ;
                                         rdfs:domain <http://www.w3.org/ns/sosa/Property> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/Sensor> ;
                                         <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                         rdfs:comment "Relation between an ObservableProperty and the Sensor able to observe it."@en ;
                                         rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                          <http://www.w3.org/ns/sosa/obs/> ;
                                         rdfs:label "is observed by"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Property to a Sensor that is able to observe it
  """@en ,
                                                                                          "Relation between an ObservableProperty and the Sensor able to observe it."@en .


###  http://www.w3.org/ns/sosa/isPropertyOf
<http://www.w3.org/ns/sosa/isPropertyOf> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://www.w3.org/ns/sosa/Property> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/FeatureOfInterest> ;
                                         <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                         rdfs:comment "relation from a Property to a FeatureOfInterest that it is a quality of" ;
                                         rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                         rdfs:label "is property of"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Property to a FeatureOfInterest that it is a quality of
  """@en .


###  http://www.w3.org/ns/sosa/madeBySensor
<http://www.w3.org/ns/sosa/madeBySensor> rdf:type owl:ObjectProperty ;
                                         owl:inverseOf <http://www.w3.org/ns/sosa/madeObservation> ;
                                         rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                         rdfs:range <http://www.w3.org/ns/sosa/Sensor> ;
                                         <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Observation> ,
                                                                            <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                         <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Sensor> ;
                                         rdfs:comment "Relation between an Observation and the Sensor which made the Observation."@en ;
                                         rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                          <http://www.w3.org/ns/sosa/obs/> ;
                                         rdfs:label "made by sensor"@en ,
                                                    "made by sensor or observer"@en ;
                                         <http://www.w3.org/2004/02/skos/core#definition> """
  relation from an Observation or ObservationCollection to the Sensor involved
  """@en ,
                                                                                          "Relation between an Observation and the Sensor which made the Observation."@en .


###  http://www.w3.org/ns/sosa/madeObservation
<http://www.w3.org/ns/sosa/madeObservation> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://www.w3.org/ns/sosa/Sensor> ;
                                            rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                            <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Sensor> ;
                                            <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Observation> ,
                                                                              <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                            rdfs:comment "Relation between a Sensor and an Observation made by the Sensor."@en ;
                                            rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                             <http://www.w3.org/ns/sosa/obs/> ;
                                            rdfs:label "made observation"@en ;
                                            <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Sensor to an Observation or ObservationCollection it has made
  """@en ,
                                                                                             "Relation between a Sensor and an Observation made by the Sensor."@en .


###  http://www.w3.org/ns/sosa/observedProperty
<http://www.w3.org/ns/sosa/observedProperty> rdf:type owl:ObjectProperty ;
                                             owl:inverseOf <http://www.w3.org/ns/sosa/wasObservedBy> ;
                                             rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                             rdfs:range <http://www.w3.org/ns/sosa/Property> ;
                                             <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Observation> ,
                                                                                <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                             <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                             rdfs:comment "relation from an Observation or ObservationCollection to the property observed" ;
                                             rdfs:isDefinedBy <http://www.w3.org/ns/sosa/obs/> ;
                                             rdfs:label "observed property"@en ;
                                             <http://www.w3.org/2004/02/skos/core#definition> """
  relation from an Observation or ObservationCollection to the property observed
  """@en ;
                                             <http://www.w3.org/2004/02/skos/core#note> """
  'observed property' covers the concepts referred to in [VIM] as 'measurand' (quantitative values) and 'examinand' (categorical and nominal values — [VIM4]), as well as complex and structured properties whose values may be represented as lists, vectors, arrays, rasters, geometries, etc. More specific terms are used in other contexts for related concepts, such as 'analyte' (chemistry) and 'determinand' (water quality).
  """@en .


###  http://www.w3.org/ns/sosa/observes
<http://www.w3.org/ns/sosa/observes> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://www.w3.org/ns/sosa/Sensor> ;
                                     rdfs:range <http://www.w3.org/ns/sosa/Property> ;
                                     <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                     rdfs:comment "Relation between a Sensor and an ObservableProperty that it is capable of sensing."@en ;
                                     rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ,
                                                      <http://www.w3.org/ns/sosa/obs/> ;
                                     rdfs:label "observes"@en ;
                                     <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Sensor to a Property that it is capable of sensing
  """@en ,
                                                                                      "Relation between a Sensor and an ObservableProperty that it is capable of sensing."@en .


###  http://www.w3.org/ns/sosa/wasObservedBy
<http://www.w3.org/ns/sosa/wasObservedBy> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://www.w3.org/ns/sosa/Property> ;
                                          rdfs:range <http://www.w3.org/ns/sosa/Observation> ;
                                          <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Property> ;
                                          <http://schema.org/rangeIncludes> <http://www.w3.org/ns/sosa/Observation> ,
                                                                            <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                          rdfs:comment "relation from a Property to an Observation that observed it" ;
                                          rdfs:isDefinedBy <http://www.w3.org/ns/sosa/obs/> ;
                                          rdfs:label "was observed by"@en ;
                                          <http://www.w3.org/2004/02/skos/core#definition> """
  relation from a Property to an Observation that observed it
  """@en .


###  https://purl.org/heals/eo#consumes
<https://purl.org/heals/eo#consumes> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <https://purl.org/heals/eo#user> ;
                                     rdfs:range <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                     <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                     rdfs:comment "The relationship between a user and an explanation they consume. The domain, range and inverse are added in AFMO." ;
                                     rdfs:isDefinedBy <https://purl.org/heals/eo> ;
                                     rdfs:label "is consumer of" .


###  https://saref.etsi.org/core/consistsOf
<https://saref.etsi.org/core/consistsOf> rdf:type owl:ObjectProperty ;
                                         rdfs:domain [ rdf:type owl:Class ;
                                                       owl:unionOf ( <https://saref.etsi.org/saref4ehaw/HealthDevice>
                                                                     <https://saref.etsi.org/saref4ehaw/HealthWearable>
                                                                   )
                                                     ] ;
                                         rdfs:range <https://saref.etsi.org/saref4ehaw/HealthSensor> ;
                                         rdfs:comment "A relationship indicating a composite entity that consists of other entities (e.g., a temperature/humidity sensor that consists of a temperature sensor and a humidity sensor)"@en ;
                                         rdfs:label "consists of"@en ;
                                         <http://www.w3.org/2004/02/skos/core#historyNote> "V3.2.1: Add local restrictions on consistsOf on feature of interest"@en .


###  https://saref.etsi.org/core/isMeasuredIn
<https://saref.etsi.org/core/isMeasuredIn> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                                           rdfs:range <https://saref.etsi.org/core/UnitOfMeasure> ;
                                           rdfs:comment "A relationship identifying the unit of measure used for a certain entity."@en ;
                                           rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
                                           rdfs:label "is measured in"@en .


###  https://saref.etsi.org/saref4wear/isLocatedOn
<https://saref.etsi.org/saref4wear/isLocatedOn> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                                rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                                                rdfs:comment "The relationship between a wearable device and the person it is located on." ;
                                                rdfs:label "is located on" .


#################################################################
#    Data properties
#################################################################

###  http://prismstandard.org/namespaces/basic/2.0/doi
<http://prismstandard.org/namespaces/basic/2.0/doi> rdf:type owl:DatatypeProperty ;
                                                    rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                                    rdf:type owl:FunctionalProperty ;
                                                    rdfs:domain <http://purl.org/phmo#Publication> ;
                                                    rdfs:range xsd:string ;
                                                    rdfs:comment "A Digital Object Identifier for a serial publication item, a dataset or some other entity."@en ;
                                                    rdfs:isDefinedBy <http://www.doi.org/> ;
                                                    rdfs:label "has DOI"@en .


###  http://prismstandard.org/namespaces/basic/2.0/edition
<http://prismstandard.org/namespaces/basic/2.0/edition> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <http://purl.org/phmo#Publication> ;
                                                        rdfs:range xsd:positiveInteger ;
                                                        rdfs:comment "An identifier for one of several alternative issues of a magazine, a book or other resource."@en ;
                                                        rdfs:label "has edition"@en .


###  http://prismstandard.org/namespaces/basic/2.0/endingPage
<http://prismstandard.org/namespaces/basic/2.0/endingPage> rdf:type owl:DatatypeProperty ;
                                                           rdfs:subPropertyOf owl:topDataProperty ;
                                                           rdf:type owl:FunctionalProperty ;
                                                           rdfs:domain <http://purl.org/phmo#Publication> ;
                                                           rdfs:range xsd:int ;
                                                           <http://purl.org/vocab/vann/example> """
        :my-print-object a fabio:PrintObject ;
            prism:endingPage '186' .
    """ ;
                                                           rdfs:comment "A property used to identify the last page of an entity such as a journal article."@en ;
                                                           rdfs:isDefinedBy <http://prismstandard.org/namespaces/basic/2.0> ;
                                                           rdfs:label "has ending page"@en ;
                                                           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://prismstandard.org/namespaces/basic/2.0/isbn
<http://prismstandard.org/namespaces/basic/2.0/isbn> rdf:type owl:DatatypeProperty ;
                                                     rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                                     rdf:type owl:FunctionalProperty ;
                                                     rdfs:domain <http://purl.org/phmo#Publication> ;
                                                     rdfs:range xsd:string ;
                                                     rdfs:comment "The International Standard Book Number, ISBN, used to identify published books or, more rarely, journal issues."@en ;
                                                     rdfs:label "has ISBN"@en .


###  http://prismstandard.org/namespaces/basic/2.0/issueIdentifier
<http://prismstandard.org/namespaces/basic/2.0/issueIdentifier> rdf:type owl:DatatypeProperty ;
                                                                rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                                                rdfs:domain <http://purl.org/spar/fabio/JournalIssue> ;
                                                                rdfs:range xsd:int ;
                                                                rdfs:comment "A system generated unique publisher identifier for the issue of a serial publication.   The issue identifies should not be confused with the \"special\" issue name element, prism:issueName." ;
                                                                rdfs:isDefinedBy "http://prismstandard.org/namespaces/basic/2.0/issueIdentifier" ;
                                                                rdfs:label "has issue identifier" .


###  http://prismstandard.org/namespaces/basic/2.0/pageRange
<http://prismstandard.org/namespaces/basic/2.0/pageRange> rdf:type owl:DatatypeProperty ;
                                                          rdfs:subPropertyOf owl:topDataProperty ;
                                                          rdf:type owl:FunctionalProperty ;
                                                          rdfs:domain <http://purl.org/phmo#Publication> ;
                                                          rdfs:range xsd:string ;
                                                          <http://purl.org/vocab/vann/example> """
        :my-journal-article a fabio:JournalArticle ;
            prism:pageRange '145-162' .
    """ ;
                                                          rdfs:comment "A property used to identify the page range of an entity such as a journal article."@en ,
                                                                       "Identifies the page range of an entity such as a journal article."@en ;
                                                          rdfs:isDefinedBy <http://prismstandard.org/namespaces/basic/2.0> ;
                                                          rdfs:label "has page range"@en ;
                                                          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://prismstandard.org/namespaces/basic/2.0/startingPage
<http://prismstandard.org/namespaces/basic/2.0/startingPage> rdf:type owl:DatatypeProperty ;
                                                             rdfs:subPropertyOf owl:topDataProperty ;
                                                             rdf:type owl:FunctionalProperty ;
                                                             rdfs:domain <http://purl.org/phmo#Publication> ;
                                                             rdfs:range xsd:int ;
                                                             <http://purl.org/vocab/vann/example> """
        :my-print-object a fabio:PrintObject ;
            prism:startingPage '171' .
    """ ;
                                                             rdfs:comment "A property used to identify the first page of an entity such as a journal article."@en ;
                                                             rdfs:isDefinedBy <http://prismstandard.org/namespaces/basic/2.0> ;
                                                             rdfs:label "has starting page"@en ;
                                                             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en .


###  http://prismstandard.org/namespaces/basic/2.0/volume
<http://prismstandard.org/namespaces/basic/2.0/volume> rdf:type owl:DatatypeProperty ;
                                                       rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                                       rdf:type owl:FunctionalProperty ;
                                                       rdfs:domain <http://purl.org/spar/fabio/JournalVolume> ;
                                                       rdfs:range xsd:int ;
                                                       <http://purl.org/vocab/vann/example> """
        :my-journal-volume a fabio:JournalVolume ;
            prism:volume '15' .
    """ ;
                                                       rdfs:comment "An identifier for a particular volume of a resource."@en ;
                                                       rdfs:isDefinedBy <http://prismstandard.org/namespaces/basic/2.0> ;
                                                       rdfs:label "has volume identifier"@en ;
                                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#scopeNote> "Examples include a journal or a multi-volume book."@en .


###  http://purl.org/afmo#hasLead
:hasLead rdf:type owl:DatatypeProperty ;
         rdfs:domain :ECGSensor ;
         rdfs:range [ rdf:type rdfs:Datatype ;
                      owl:oneOf [ rdf:type rdf:List ;
                                  rdf:first "I" ;
                                  rdf:rest [ rdf:type rdf:List ;
                                             rdf:first "II" ;
                                             rdf:rest [ rdf:type rdf:List ;
                                                        rdf:first "III" ;
                                                        rdf:rest [ rdf:type rdf:List ;
                                                                   rdf:first "V1" ;
                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                              rdf:first "V2" ;
                                                                              rdf:rest [ rdf:type rdf:List ;
                                                                                         rdf:first "V3" ;
                                                                                         rdf:rest [ rdf:type rdf:List ;
                                                                                                    rdf:first "V4" ;
                                                                                                    rdf:rest [ rdf:type rdf:List ;
                                                                                                               rdf:first "V5" ;
                                                                                                               rdf:rest [ rdf:type rdf:List ;
                                                                                                                          rdf:first "V6" ;
                                                                                                                          rdf:rest [ rdf:type rdf:List ;
                                                                                                                                     rdf:first "aVF" ;
                                                                                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                rdf:first "aVL" ;
                                                                                                                                                rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                           rdf:first "aVR" ;
                                                                                                                                                           rdf:rest rdf:nil
                                                                                                                                                         ]
                                                                                                                                              ]
                                                                                                                                   ]
                                                                                                                        ]
                                                                                                             ]
                                                                                                  ]
                                                                                       ]
                                                                            ]
                                                                 ]
                                                      ]
                                           ]
                                ]
                    ] ;
         rdfs:comment "The lead that an ECG measurement has. Leads are also known as channels. The AFMO currently only supports single-lead ECG." ;
         rdfs:label "has lead" .


###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( <http://purl.org/phmo#Publication>
                                                                  <http://www.w3.org/ns/sosa/Observation>
                                                                  <http://xmlns.com/foaf/0.1/Person>
                                                                )
                                                  ] ;
                                      rdfs:range [ rdf:type rdfs:Datatype ;
                                                   owl:unionOf ( xsd:anyURI
                                                                 xsd:int
                                                                 xsd:string
                                                               )
                                                 ] ;
                                      rdfs:comment """A unique and unambiguous reference to the resource within a given context.

Recommended best practice is to identify the resource by means of a string conforming to a formal identification system."""@en ;
                                      rdfs:label "has identifier"@en .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <http://purl.org/phmo#Publication> ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "A name given to a resource.  Typically, the title will be the name by which the resource is formally known."@en ;
                                 rdfs:label "title"@en .


###  http://purl.org/phmo#hasAUPRC
<http://purl.org/phmo#hasAUPRC> rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf <http://purl.org/phmo#hasPerformanceMetric> ;
                                rdfs:domain <http://purl.org/phmo#Model> ;
                                rdfs:range xsd:float ;
                                rdfs:comment "The area under the precision-recall curve of a model." ;
                                rdfs:label "has AUPRC" .


###  http://purl.org/phmo#hasAUROC
<http://purl.org/phmo#hasAUROC> rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf <http://purl.org/phmo#hasPerformanceMetric> ;
                                rdfs:domain <http://purl.org/phmo#Model> ;
                                rdfs:range xsd:float ;
                                rdfs:comment "The area under the receiver operating characteristic curve of a model." ;
                                rdfs:label "has AUROC" .


###  http://purl.org/phmo#hasAge
<http://purl.org/phmo#hasAge> rdf:type owl:DatatypeProperty ;
                              rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                              rdfs:range xsd:integer ;
                              rdfs:comment "A person's age in years." ;
                              rdfs:label "has age" .


###  http://purl.org/phmo#hasApprovalStatusTimestamp
<http://purl.org/phmo#hasApprovalStatusTimestamp> rdf:type owl:DatatypeProperty ;
                                                  rdfs:subPropertyOf <https://saref.etsi.org/core/hasTimestamp> ;
                                                  rdfs:domain <http://purl.org/phmo#HealthIntervention> ;
                                                  rdfs:range xsd:dateTimeStamp ;
                                                  rdfs:comment "The timestamp at which a health intervention's approval status was determined by a clinician. In the case of the default approval status (i.e. \"pending\"), the value is the same as the recommendation timestamp." ;
                                                  rdfs:label "has approval status timestamp" .


###  http://purl.org/phmo#hasBMI
<http://purl.org/phmo#hasBMI> rdf:type owl:DatatypeProperty ;
                              rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                              rdfs:range xsd:decimal ;
                              rdfs:comment "A monitored person's body mass index as computed from their most recent height and weight observations." ;
                              rdfs:label "has BMI" .


###  http://purl.org/phmo#hasBrierScore
<http://purl.org/phmo#hasBrierScore> rdf:type owl:DatatypeProperty ;
                                     rdfs:subPropertyOf <http://purl.org/phmo#hasPerformanceMetric> ;
                                     rdfs:domain <http://purl.org/phmo#Model> ;
                                     rdfs:range xsd:float ;
                                     rdfs:comment "The Brier score of a model, i.e. the mean squared difference between its predicted probabilities and the observed outcomes." ;
                                     rdfs:label "has Brier Score" .


###  http://purl.org/phmo#hasCategoryWeight
<http://purl.org/phmo#hasCategoryWeight> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <http://purl.org/phmo#CategoryRiskRelationship> ;
                                         rdfs:range xsd:decimal ;
                                         rdfs:comment "Category weight represents how much influence a risk factor category has on the risk of the condition relative to the other categories." ;
                                         rdfs:label "has category weight" .


###  http://purl.org/phmo#hasDataStoreURI
<http://purl.org/phmo#hasDataStoreURI> rdf:type owl:DatatypeProperty ;
                                       rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                       rdfs:domain <http://purl.org/phmo#ContinuousObservation> ;
                                       rdfs:range xsd:anyURI ;
                                       rdfs:comment "Link to external data store where raw time series data is stored." ;
                                       rdfs:label "has data store URI" .


###  http://purl.org/phmo#hasDateOfConfirmation
<http://purl.org/phmo#hasDateOfConfirmation> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <http://purl.org/phmo#HealthRiskFactor> ;
                                             rdfs:range xsd:date ;
                                             rdfs:comment "The date on which personal data was last confirmed and/or updated." ;
                                             rdfs:label "has date of confirmation" .


###  http://purl.org/phmo#hasDecisionThreshold
<http://purl.org/phmo#hasDecisionThreshold> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <http://purl.org/phmo#Model> ;
                                            rdfs:range xsd:float ;
                                            rdfs:comment "The probability at or above which a model assigns the positive status, e.g. AF risk present or AF episode present." ;
                                            rdfs:label "has decision threshold" .


###  http://purl.org/phmo#hasDuration
<http://purl.org/phmo#hasDuration> rdf:type owl:DatatypeProperty ;
                                   rdfs:domain <http://purl.org/phmo#ContinuousObservation> ;
                                   rdfs:range xsd:duration ;
                                   rdfs:comment "The duration of a continuous observation." ;
                                   rdfs:label "has duration" .


###  http://purl.org/phmo#hasExpectedCalibrationError
<http://purl.org/phmo#hasExpectedCalibrationError> rdf:type owl:DatatypeProperty ;
                                                   rdfs:subPropertyOf <http://purl.org/phmo#hasPerformanceMetric> ;
                                                   rdfs:domain <http://purl.org/phmo#Model> ;
                                                   rdfs:range xsd:float ;
                                                   rdfs:comment "The expected calibration error of a model, i.e. the weighted average difference between its predicted probabilities and the observed event frequencies across probability bins." ;
                                                   rdfs:label "has expected calibration error" .


###  http://purl.org/phmo#hasExpectedUtility
<http://purl.org/phmo#hasExpectedUtility> rdf:type owl:DatatypeProperty ;
                                          rdfs:domain <http://purl.org/phmo#HealthIntervention> ;
                                          rdfs:range xsd:float ;
                                          rdfs:comment "The expected utility of a health intervention as computed by a Bayesian decision network." ;
                                          rdfs:label "has expected utility" .


###  http://purl.org/phmo#hasF1Score
<http://purl.org/phmo#hasF1Score> rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf <http://purl.org/phmo#hasPerformanceMetric> ;
                                  rdfs:domain <http://purl.org/phmo#Model> ;
                                  rdfs:range xsd:float ;
                                  <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "has F-measure" ,
                                                                                                 "has F-score" ;
                                  rdfs:comment "The F1 score of a model, i.e. the harmonic mean of its precision and recall at its decision threshold." ;
                                  rdfs:label "has F1 Score" .


###  http://purl.org/phmo#hasFactorWeight
<http://purl.org/phmo#hasFactorWeight> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://purl.org/phmo#FactorRiskRelationship> ;
                                       rdfs:range xsd:decimal ;
                                       rdfs:comment "Factor weight represents how much influence a risk factor has on the risk of the condition relative to the other risk factors in the same category." ;
                                       rdfs:label "has factor weight" .


###  http://purl.org/phmo#hasICD10Block
<http://purl.org/phmo#hasICD10Block> rdf:type owl:DatatypeProperty ;
                                     rdfs:domain <http://purl.org/phmo#MedicalCondition> ;
                                     rdfs:range xsd:string ;
                                     rdfs:comment "ICD10 block associated with a medical condition." ;
                                     rdfs:label "has ICD10 block" .


###  http://purl.org/phmo#hasICD10Code
<http://purl.org/phmo#hasICD10Code> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <http://purl.org/phmo#MedicalCondition> ;
                                    rdfs:range xsd:string ;
                                    rdfs:comment "ICD10 code associated with a medical condition." ;
                                    rdfs:label "has ICD10 code" .


###  http://purl.org/phmo#hasIDNumber
<http://purl.org/phmo#hasIDNumber> rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf <http://purl.org/dc/terms/identifier> ;
                                   rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "Unique identifier for a monitored person, such as a national ID number." ;
                                   rdfs:label "has ID number" .


###  http://purl.org/phmo#hasInputType
<http://purl.org/phmo#hasInputType> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <http://purl.org/phmo#ArtificialNeuralNetwork> ;
                                    rdfs:range [ rdf:type rdfs:Datatype ;
                                                 owl:oneOf [ rdf:type rdf:List ;
                                                             rdf:first "ECG" ;
                                                             rdf:rest [ rdf:type rdf:List ;
                                                                        rdf:first "RR interval" ;
                                                                        rdf:rest rdf:nil
                                                                      ]
                                                           ]
                                               ] ;
                                    rdfs:comment "The type of input signal a model takes: the raw ECG or the RR interval series derived from it." ;
                                    rdfs:label "has input type" .


###  http://purl.org/phmo#hasInputWindow
<http://purl.org/phmo#hasInputWindow> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://purl.org/phmo#HealthEventPrediction> ;
                                      rdfs:range xsd:duration ;
                                      rdfs:comment "The duration of the continuous observation used as input to compute a health event prediction." ;
                                      rdfs:label "has input window" .


###  http://purl.org/phmo#hasPerformanceMetric
<http://purl.org/phmo#hasPerformanceMetric> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <http://purl.org/phmo#Model> ;
                                            rdfs:range xsd:float ;
                                            rdfs:comment "A measure of the performance of a model, evaluated on a test dataset." ;
                                            rdfs:label "has performance metric" .


###  http://purl.org/phmo#hasPredictionHorizon
<http://purl.org/phmo#hasPredictionHorizon> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <http://purl.org/phmo#HealthEventPrediction> ;
                                            rdfs:range xsd:duration ;
                                            rdfs:comment "How far ahead a health event prediction is made, i.e. the duration between the end of the input window and the start of the target window." ;
                                            rdfs:label "has prediction horizon" .


###  http://purl.org/phmo#hasProbability
<http://purl.org/phmo#hasProbability> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain [ rdf:type owl:Class ;
                                                    owl:unionOf ( <http://purl.org/phmo#HealthEventPrediction>
                                                                  <http://purl.org/phmo#HealthRiskAssessment>
                                                                )
                                                  ] ;
                                      rdfs:range xsd:float ;
                                      rdfs:comment "The probability associated with a health risk assessment or prediction of a health event." ;
                                      rdfs:label "has probability" .


###  http://purl.org/phmo#hasPublicationMonthYear
<http://purl.org/phmo#hasPublicationMonthYear> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://purl.org/phmo#Publication> ;
                                               rdfs:range [ rdf:type rdfs:Datatype ;
                                                            owl:unionOf ( xsd:gYear
                                                                          xsd:gYearMonth
                                                                        )
                                                          ] ;
                                               rdfs:comment "The month and/or year when a publication was published." ;
                                               rdfs:label "has publication month and/or year" .


###  http://purl.org/phmo#hasRecall
<http://purl.org/phmo#hasRecall> rdf:type owl:DatatypeProperty ;
                                 rdfs:subPropertyOf <http://purl.org/phmo#hasPerformanceMetric> ;
                                 rdfs:domain <http://purl.org/phmo#Model> ;
                                 rdfs:range xsd:float ;
                                 rdfs:comment "The recall (sensitivity) of a model, i.e. the proportion of positive cases it classifies as positive at its decision threshold." ;
                                 rdfs:label "has recall" .


###  http://purl.org/phmo#hasRecommendationTimestamp
<http://purl.org/phmo#hasRecommendationTimestamp> rdf:type owl:DatatypeProperty ;
                                                  rdfs:subPropertyOf <https://saref.etsi.org/core/hasTimestamp> ;
                                                  rdfs:domain <http://purl.org/phmo#HealthIntervention> ;
                                                  rdfs:range xsd:dateTimeStamp ;
                                                  rdfs:comment "The timestamp at which a health intervention was recommended by a model." ;
                                                  rdfs:label "has recommendation timestamp" .


###  http://purl.org/phmo#hasSamplingFrequency
<http://purl.org/phmo#hasSamplingFrequency> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <http://purl.org/phmo#ContinuousObservation> ;
                                            rdfs:range xsd:integer ;
                                            rdfs:comment "The sampling frequency in Hz of an ECG observation." ;
                                            rdfs:label "has sampling frequency" .


###  http://purl.org/phmo#hasSpecificity
<http://purl.org/phmo#hasSpecificity> rdf:type owl:DatatypeProperty ;
                                      rdfs:subPropertyOf <http://purl.org/phmo#hasPerformanceMetric> ;
                                      rdfs:domain <http://purl.org/phmo#Model> ;
                                      rdfs:range xsd:float ;
                                      rdfs:comment "The specificity of a model, i.e. the proportion of negative cases it classifies as negative at its decision threshold." ;
                                      rdfs:label "has specificity" .


###  http://purl.org/phmo#hasStateRisk
<http://purl.org/phmo#hasStateRisk> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <http://purl.org/phmo#StateRiskRelationship> ;
                                    rdfs:range xsd:decimal ;
                                    rdfs:comment "State risk represents the risk of a condition for a particular risk factor state." ;
                                    rdfs:label "has state risk" .


###  http://purl.org/phmo#hasTargetWindow
<http://purl.org/phmo#hasTargetWindow> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://purl.org/phmo#HealthEventPrediction> ;
                                       rdfs:range xsd:duration ;
                                       rdfs:comment "The period, following the prediction horizon, within which the predicted health event is expected to begin." ;
                                       rdfs:label "has target window" .


###  http://purl.org/phmo#hasText
<http://purl.org/phmo#hasText> rdf:type owl:DatatypeProperty ;
                               rdfs:domain <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                               rdfs:range xsd:string ;
                               rdfs:comment "The text of an explanation as presented to a user." ;
                               rdfs:label "has text" .


###  http://purl.org/spar/fabio/hasPageCount
<http://purl.org/spar/fabio/hasPageCount> rdf:type owl:DatatypeProperty ,
                                                   owl:FunctionalProperty ;
                                          rdfs:domain <http://purl.org/phmo#Publication> ;
                                          rdfs:range xsd:positiveInteger ;
                                          rdfs:comment "The count of the number of pages in a textual resource."@en ;
                                          rdfs:label "has page count"@en .


###  http://www.w3.org/ns/sosa/endTime
<http://www.w3.org/ns/sosa/endTime> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <http://purl.org/phmo#ContinuousObservation> ;
                                    rdfs:range xsd:dateTimeStamp ;
                                    <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Deployment> ,
                                                                       <http://www.w3.org/ns/sosa/Execution> ,
                                                                       <http://www.w3.org/ns/sosa/ExecutionCollection> ;
                                    rdfs:comment "The value would usually be encoded using xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear"@en ;
                                    rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                    rdfs:label "end time"@en ;
                                    <http://www.w3.org/2004/02/skos/core#definition> """
  instant of time when the Execution or Deployment was ended or completed
  """@en .


###  http://www.w3.org/ns/sosa/startTime
<http://www.w3.org/ns/sosa/startTime> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://purl.org/phmo#ContinuousObservation> ;
                                      rdfs:range xsd:dateTimeStamp ;
                                      <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Deployment> ,
                                                                         <http://www.w3.org/ns/sosa/Execution> ,
                                                                         <http://www.w3.org/ns/sosa/ExecutionCollection> ,
                                                                         <http://www.w3.org/ns/sosa/Observation> ,
                                                                         <http://www.w3.org/ns/sosa/ObservationCollection> ;
                                      rdfs:comment "The value would usually be encoded using xsd:dateTime xsd:date xsd:gYearMonth xsd:gYear"@en ;
                                      rdfs:isDefinedBy <http://www.w3.org/ns/sosa/common/> ;
                                      rdfs:label "start time"@en ;
                                      <http://www.w3.org/2004/02/skos/core#definition> """
  instant of time when the Execution or Deployment was initiated or tasked
  """@en .


###  http://xmlns.com/foaf/0.1/birthday
<http://xmlns.com/foaf/0.1/birthday> rdf:type owl:DatatypeProperty ,
                                              owl:FunctionalProperty ;
                                     rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                                     rdfs:range xsd:date ;
                                     <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> "has birthday" ;
                                     rdfs:comment "The date on which a person was born." ;
                                     rdfs:label "has date of birth" .


###  http://xmlns.com/foaf/0.1/firstName
<http://xmlns.com/foaf/0.1/firstName> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://xmlns.com/foaf/0.1/Person> ;
                                      rdfs:range xsd:string ;
                                      <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "hasGivenName" ;
                                      rdfs:comment "A person's first or given name as per their identity document." ;
                                      rdfs:label "has first name" .


###  http://xmlns.com/foaf/0.1/name
<http://xmlns.com/foaf/0.1/name> rdf:type owl:DatatypeProperty ;
                                 rdfs:domain <http://xmlns.com/foaf/0.1/Person> ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "A name for some thing." ,
                                              "A person's name." ;
                                 rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                 rdfs:label "has full name" ,
                                            "name" ;
                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing" .


###  http://xmlns.com/foaf/0.1/surname
<http://xmlns.com/foaf/0.1/surname> rdf:type owl:DatatypeProperty ;
                                    rdfs:domain <http://xmlns.com/foaf/0.1/Person> ;
                                    rdfs:range xsd:string ;
                                    <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> "hasFamilyName" ,
                                                                                                   "surname" ;
                                    rdfs:comment "A person's last name, family name, or surname as per their identity document." ;
                                    rdfs:label "has last name" .


###  https://saref.etsi.org/core/hasManufacturer
<https://saref.etsi.org/core/hasManufacturer> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <https://saref.etsi.org/saref4ehaw/HealthDevice> ;
                                              rdfs:range xsd:string ;
                                              rdfs:comment "A relationship identifying the manufacturer of an entity (e.g., device). The value is expected to be a string or a string with language tag."@en ;
                                              rdfs:label "has manufacturer"@en ;
                                              <http://www.w3.org/2004/02/skos/core#historyNote> "V3.2.1: Defined domain of saref:hasManufacturer to union of feature kind and feature of interest."@en .


###  https://saref.etsi.org/core/hasModel
<https://saref.etsi.org/core/hasModel> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <https://saref.etsi.org/saref4ehaw/HealthDevice> ;
                                       rdfs:range xsd:string ;
                                       rdfs:comment "A relationship identifying the model of an entity (e.g., device). The value is expected to be a string or a string with language tag."@en ;
                                       rdfs:label "has model"@en ;
                                       <http://www.w3.org/2004/02/skos/core#historyNote> "V3.2.1: Defined domain of saref:hasModel to union of feature kind and feature of interest."@en .


###  https://saref.etsi.org/core/hasTimestamp
<https://saref.etsi.org/core/hasTimestamp> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain [ rdf:type owl:Class ;
                                                         owl:unionOf ( <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation>
                                                                       <http://purl.org/phmo#DiscreteObservation>
                                                                       <https://purl.org/heals/eo#SystemRecommendation>
                                                                     )
                                                       ] ;
                                           rdfs:range xsd:dateTimeStamp ;
                                           rdfs:comment "Links a procedure execution or a profile to an instant."@en ;
                                           rdfs:label "has timestamp"@en ;
                                           <http://www.w3.org/2004/02/skos/core#historyNote> "V3.2.1: Tried to clarify definition of saref:hasTimestamp. Still unclear."@en ;
                                           <http://www.w3.org/2004/02/skos/core#note> "Applied on a profile, it describes the applicable instant of that profile"@en ,
                                                                                      "When the execution time and the phenomenon time are the same time instants, then DP saref:hasTimestamp can be used to simply link a procedure execution to the time of these instants, expressed as an xsd:dateTime literal."@en .


###  https://saref.etsi.org/core/hasValue
<https://saref.etsi.org/core/hasValue> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://purl.org/phmo#DiscreteObservation> ;
                                       rdfs:range xsd:decimal ;
                                       rdfs:comment "A relationship defining the value of a certain property, e.g., energy or power. Note that, even if numeric values are expected to enable reasoning, measurement values could use other datatypes."@en ;
                                       rdfs:isDefinedBy <https://saref.etsi.org/core/> ;
                                       rdfs:label "has value"@en .


#################################################################
#    Classes
#################################################################

###  http://linkedu.eu/dedalo/explanationPattern.owl#Explanation
<http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> rdf:type owl:Class ;
                                                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> ;
                                                                                owl:someValuesFrom <https://purl.org/heals/eo#SystemRecommendation>
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://purl.org/phmo#isConsumedBy> ;
                                                                                owl:someValuesFrom <https://purl.org/heals/eo#user>
                                                                              ] ,
                                                                              [ rdf:type owl:Restriction ;
                                                                                owl:onProperty <http://purl.org/phmo#hasText> ;
                                                                                owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                                                owl:onDataRange xsd:string
                                                                              ] ;
                                                              owl:disjointWith <http://purl.obolibrary.org/obo/MAXO_0000001> ,
                                                                               <http://purl.org/phmo#ApprovalStatus> ,
                                                                               <http://purl.org/phmo#HealthEvent> ,
                                                                               <http://purl.org/phmo#HealthEventPredictionStatus> ,
                                                                               <http://purl.org/phmo#HealthRiskFactor> ,
                                                                               <http://purl.org/phmo#HealthRiskRelationship> ,
                                                                               <http://purl.org/phmo#HealthRiskStatus> ,
                                                                               <http://purl.org/phmo#MedicalCondition> ,
                                                                               <http://purl.org/phmo#Model> ,
                                                                               <http://purl.org/phmo#Publication> ,
                                                                               <http://www.w3.org/ns/dcat#Dataset> ,
                                                                               <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                                               <http://www.w3.org/ns/sosa/Observation> ,
                                                                               <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                                               <http://www.w3.org/ns/sosa/Property> ,
                                                                               <http://www.w3.org/ns/sosa/Sensor> ,
                                                                               <http://xmlns.com/foaf/0.1/Agent> ,
                                                                               <https://purl.org/heals/eo#SystemRecommendation> ,
                                                                               <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                                               <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                                               <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                                              <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                              rdfs:comment "An account, consumed by a user, that is based on a system recommendation and the knowledge used to produce it, and that addresses a question the user has." ;
                                                              rdfs:isDefinedBy <http://linkedu.eu/dedalo/explanationPattern.owl> ;
                                                              rdfs:label "Explanation" .


