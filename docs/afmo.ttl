                               rdfs:subPropertyOf :isECGFactorStatusOf ;
                               rdfs:domain :PRIntervalVariation ;
                               rdfs:range <http://purl.org/phmo#MonitoredPerson> ;
                               rdfs:comment "The relationship between a PR interval variation status (present or absent) and a monitored person who has it." ;
                               rdfs:label "is PR interval variation status of" .


