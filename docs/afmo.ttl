#################################################################
#    Object Properties
#################################################################

###  http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn
<http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> rdf:type owl:ObjectProperty ;
                                                            owl:inverseOf <http://purl.org/phmo#isBasisOf> ;
                                                            rdfs:domain <http://linkedu.eu/dedalo/explanationPattern.owl#Explanation> ;
                                                            rdfs:range <https://purl.org/heals/eo#SystemRecommendation> ;
                                                            <http://purl.org/dc/terms/source> "Chari, S., Seneviratne, O., Ghalwash, M., Shirai, S., Gruen, D. M., Meyer, P., Chakraborty, P., & McGuinness, D. L. (2024). Explanation Ontology: A general-purpose, semantic representation for supporting user-centered explanations. Semantic Web. https://doi.org/10.3233/SW-233282" ;
                                                            rdfs:comment "The relationship between an explanation and the system recommendation it is based on. The domain, range and inverse are added in AFMO." ;
                                                            rdfs:isDefinedBy <http://linkedu.eu/dedalo/explanationPattern.owl> ;
                                                            rdfs:label "is based on" .


###  http://purl.org/afmo#hasAgeGroup
:hasAgeGroup rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf <http://purl.org/phmo#hasRiskFactorStatus> ;
             owl:inverseOf :isAgeGroupOf ;
             rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
             rdfs:range :AgeGroup ;
             <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "saref4wear:wearerAgeRange" ;
             rdfs:comment "The relationship between a monitored person and their age group." ;
             rdfs:label "has age group" .

[ rdf:type owl:AllDisjointProperties ;
   owl:members ( :hasAgeGroup
               )
 ] .


###  http://purl.org/afmo#hasAlcoholMisuseStatus
:hasAlcoholMisuseStatus rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://purl.org/phmo#hasRiskFactorStatus> ;
                        owl:inverseOf :isAlcoholMisuseStatusOf ;
                        rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                        rdfs:range :AlcoholMisuse ;
                        rdfs:comment "The relationship between a monitored person and their alcohol misuse status (present or absent)." ;
                        rdfs:label "has alcohol misuse status" .

[ rdf:type owl:AllDisjointProperties ;
   owl:members ( :hasAlcoholMisuseStatus
               )
 ] .


###  http://purl.org/afmo#hasECGFactorStatus
:hasECGFactorStatus rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf <http://purl.org/phmo#hasRiskFactorStatus> ;
                    owl:inverseOf :isECGFactorStatusOf ;
                    rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                    rdfs:range :ECGFactor ;
                    rdfs:comment "The relationship between a monitored person and an ECG risk factor status." ;
                    rdfs:label "has ECG factor status" .


###  http://purl.org/afmo#hasHeightGroup
:hasHeightGroup rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://purl.org/phmo#hasRiskFactorStatus> ;
                owl:inverseOf :isHeightGroupOf ;
                rdfs:domain <http://purl.org/phmo#MonitoredPerson> ;
                rdfs:range :HeightGroup ;
                rdfs:comment "The relationship between a monitored person and their height group." ;
                rdfs:label "has height group" .


