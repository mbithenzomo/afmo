###  http://purl.org/afmo#AFRiskExplanation1
:AFRiskExplanation1 rdf:type owl:NamedIndividual ,
                             <https://purl.org/heals/eo#RationaleExplanation> ;
                    <http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> :AFRiskAssessment1 ;
                    <http://purl.org/phmo#isConsumedBy> :Atieno ;
                    <http://purl.org/phmo#hasText> "Your AF risk assessment of 10 July 2026 found that your risk of developing AF is raised. The main reasons are your hypertension (high blood pressure) and your alcohol use." ;
                    <https://saref.etsi.org/core/hasTimestamp> "2026-07-10T14:30:00+03:00"^^xsd:dateTimeStamp ;
                    rdfs:comment "Example statistical and rationale explanation of Atieno's AF risk assessment, provided to Atieno." ;
                    rdfs:label "AF risk explanation 1" .


###  http://purl.org/afmo#AFRiskExplanation2
:AFRiskExplanation2 rdf:type owl:NamedIndividual ,
                             <https://purl.org/heals/eo#DataExplanation> ,
                             <https://purl.org/heals/eo#SafetyAndPerformanceExplanation> ;
                    <http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> :AFRiskAssessment1 ;
                    <http://purl.org/phmo#isConsumedBy> :DrChebet ;
                    <http://purl.org/phmo#hasText> "The assessment was made by a hybrid Bayesian network trained and tested on the MIMIC-IV dataset. It achieved an AUROC of 0.82, a recall of 0.89, and a specificity of 0.58 at its decision threshold of 0.053." ;
                    <https://saref.etsi.org/core/hasTimestamp> "2026-07-10T14:30:00+03:00"^^xsd:dateTimeStamp ;
                    rdfs:comment "Example data explanation of Atieno's AF risk assessment, provided to her clinician Dr Chebet." ;
                    rdfs:label "AF risk explanation 2" .


###  http://purl.org/afmo#AFRiskExplanation3
:AFRiskExplanation3 rdf:type owl:NamedIndividual ,
                             <https://purl.org/heals/eo#CounterfactualExplanation> ;
                    <http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> :AFRiskAssessment1 ;
                    <http://purl.org/phmo#isConsumedBy> :Bahati ;
                    <http://purl.org/phmo#hasText> "Atieno's risk of developing atrial fibrillation (AF) is raised, mainly because of her hypertension (high blood pressure). If hypertension was absent, the assessed AF risk would fall from 45 in 100 to 20 in 100.”" ;
                    <https://saref.etsi.org/core/hasTimestamp> "2026-07-10T14:30:00+03:00"^^xsd:dateTimeStamp ;
                    rdfs:comment "Example counterfactual explanation of Atieno's AF risk assessment, provided to her caregiver Bahati." ;
                    rdfs:label "AF risk explanation 3" .


###  http://purl.org/afmo#AFRiskExplanation4
:AFRiskExplanation4 rdf:type owl:NamedIndividual ,
                             <https://purl.org/heals/eo#ContrastiveExplanation> ,
                             <https://purl.org/heals/eo#scientificExplanation> ;
                    <http://linkedu.eu/dedalo/explanationPattern.owl#isBasedOn> :AFRiskAssessment1 ;
                    <http://purl.org/phmo#isConsumedBy> :DrChebet ;
                    <http://purl.org/phmo#hasText> "The hybrid Bayesian network classified Atieno's AF risk as present on 10 July 2026, with a calibrated probability of 0.64 against a decision threshold of 0.053. Hypertension is the input state that distinguishes this result from AF risk absent; it is an established risk factor for AF in the 2024 ESC guidelines for the management of AF." ;
                    <https://saref.etsi.org/core/hasTimestamp> "2026-07-10T14:30:00+03:00"^^xsd:dateTimeStamp ;
                    rdfs:comment "Example scientific and contrastive explanation of Atieno's AF risk assessment, provided to her clinician Dr Chebet." ;
                    rdfs:label "AF risk explanation 4" .


