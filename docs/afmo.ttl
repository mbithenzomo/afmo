                                                     owl:onClass <http://purl.org/phmo#MedicalCondition>
                                                   ] ;
                                   owl:disjointWith <http://purl.org/phmo#HealthEventPrediction> ,
                                                    <http://purl.org/phmo#HealthEventPredictionStatus> ,
                                                    <http://purl.org/phmo#HealthIntervention> ,
                                                    <http://purl.org/phmo#HealthRiskAssessment> ,
                                                    <http://purl.org/phmo#HealthRiskFactor> ,
                                                    <http://purl.org/phmo#HealthRiskRelationship> ,
                                                    <http://purl.org/phmo#HealthRiskStatus> ,
                                                    <http://purl.org/phmo#MedicalCondition> ,
                                                    <http://purl.org/phmo#Model> ,
                                                    <http://purl.org/phmo#Publication> ,
                                                    <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                    <http://www.w3.org/ns/sosa/Observation> ,
                                                    <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                    <http://www.w3.org/ns/sosa/Property> ,
                                                    <http://www.w3.org/ns/sosa/Sensor> ,
                                                    <http://xmlns.com/foaf/0.1/Agent> ,
                                                    <http://xmlns.com/foaf/0.1/Person> ,
                                                    <https://purl.org/heals/eo#SystemRecommendation> ,
                                                    <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                    <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                    <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                   rdfs:comment "A short-term, imminent occurrence associated with a specific medical condition." ;
                                   rdfs:label "Health event" .


###  http://purl.org/phmo#HealthEventPrediction
<http://purl.org/phmo#HealthEventPrediction> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://purl.org/heals/eo#SystemRecommendation> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasInputObservation> ;
                                                               owl:someValuesFrom <http://purl.org/phmo#ContinuousObservation>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasResponseIntervention> ;
                                                               owl:someValuesFrom <http://purl.org/phmo#HealthIntervention>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasPredictionStatus> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass <http://purl.org/phmo#HealthEventPredictionStatus>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#isPredictionOf> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass <http://purl.org/phmo#MonitoredPerson>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#isPredictionOfCondition> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass <http://purl.org/phmo#MedicalCondition>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#isPredictionOfHealthEvent> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass <http://purl.org/phmo#HealthEvent>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#wasPredictedByModel> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onClass <http://purl.org/phmo#Model>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasInputWindow> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onDataRange xsd:duration
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasPredictionHorizon> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onDataRange xsd:duration
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasProbability> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onDataRange xsd:float
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#hasTargetWindow> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onDataRange xsd:duration
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <https://saref.etsi.org/core/hasTimestamp> ;
                                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                               owl:onDataRange xsd:dateTimeStamp
                                                             ] ;
                                             owl:disjointWith <http://purl.org/phmo#HealthEventPredictionStatus> ,
                                                              <http://purl.org/phmo#HealthIntervention> ,
                                                              <http://purl.org/phmo#HealthRiskAssessment> ,
                                                              <http://purl.org/phmo#HealthRiskFactor> ,
                                                              <http://purl.org/phmo#HealthRiskRelationship> ,
                                                              <http://purl.org/phmo#HealthRiskStatus> ,
                                                              <http://purl.org/phmo#MedicalCondition> ,
                                                              <http://purl.org/phmo#Model> ,
                                                              <http://purl.org/phmo#Publication> ,
                                                              <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                              <http://www.w3.org/ns/sosa/Observation> ,
                                                              <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                              <http://www.w3.org/ns/sosa/Property> ,
                                                              <http://www.w3.org/ns/sosa/Sensor> ,
                                                              <http://xmlns.com/foaf/0.1/Agent> ,
                                                              <http://xmlns.com/foaf/0.1/Person> ,
                                                              <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                              <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                              <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                             rdfs:comment "A prediction of a health event in a monitored person as computed by a model." ;
                                             rdfs:label "Health event prediction" .


###  http://purl.org/phmo#HealthEventPredictionStatus
<http://purl.org/phmo#HealthEventPredictionStatus> rdf:type owl:Class ;
                                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://purl.org/phmo#isPredictionStatusOf> ;
                                                                     owl:someValuesFrom <http://purl.org/phmo#HealthEventPrediction>
                                                                   ] ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://purl.org/phmo#isPredictionStatusOfCondition> ;
                                                                     owl:someValuesFrom <http://purl.org/phmo#MedicalCondition>
                                                                   ] ;
                                                   owl:disjointWith <http://purl.org/phmo#HealthIntervention> ,
                                                                    <http://purl.org/phmo#HealthRiskAssessment> ,
                                                                    <http://purl.org/phmo#HealthRiskFactor> ,
                                                                    <http://purl.org/phmo#HealthRiskRelationship> ,
                                                                    <http://purl.org/phmo#HealthRiskStatus> ,
                                                                    <http://purl.org/phmo#MedicalCondition> ,
                                                                    <http://purl.org/phmo#Model> ,
                                                                    <http://purl.org/phmo#Publication> ,
                                                                    <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                                    <http://www.w3.org/ns/sosa/Observation> ,
                                                                    <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                                    <http://www.w3.org/ns/sosa/Property> ,
                                                                    <http://www.w3.org/ns/sosa/Sensor> ,
                                                                    <http://xmlns.com/foaf/0.1/Agent> ,
                                                                    <http://xmlns.com/foaf/0.1/Person> ,
                                                                    <https://purl.org/heals/eo#SystemRecommendation> ,
                                                                    <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                                    <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                                    <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                                   rdfs:comment "The status for a medical conditon event (i.e. present or absent) in a monitored person." ;
                                                   rdfs:label "Health event prediction status" .


###  http://purl.org/phmo#HealthIntervention
<http://purl.org/phmo#HealthIntervention> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://purl.org/heals/eo#SystemRecommendation> ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#hasMedicalAction> ;
                                                            owl:someValuesFrom <http://purl.obolibrary.org/obo/MAXO_0000001>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#isEvidencedBy> ;
                                                            owl:someValuesFrom <http://purl.obolibrary.org/obo/ECO_0000000>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#isRecommendedFor> ;
                                                            owl:someValuesFrom <http://purl.org/phmo#MonitoredPerson>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#isInResponseTo> ;
                                                            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass [ rdf:type owl:Class ;
                                                                          owl:unionOf ( <http://purl.org/phmo#HealthEventPrediction>
                                                                                        <http://purl.org/phmo#HealthRiskAssessment>
                                                                                      )
                                                                        ]
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#approvalStatusDeterminedByClinician> ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass <http://purl.org/phmo#Clinician>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#expectedUtilityCalculatedByModel> ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass <http://purl.org/phmo#BayesianDecisionNetwork>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#hasApprovalStatus> ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onClass <http://purl.org/phmo#ApprovalStatus>
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#hasApprovalStatusTimestamp> ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onDataRange xsd:dateTimeStamp
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#hasExpectedUtility> ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onDataRange xsd:float
                                                          ] ,
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty <http://purl.org/phmo#hasRecommendationTimestamp> ;
                                                            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                            owl:onDataRange xsd:dateTimeStamp
                                                          ] ;
                                          owl:disjointWith <http://purl.org/phmo#HealthRiskAssessment> ,
                                                           <http://purl.org/phmo#HealthRiskFactor> ,
                                                           <http://purl.org/phmo#HealthRiskRelationship> ,
                                                           <http://purl.org/phmo#HealthRiskStatus> ,
                                                           <http://purl.org/phmo#MedicalCondition> ,
                                                           <http://purl.org/phmo#Model> ,
                                                           <http://purl.org/phmo#Publication> ,
                                                           <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                           <http://www.w3.org/ns/sosa/Observation> ,
                                                           <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                           <http://www.w3.org/ns/sosa/Property> ,
                                                           <http://www.w3.org/ns/sosa/Sensor> ,
                                                           <http://xmlns.com/foaf/0.1/Agent> ,
                                                           <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                           <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                           <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                          rdfs:comment "Any activity undertaken with the objective of improving human health by preventing disease, by curing or reducing the severity or duration of an existing disease, or by restoring function lost through disease or injury." ;
                                          rdfs:label "Health intervention" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.org/phmo#HealthIntervention> ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "Any activity undertaken with the objective of improving human health by preventing disease, by curing or reducing the severity or duration of an existing disease, or by restoring function lost through disease or injury." ;
   rdfs:isDefinedBy "Smith, Peter G., Richard H. Morrow, and David A. Ross. \"Field Trials of Health Interventions.\", ch. 2 , 3 ed., 2015. https://www.ncbi.nlm.nih.gov/books/NBK305514/"
 ] .


###  http://purl.org/phmo#HealthRiskAssessment
<http://purl.org/phmo#HealthRiskAssessment> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://purl.org/heals/eo#SystemRecommendation> ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/phmo#hasInputRiskFactorState> ;
                                                              owl:someValuesFrom <http://purl.org/phmo#HealthRiskFactor>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/phmo#hasResponseIntervention> ;
                                                              owl:someValuesFrom <http://purl.org/phmo#HealthIntervention>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/phmo#isRiskAssessmentOf> ;
                                                              owl:allValuesFrom <http://purl.org/phmo#MonitoredPerson>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/phmo#isRiskAssessmentOfCondition> ;
                                                              owl:allValuesFrom <http://purl.org/phmo#MedicalCondition>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/phmo#hasRiskStatus> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass <http://purl.org/phmo#HealthRiskStatus>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/phmo#wasAssessedByModel> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onClass <http://purl.org/phmo#Model>
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://purl.org/phmo#hasProbability> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onDataRange xsd:float
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://saref.etsi.org/core/hasTimestamp> ;
                                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                              owl:onDataRange xsd:dateTimeStamp
                                                            ] ;
                                            owl:disjointWith <http://purl.org/phmo#HealthRiskFactor> ,
                                                             <http://purl.org/phmo#HealthRiskRelationship> ,
                                                             <http://purl.org/phmo#HealthRiskStatus> ,
                                                             <http://purl.org/phmo#MedicalCondition> ,
                                                             <http://purl.org/phmo#Model> ,
                                                             <http://purl.org/phmo#Publication> ,
                                                             <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                             <http://www.w3.org/ns/sosa/Observation> ,
                                                             <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                             <http://www.w3.org/ns/sosa/Sensor> ,
                                                             <http://xmlns.com/foaf/0.1/Agent> ,
                                                             <http://xmlns.com/foaf/0.1/Person> ,
                                                             <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                             <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                             <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                            rdfs:comment "An assessment of disease risk in a monitored person as computed by a model." ;
                                            rdfs:label "Health risk assessment" .


###  http://purl.org/phmo#HealthRiskFactor
<http://purl.org/phmo#HealthRiskFactor> rdf:type owl:Class ;
                                        rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isEffectModifierInRelationship> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#StateRiskRelationship>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isRiskFactorCategoryInRelationship> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#CategoryRiskRelationship>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isRiskFactorInRelationship> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#FactorRiskRelationship>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isRiskFactorStateInRelationship> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#StateRiskRelationship>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#isRiskFactorStatusOf> ;
                                                          owl:someValuesFrom <http://purl.org/phmo#MonitoredPerson>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <http://purl.org/phmo#hasDateOfConfirmation> ;
                                                          owl:someValuesFrom xsd:date
                                                        ] ;
                                        owl:disjointWith <http://purl.org/phmo#HealthRiskRelationship> ,
                                                         <http://purl.org/phmo#HealthRiskStatus> ,
                                                         <http://purl.org/phmo#MedicalCondition> ,
                                                         <http://purl.org/phmo#Model> ,
                                                         <http://purl.org/phmo#Publication> ,
                                                         <http://www.w3.org/ns/sosa/FeatureOfInterest> ,
                                                         <http://www.w3.org/ns/sosa/Observation> ,
                                                         <http://www.w3.org/ns/sosa/ObservationCollection> ,
                                                         <http://www.w3.org/ns/sosa/Property> ,
                                                         <http://www.w3.org/ns/sosa/Sensor> ,
                                                         <http://xmlns.com/foaf/0.1/Agent> ,
                                                         <http://xmlns.com/foaf/0.1/Person> ,
                                                         <https://purl.org/heals/eo#SystemRecommendation> ,
                                                         <https://saref.etsi.org/core/UnitOfMeasure> ,
                                                         <https://saref.etsi.org/saref4ehaw/HealthDevice> ,
                                                         <https://saref.etsi.org/saref4wear/WearableDevice> ;
                                        <http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MSH:D012307"@en ,
                                                                                                 "SNOMEDCT_US:80943009"@en ,
                                                                                                 "UMLS:C0035648"@en ;
                                        rdfs:comment "An aspect of personal behavior or lifestyle, environmental exposure, inborn or inherited characteristic, which, based on epidemiological evidence, is known to be associated with a health-related condition considered important to prevent."@en ,
                                                     "Class to group risk factors associated with atrial fibrillation."@en ;
                                        rdfs:label "Health risk factor" .

[ rdf:type owl:Axiom ;
   owl:annotatedSource <http://purl.org/phmo#HealthRiskFactor> ;
   owl:annotatedProperty rdfs:comment ;
   owl:annotatedTarget "An aspect of personal behavior or lifestyle, environmental exposure, inborn or inherited characteristic, which, based on epidemiological evidence, is known to be associated with a health-related condition considered important to prevent."@en ;
   rdfs:isDefinedBy "Medical Subject Headings (MeSH)"
 ] .


###  http://purl.org/phmo#HealthRiskRelationship
<http://purl.org/phmo#HealthRiskRelationship> rdf:type owl:Class ;
