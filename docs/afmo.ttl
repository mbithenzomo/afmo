                                                      owl:inverseOf <http://purl.org/phmo#isConditionInComorbidityStatus> ;
                                                      rdfs:domain <http://purl.org/phmo#ComorbidityFactor> ;
                                                      rdfs:range <http://purl.org/phmo#MedicalCondition> ;
