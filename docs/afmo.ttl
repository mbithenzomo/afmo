                                          rdfs:comment "The relationship between a health risk relationship and a medical condition." ;
                                          rdfs:label "has risk of condition" .


###  http://purl.org/phmo#hasRiskStatus
<http://purl.org/phmo#hasRiskStatus> rdf:type owl:ObjectProperty ;
                                     owl:inverseOf <http://purl.org/phmo#isRiskStatusOf> ;
