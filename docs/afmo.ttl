                                     rdfs:range <http://purl.org/phmo#HealthRiskStatus> ;
                                     rdfs:comment "The relationship between a health risk assessment and a risk status (present or absent)." ;
                                     rdfs:label "has risk status" .


###  http://purl.org/phmo#hasSex
<http://purl.org/phmo#hasSex> rdf:type owl:ObjectProperty ;
