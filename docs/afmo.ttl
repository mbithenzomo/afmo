###  http://purl.obolibrary.org/obo/DOID_9351
<http://purl.obolibrary.org/obo/DOID_9351> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://purl.org/phmo#MedicalCondition> .


###  http://purl.obolibrary.org/obo/ECO_0000000
<http://purl.obolibrary.org/obo/ECO_0000000> rdf:type owl:Class ;
                                             rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#isEvidenceFor> ;
                                                               owl:someValuesFrom <http://purl.org/phmo#HealthIntervention>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#isEvidenceFor> ;
                                                               owl:someValuesFrom <http://purl.org/phmo#HealthRiskRelationship>
                                                             ] ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.org/phmo#isPublishedAs> ;
