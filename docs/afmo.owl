    <!-- http://purl.org/afmo#InterventionExplanation1 -->


    <owl:NamedIndividual rdf:about="http://purl.org/afmo#InterventionExplanation1">
        <rdf:type rdf:resource="https://purl.org/heals/eo#scientificExplanation"/>
        <explanationPattern:isBasedOn rdf:resource="http://purl.org/afmo#HealthIntervention2"/>
        <phmo:isConsumedBy rdf:resource="http://purl.org/afmo#DrChebet"/>
        <phmo:hasText>Alcoholism counselling was recommended for Atieno, with an expected utility of 50 as calculated by the Bayesian decision network. Its efficacy in reducing alcohol misuse is supported by a systematic review and meta-analysis (Jonas et al., 2012).</phmo:hasText>
        <core2:hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-09-21T14:30:00+03:00</core2:hasTimestamp>
        <rdfs:comment>Example scientific explanation of the recommendation of alcoholism counselling for Atieno, provided to her clinician Dr Chebet.</rdfs:comment>
        <rdfs:label>Intervention explanation 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/afmo#InterventionExplanation2 -->


    <owl:NamedIndividual rdf:about="http://purl.org/afmo#InterventionExplanation2">
        <rdf:type rdf:resource="https://purl.org/heals/eo#scientificExplanation"/>
        <explanationPattern:isBasedOn rdf:resource="http://purl.org/afmo#HealthIntervention2"/>
        <phmo:isConsumedBy rdf:resource="http://purl.org/afmo#Atieno"/>
        <phmo:hasText>Dr Chebet has approved alcohol counselling for you. Studies show that counselling helps people reduce how much they drink, and drinking less lowers your risk of atrial fibrillation (AF).</phmo:hasText>
        <core2:hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-09-21T19:30:00+03:00</core2:hasTimestamp>
        <rdfs:comment>Example scientific explanation of the recommendation of alcoholism counselling, provided to Atieno.</rdfs:comment>
        <rdfs:label>Intervention explanation 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://purl.org/afmo#InterventionExplanation3 -->


    <owl:NamedIndividual rdf:about="http://purl.org/afmo#InterventionExplanation3">
        <rdf:type rdf:resource="https://purl.org/heals/eo#RationaleExplanation"/>
        <explanationPattern:isBasedOn rdf:resource="http://purl.org/afmo#HealthIntervention2"/>
        <phmo:isConsumedBy rdf:resource="http://purl.org/afmo#Bahati"/>
        <phmo:hasText>Alcohol counselling has been recommended for Atieno because her alcohol use is one of the reasons her risk of atrial fibrillation (AF) is raised. Dr Chebet has approved it, and your support in helping her attend the sessions can make a difference.</phmo:hasText>
        <core2:hasTimestamp rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-09-21T19:30:00+03:00</core2:hasTimestamp>
        <rdfs:comment>Example rationale explanation of the recommendation of alcoholism counselling for Atieno, provided to her caregiver Bahati.</rdfs:comment>
        <rdfs:label>Intervention explanation 3</rdfs:label>
    </owl:NamedIndividual>
    


