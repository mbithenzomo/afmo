        <rdfs:domain rdf:resource="http://purl.org/afmo#ECGFactor"/>
        <rdfs:range rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between an ECG risk factor status and a monitored person.</rdfs:comment>
