    <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/phmo#hasAge"/>
        <owl:someValuesFrom>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">65</xsd:maxExclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:someValuesFrom>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#hasAgeGroup"/>
                <owl:hasValue rdf:resource="http://purl.org/afmo#60-64"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Restriction>
    <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/phmo#hasAge"/>
        <owl:someValuesFrom>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">65</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">75</xsd:maxExclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:someValuesFrom>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#hasAgeGroup"/>
                <owl:hasValue rdf:resource="http://purl.org/afmo#65-74"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Restriction>
    <owl:Restriction>
        <owl:onProperty rdf:resource="http://purl.org/phmo#hasAge"/>
        <owl:someValuesFrom>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minExclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">74</xsd:minExclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </owl:someValuesFrom>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#hasAgeGroup"/>
                <owl:hasValue rdf:resource="http://purl.org/afmo#Above74"/>
            </owl:Restriction>
        </rdfs:subClassOf>
