    <!-- http://purl.org/afmo#ECGDevice -->


    <owl:Class rdf:about="http://purl.org/afmo#ECGDevice">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4ehaw/HealthWearable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://saref.etsi.org/core/consistsOf"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/afmo#ECGSensor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A wearable device equipped with an ECG sensor making it capable of taking an ECG.</rdfs:comment>
        <rdfs:label>ECG device</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#ECGFactor -->


    <owl:Class rdf:about="http://purl.org/afmo#ECGFactor">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthRiskFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isDeterminedBy"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#ECGObservation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#AnthropometricFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#ComorbidityFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#DemographicFactor"/>
        <owl:disjointWith rdf:resource="http://purl.org/phmo#LifestyleFactor"/>
        <rdfs:comment>A class to group risk factors for atrial fribrillation related to a person&apos;s ECG characteristics.</rdfs:comment>
        <rdfs:label>ECG factor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#ECGObservation -->


    <owl:Class rdf:about="http://purl.org/afmo#ECGObservation">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#ContinuousObservation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isDeterminantOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#ECGFactor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/madeBySensor"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#ECGSensor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#hasSamplingFrequency"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An electrocardiogram observation.</rdfs:comment>
        <rdfs:label>ECG observation</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#ECGSensor -->


    <owl:Class rdf:about="http://purl.org/afmo#ECGSensor">
        <rdfs:subClassOf rdf:resource="https://saref.etsi.org/saref4ehaw/HealthSensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isComponentOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#ECGDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/madeObservation"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#ECGObservation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#hasLead"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A sensor comprising two or more electrodes that record the electrical potential difference between electrode placements, corresponding to one ECG lead.</rdfs:comment>
        <rdfs:label>ECG sensor</rdfs:label>
    </owl:Class>
    


