                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/afmo#AlcoholMisuseAbsent"/>
                    <rdf:Description rdf:about="http://purl.org/afmo#AlcoholMisusePresent"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#LifestyleFactor"/>
    </owl:Class>
    


    <!-- http://purl.org/afmo#AtrialFibrillationEpisode -->


    <owl:Class rdf:about="http://purl.org/afmo#AtrialFibrillationEpisode">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isHealthEventOfCondition"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/afmo#AtrialFibrillationEpisodePrediction -->


    <owl:Class rdf:about="http://purl.org/afmo#AtrialFibrillationEpisodePrediction">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthEventPrediction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPredictionOfCondition"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPredictionOfHealthEvent"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/afmo#AtrialFibrillationEpisode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#wasPredictedByModel"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#ArtificialNeuralNetwork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A prediction of an upcoming episode in a monitored person.</rdfs:comment>
        <rdfs:label>Atrial fibrillation episode prediction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#AtrialFibrillationEpisodePredictionStatus -->


    <owl:Class rdf:about="http://purl.org/afmo#AtrialFibrillationEpisodePredictionStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/afmo#AFEpisodeAbsent"/>
                    <rdf:Description rdf:about="http://purl.org/afmo#AFEpisodePresent"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthEventPredictionStatus"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPredictionStatusOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#AtrialFibrillationEpisodePrediction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isPredictionStatusOfCondition"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>AF episode prediction status in a monitored person (present or absent).</rdfs:comment>
        <rdfs:label>Atrial fibrillation episode prediction status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#AtrialFibrillationRiskAssessment -->


    <owl:Class rdf:about="http://purl.org/afmo#AtrialFibrillationRiskAssessment">
        <rdfs:subClassOf rdf:resource="http://purl.org/phmo#HealthRiskAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#isRiskAssessmentOfCondition"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/phmo#wasAssessedByModel"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/phmo#BayesianNetwork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An assessment of AF risk in a monitored person.</rdfs:comment>
        <rdfs:label>Atrial fibrillation health risk assessment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#AtrialFibrillationRiskStatus -->


