        <rdfs:domain rdf:resource="http://purl.org/afmo#AgeGroup"/>
        <rdfs:range rdf:resource="http://purl.org/afmo#AgeGroup"/>
        <rdfs:comment>Transitive property to add order to the AgeGroup class.</rdfs:comment>
        <rdfs:label>is older than</rdfs:label>
    </owl:ObjectProperty>
    


