    <!-- http://purl.org/afmo#HybridBayesianNetwork -->


    <owl:NamedIndividual rdf:about="http://purl.org/afmo#HybridBayesianNetwork">
        <rdf:type rdf:resource="http://purl.org/phmo#BayesianNetwork"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#AgeGroup"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#AlcoholMisuse"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#COPDStatus"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#CardiovascularDiseaseStatus"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#DiabetesMellitusStatus"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#HeightGroup"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#HypertensionStatus"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#KidneyDiseaseStatus"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#PRIntervalVariation"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#PWaveVariation"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#ProlongedPRInterval"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#ProlongedPWave"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#ProlongedRRInterval"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#RRIntervalVariation"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#RaceOrEthnicity"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#SleepApnoeaStatus"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/afmo#SmokingStatus"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/phmo#BMICategory"/>
        <phmo:hasInputRiskFactor rdf:resource="http://purl.org/phmo#Sex"/>
        <phmo:madeRiskAssessment rdf:resource="http://purl.org/afmo#AFRiskAssessment1"/>
        <phmo:madeRiskAssessment rdf:resource="http://purl.org/afmo#AFRiskAssessment2"/>
        <phmo:wasTestedOn rdf:resource="http://purl.org/afmo#MIMICIV"/>
        <phmo:wasTrainedOn rdf:resource="http://purl.org/afmo#MIMICIV"/>
        <phmo:hasAUPRC rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.2</phmo:hasAUPRC>
        <phmo:hasAUROC rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.82</phmo:hasAUROC>
        <phmo:hasBrierScore rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.06</phmo:hasBrierScore>
        <phmo:hasDecisionThreshold rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.053</phmo:hasDecisionThreshold>
        <phmo:hasExpectedCalibrationError rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.01</phmo:hasExpectedCalibrationError>
        <phmo:hasF1Score rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.23</phmo:hasF1Score>
        <phmo:hasRecall rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.89</phmo:hasRecall>
        <phmo:hasSpecificity rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.58</phmo:hasSpecificity>
        <rdfs:comment>Hybrid Bayesian network that assesses AF risk from risk factor states, combining knowledge from the literature with data from MIMIC-IV.</rdfs:comment>
        <rdfs:label>Hybrid Bayesian network</rdfs:label>
    </owl:NamedIndividual>
    


