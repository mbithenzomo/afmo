        <oboInOwl:hasDbXref>NCIT:C150658</oboInOwl:hasDbXref>
        <rdfs:comment>Counseling designed to guide and support an individual to overcome alcohol dependence.</rdfs:comment>
        <rdfs:label xml:lang="en">Alcoholism counselling</rdfs:label>
    </rdf:Description>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
