    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MAXO_0000009">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000010 -->


    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MAXO_0000010">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000056 -->


    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MAXO_0000056">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000058 -->


    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MAXO_0000058">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000077 -->


    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MAXO_0000077">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000078 -->


    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MAXO_0000078">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
        <phmo:isMedicalActionInIntervention rdf:resource="http://purl.org/afmo#HealthIntervention2"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000092 -->


    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MAXO_0000092">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
    </owl:NamedIndividual>
    


    <!-- http://purl.obolibrary.org/obo/MAXO_0000653 -->


    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/MAXO_0000653">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/MAXO_0000001"/>
        <phmo:isMedicalActionInIntervention rdf:resource="http://purl.org/afmo#HealthIntervention1"/>
