        <rdfs:label>is PR interval variation status of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/afmo#isPWaveVariationStatusOf -->


    <owl:ObjectProperty rdf:about="http://purl.org/afmo#isPWaveVariationStatusOf">
