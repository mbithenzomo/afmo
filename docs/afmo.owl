    <!-- http://purl.org/afmo#hasProlongedPWaveStatus -->


    <owl:ObjectProperty rdf:about="http://purl.org/afmo#hasProlongedPWaveStatus">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/afmo#hasECGFactorStatus"/>
        <owl:inverseOf rdf:resource="http://purl.org/afmo#isProlongedPWaveStatusOf"/>
        <rdfs:domain rdf:resource="http://purl.org/phmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/afmo#ProlongedPWave"/>
        <rdfs:comment>The relationship between a person and their prolonged P-wave status (present or absent).</rdfs:comment>
