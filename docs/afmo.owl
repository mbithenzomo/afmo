                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>AF risk status in a monitored person (present or absent).</rdfs:comment>
        <rdfs:label>Atrial fibrillation risk status</rdfs:label>
    </owl:Class>
    


