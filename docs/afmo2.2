        <rdfs:label>Author</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#BMICategory -->

    <owl:Class rdf:about="http://purl.org/afmo#BMICategory">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/afmo#Normal"/>
                    <rdf:Description rdf:about="http://purl.org/afmo#ObeseI"/>
                    <rdf:Description rdf:about="http://purl.org/afmo#ObeseII"/>
                    <rdf:Description rdf:about="http://purl.org/afmo#ObeseIII"/>
                    <rdf:Description rdf:about="http://purl.org/afmo#Overweight"/>
                    <rdf:Description rdf:about="http://purl.org/afmo#Underweight"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.org/afmo#AnthropometricFactor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isDeterminedBy"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#BodyHeightObservation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isDeterminedBy"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#BodyWeightObservation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>For adults, BMI falls into the following categories:

- Underweight: below 18.5
- Normal: 18.5 - 24.9
- Overweight: 25.0 - 29.9
- Obese I: 30.0 - 34.9
- Obese II: 35.0 - 39.9
- Obese III: above 40.0</rdfs:comment>
        <rdfs:label>BMI category</rdfs:label>
    </owl:Class>
    


