            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isHealthEventOfCondition"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/afmo#AtrialFibrillationEpisodePrediction -->

    <owl:Class rdf:about="http://purl.org/afmo#AtrialFibrillationEpisodePrediction">
        <rdfs:subClassOf rdf:resource="http://purl.org/afmo#HealthEventPrediction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isPredictionOfCondition"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isPredictionOfHealthEvent"/>
                <owl:allValuesFrom rdf:resource="http://purl.org/afmo#AtrialFibrillationEpisode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#wasPredictedByModel"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/afmo#ArtificialNeuralNetwork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A prediction of an upcoming episode in a monitored person.</rdfs:comment>
        <rdfs:label>Atrial fibrillation episode prediction</rdfs:label>
    </owl:Class>
    


