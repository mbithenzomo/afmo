    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/MAXO_0000653">
        <obo:IAO_0000115>Treatment with a class of agents that act by selectively inhibiting angiotensin II receptor activation in the renin-angiotensin-aldosterone system.</obo:IAO_0000115>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-04T17:31:52Z</dc:date>
        <oboInOwl:hasDbXref>CHEBI:61016</oboInOwl:hasDbXref>
