        <rdfs:label>Atrial fibrillation risk status</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#AtrialfibrillationRiskAssessment -->

    <owl:Class rdf:about="http://purl.org/afmo#AtrialfibrillationRiskAssessment">
        <rdfs:subClassOf rdf:resource="http://purl.org/afmo#HealthRiskAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isRiskAssessmentOfCondition"/>
