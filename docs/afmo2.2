    <!-- http://purl.org/afmo#IsCaregiverOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/afmo#IsCaregiverOf">
        <owl:inverseOf rdf:resource="http://purl.org/afmo#isCareRecipientOf"/>
        <rdfs:domain rdf:resource="http://purl.org/afmo#Caregiver"/>
        <rdfs:range rdf:resource="http://purl.org/afmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a caregiver and their care recipient, a monitored person.</rdfs:comment>
        <rdfs:label>is caregiver of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/afmo#computed -->

    <owl:ObjectProperty rdf:about="http://purl.org/afmo#computed">
        <owl:inverseOf rdf:resource="http://purl.org/afmo#wasComputedBy"/>
        <rdfs:domain rdf:resource="http://purl.org/afmo#Model"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/afmo#EventPrediction"/>
                    <rdf:Description rdf:about="http://purl.org/afmo#RiskAssessment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment>The relationship between a model and its computed risk assessment or event prediction.</rdfs:comment>
        <rdfs:label>computed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/afmo#hasAgeGroup -->

    <owl:ObjectProperty rdf:about="http://purl.org/afmo#hasAgeGroup">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/afmo#hasRiskFactorStatus"/>
        <owl:inverseOf rdf:resource="http://purl.org/afmo#isAgeGroupOf"/>
        <rdfs:domain rdf:resource="http://purl.org/afmo#MonitoredPerson"/>
        <rdfs:range rdf:resource="http://purl.org/afmo#AgeGroup"/>
        <oboInOwl:hasDbXref>saref4wear:wearerAgeRange</oboInOwl:hasDbXref>
        <rdfs:comment>The relationship between a monitored person and their age group.</rdfs:comment>
        <rdfs:label>has age group</rdfs:label>
    </owl:ObjectProperty>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointProperties"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/afmo#hasAgeGroup"/>
        </owl:members>
    </rdf:Description>
    


