        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isRiskStatusOfCondition"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
            </owl:Restriction>
