        <owl:annotatedTarget xml:lang="en">Alcohol misuse is when you drink in a way that&apos;s harmful, or when you&apos;re dependent on alcohol.</owl:annotatedTarget>
        <rdfs:isDefinedBy>The National Health Service (NHS). https://www.nhs.uk/conditions/alcohol-misuse/</rdfs:isDefinedBy>
    </owl:Axiom>
    


    <!-- http://purl.org/afmo#AnthropometricFactor -->

    <owl:Class rdf:about="http://purl.org/afmo#AnthropometricFactor">
