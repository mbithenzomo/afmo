    <owl:Class rdf:about="http://purl.org/afmo#BayesianDecisionNetwork">
        <rdfs:subClassOf rdf:resource="http://purl.org/afmo#Model"/>
        <rdfs:label>Bayesian decision network</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#BayesianNetwork -->

