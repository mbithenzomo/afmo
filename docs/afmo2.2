                    <rdf:Description rdf:about="http://purl.org/afmo#AFEpisodePredicted"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.org/afmo#HealthEventPredictionStatus"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isPredictionStatusOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#AtrialFibrillationEpisodePrediction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isPredictionStatusOfCondition"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_0060224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>AF episode prediction status in a monitored person (predicted or not predicted).</rdfs:comment>
        <rdfs:label>Atrial fibrillation episode prediction status</rdfs:label>
    </owl:Class>
    


