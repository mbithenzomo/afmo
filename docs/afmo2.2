    <!-- http://purl.org/afmo#IsCaregiverOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/afmo#IsCaregiverOf">
        <owl:inverseOf rdf:resource="http://purl.org/afmo#isCareRecipientOf"/>
        <rdfs:domain rdf:resource="http://purl.org/afmo#Caregiver"/>
        <rdfs:range rdf:resource="http://purl.org/afmo#MonitoredPerson"/>
        <rdfs:comment>The relationship between a caregiver and their care recipient, a monitored person.</rdfs:comment>
        <rdfs:label>is caregiver of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/afmo#approvedIntervention -->

    <owl:ObjectProperty rdf:about="http://purl.org/afmo#approvedIntervention">
        <owl:inverseOf rdf:resource="http://purl.org/afmo#wasApprovedByClinician"/>
        <rdfs:domain rdf:resource="http://purl.org/afmo#Clinician"/>
        <rdfs:range rdf:resource="http://purl.org/afmo#HealthIntervention"/>
        <rdfs:comment>The relationship between a clinician and a health intervention that they approved for a monitored person.</rdfs:comment>
        <rdfs:label>approved intervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/afmo#calculatedExpectedUtilityForIntervention -->

    <owl:ObjectProperty rdf:about="http://purl.org/afmo#calculatedExpectedUtilityForIntervention">
        <owl:inverseOf rdf:resource="http://purl.org/afmo#expectedUtilityCalculatedByModel"/>
        <rdfs:domain rdf:resource="http://purl.org/afmo#BayesianDecisionNetwork"/>
        <rdfs:range rdf:resource="http://purl.org/afmo#HealthIntervention"/>
        <rdfs:comment>The relationship between a model (specifically a Bayesian decision network) and a health intervention whose expected utility it calculated.</rdfs:comment>
        <rdfs:label>recommended intervention</rdfs:label>
    </owl:ObjectProperty>
    


