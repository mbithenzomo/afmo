            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/afmo#CardiovascularDiseaseAbsent"/>
                    <rdf:Description rdf:about="http://purl.org/afmo#CardiovascularDiseasePresent"/>
