        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment>A clinician of a monitored person.</rdfs:comment>
        <rdfs:label>Clinician</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/afmo#ComorbidityFactor -->

    <owl:Class rdf:about="http://purl.org/afmo#ComorbidityFactor">
