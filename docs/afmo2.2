            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/isFeatureOfInterestOf"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/core/UnitOfMeasure"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4ehaw/HealthDevice"/>
        <owl:disjointWith rdf:resource="https://saref.etsi.org/saref4wear/WearableDevice"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">Feature Of Interest</rdfs:label>
        <skos:definition xml:lang="en">
  entity that is the target of an Execution or Deployment

  i.e., whose property is being estimated by an Observation, 
  or whose property is being manipulated by an Actuator, 
  or which is being sampled or transformed in an act of Sampling, 
  or which is the target of Executions planned as part of a Deployment.
  </skos:definition>
        <skos:example xml:lang="en">When measuring the height of a tree, the height is the observed Property, 20m may be the Result of the Observation, and the tree is the FeatureOfInterest. A window is a FeatureOfInterest for an automatic window control Actuation.</skos:example>
    </owl:Class>
    


