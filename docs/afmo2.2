    </owl:Class>
    


    <!-- http://purl.org/afmo#Author -->

    <owl:Class rdf:about="http://purl.org/afmo#Author">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/afmo#isCreatorOf"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/afmo#Publication"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
